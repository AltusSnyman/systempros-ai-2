---
// Dossier breadcrumb trail — Fragment Mono ref line + BreadcrumbList schema.
// Usage: <Breadcrumbs currentTitle="OpenClaw Use Cases" parent={{ name: 'OpenClaw', url: '/openclaw' }} />
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  currentTitle: string;
  parent?: Crumb;
}

const { currentTitle, parent = { name: 'Systems', url: '/#systems' } } = Astro.props;

const paths = [
  { name: 'Home', url: '/' },
  parent,
  { name: currentTitle, url: Astro.url.pathname },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": paths.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": `https://systempros.ai${item.url.replace('https://systempros.ai', '')}`,
  })),
};
---

<nav aria-label="Breadcrumb" class="max-w-[1200px] mx-auto px-5 pt-7">
  <ol class="face-data text-muted flex flex-wrap items-center gap-x-2.5 gap-y-1">
    <li><a href="/" class="hover:text-green transition-colors">HOME</a></li>
    <li aria-hidden="true" class="text-line">/</li>
    <li><a href={parent.url} class="hover:text-green transition-colors">{parent.name.toUpperCase()}</a></li>
    <li aria-hidden="true" class="text-line">/</li>
    <li class="text-ink" aria-current="page">{currentTitle.toUpperCase()}</li>
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
