---
// The commissioning stamp — the brand's sign-off device. Max one per page.
// variant "drench" renders for use on green-deep surfaces.
const { variant = 'paper', size = 120 } = Astro.props;
const stroke = variant === 'drench' ? 'var(--color-copper)' : 'var(--color-copper)';
const text = variant === 'drench' ? 'var(--color-paper-dim)' : 'var(--color-muted)';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 120 120"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="System Pros AI commissioning stamp — established engineers, 30 years"
  class="stamp select-none"
>
  <circle cx="60" cy="60" r="57" stroke={stroke} stroke-width="1.5" />
  <circle cx="60" cy="60" r="44" stroke={stroke} stroke-width="0.75" />
  <defs>
    <path id="stamp-arc-top" d="M 60 10 A 50 50 0 0 1 110 60" fill="none" />
    <path id="stamp-circle" d="M 60 14 A 46 46 0 1 1 59.9 14" fill="none" />
  </defs>
  <text font-family="Fragment Mono, monospace" font-size="8.5" letter-spacing="2.5" fill={text}>
    <textPath href="#stamp-circle" startOffset="0%">SYSTEM PROS AI · COMMISSIONED · 30 YRS ENTERPRISE ·</textPath>
  </text>
  <g stroke={stroke} stroke-width="1.25" stroke-linecap="square">
    <path d="M 42 60 H 54 L 58 50 L 64 70 L 68 60 H 78" />
  </g>
  <text x="60" y="82" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="7" letter-spacing="1.5" fill={text}>NZ · AU · USA</text>
</svg>

<style>
  .stamp {
    transform: rotate(-8deg);
  }
</style>
