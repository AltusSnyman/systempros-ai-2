---
// Original mock of a Google-style local search results page, built from
// scratch in HTML/CSS (no external screenshots, no real business names).
// docs/andrea-page-copy.md §3.

interface Listing {
	name: string;
	rating: string;
	distance: string;
	stars: number;
}

const listings: Listing[] = [
	{ name: 'Harbourside Plumbing', rating: '4.9', distance: '0.8 km', stars: 5 },
	{ name: 'Shore Pipe & Drain', rating: '4.8', distance: '1.1 km', stars: 5 },
	{ name: 'Northcote Plumbers Ltd', rating: '4.6', distance: '1.6 km', stars: 5 },
];

const directoryResults = [
	'Top 10 plumbers on the North Shore',
	'Plumbers near you — directory',
];

const anatomyLabel =
	"Mock Google search results for 'plumber near me, Takapuna': one sponsored listing at the top, a map pack showing three pins and three businesses — Harbourside Plumbing, Shore Pipe & Drain, and Northcote Plumbers Ltd — each with a star rating, distance and a call button, then two directory-style results underneath.";
---

<div class="grid lg:grid-cols-[1fr_15rem] gap-8 items-start">
	<!-- The mock itself: presented to assistive tech as a single image via role="img" -->
	<div
		class="border border-line bg-paper overflow-hidden"
		role="img"
		aria-label={anatomyLabel}
	>
		<div aria-hidden="true">
			<div class="face-data text-muted text-[11.5px] px-4 py-3 border-b border-line flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
				plumber near me · Takapuna
			</div>

			<!-- Sponsored result -->
			<div class="px-4 py-3 border-b border-line">
				<span class="face-data text-[9.5px] border border-line text-muted px-1.5 py-0.5">Sponsored</span>
				<p class="text-[13.5px] text-ink mt-1.5 font-semibold">northshoreplumbingpro.co.nz</p>
				<p class="text-[12px] text-muted">24/7 emergency plumber — North Shore, Auckland</p>
			</div>

			<!-- Map pack -->
			<div class="px-4 py-4 border-b border-line bg-green-faint">
				<div class="grid sm:grid-cols-[6.5rem_1fr] gap-4">
					<div class="relative h-24 sm:h-full min-h-[6rem] border border-line bg-paper overflow-hidden">
						<svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full" preserveAspectRatio="none">
							<line x1="0" y1="34" x2="100" y2="34" stroke="var(--color-line)" stroke-width="2"/>
							<line x1="0" y1="72" x2="100" y2="72" stroke="var(--color-line)" stroke-width="2"/>
							<line x1="28" y1="0" x2="28" y2="100" stroke="var(--color-line)" stroke-width="2"/>
							<line x1="66" y1="0" x2="66" y2="100" stroke="var(--color-line)" stroke-width="2"/>
							<circle cx="28" cy="34" r="6" fill="var(--color-copper)"/>
							<text x="28" y="37.5" font-size="7" text-anchor="middle" fill="white" font-family="sans-serif">1</text>
							<circle cx="66" cy="34" r="6" fill="var(--color-copper)"/>
							<text x="66" y="37.5" font-size="7" text-anchor="middle" fill="white" font-family="sans-serif">2</text>
							<circle cx="47" cy="72" r="6" fill="var(--color-copper)"/>
							<text x="47" y="75.5" font-size="7" text-anchor="middle" fill="white" font-family="sans-serif">3</text>
						</svg>
					</div>
					<ul class="space-y-2.5">
						{listings.map((l) => (
							<li class="flex items-center justify-between gap-3">
								<div class="min-w-0">
									<p class="text-[13px] font-semibold text-ink truncate">{l.name}</p>
									<div class="flex items-center gap-1 mt-0.5">
										{Array.from({ length: l.stars }).map(() => (
											<svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="var(--color-copper)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
										))}
										<span class="face-data text-[10px] text-muted ml-1 whitespace-nowrap">{l.rating} · {l.distance}</span>
									</div>
								</div>
								<span class="face-data text-[10px] border border-green text-green px-2 py-1 whitespace-nowrap shrink-0">Call</span>
							</li>
						))}
					</ul>
				</div>
			</div>

			<!-- Directory results -->
			{directoryResults.map((d, i) => (
				<div class={`px-4 py-3 ${i === 0 ? 'border-b border-line' : ''}`}>
					<p class="text-[13px] text-green underline underline-offset-2">{d}</p>
					<p class="face-data text-[10.5px] text-muted mt-0.5">directory listing</p>
				</div>
			))}
		</div>
	</div>

	<!-- Callouts: real, readable text — not hidden from assistive tech -->
	<div class="flex flex-row lg:flex-col gap-4 lg:gap-7 flex-wrap">
		<div class="border-l-2 border-line pl-3">
			<p class="face-data text-muted text-[11px]">ADS</p>
			<p class="text-xl font-bold text-ink">~4%</p>
			<p class="text-[12px] text-muted">of clicks</p>
		</div>
		<div class="border-l-2 border-green pl-3">
			<p class="face-data text-green text-[11px]">MAP PACK</p>
			<p class="text-3xl font-extrabold text-green">~80%</p>
			<p class="text-[12px] text-muted">of clicks</p>
		</div>
		<div class="border-l-2 border-line pl-3">
			<p class="face-data text-muted text-[11px]">WEBSITES</p>
			<p class="text-xl font-bold text-ink">~16%</p>
			<p class="text-[12px] text-muted">of clicks</p>
		</div>
	</div>
</div>
<p class="face-data text-muted text-[12px] leading-relaxed mt-5 max-w-[42rem]">Industry benchmark for local searches. Your category and suburb will differ; the direction rarely does.</p>
