---
import Stamp from './Stamp.astro';
import { PHONES, BRAND } from '../lib/site';
const currentYear = new Date().getFullYear();
---

<footer class="drench mt-(--spacing-section)">
  <div class="max-w-[1200px] mx-auto px-5 py-16">

    <!-- Sign-off row -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-10 pb-12 border-b border-line-drench">
      <div class="max-w-sm space-y-4">
        <div class="flex items-baseline gap-1.5">
          <span class="face-display font-extrabold text-2xl text-paper-lit">System Pros</span>
          <span class="w-2 h-2 bg-copper inline-block" aria-hidden="true"></span>
          <span class="face-display font-extrabold text-2xl text-paper-lit">AI</span>
        </div>
        <p class="text-paper-dim text-[15px] leading-relaxed">
          AI systems, engineered and installed. Thirty years of enterprise
          architecture applied to the businesses that keep towns running.
        </p>
        <a href="/contact" class="btn-primary-inverse !px-5 !py-2.5 !text-[14px]">Book a Free Consultation</a>
      </div>
      <Stamp variant="drench" size={130} />
    </div>

    <!-- Directory columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10 py-12 text-[14px]">
      <div>
        <div class="face-data text-paper-dim mb-4">SYSTEMS</div>
        <ul class="space-y-2.5">
          <li><a href="/voice-ai" class="text-paper-lit hover:text-copper transition-colors">AI Receptionist (Revenue Triad)</a></li>
          <li><a href="/voice-ai/australia/" class="text-paper-lit hover:text-copper transition-colors">AI Receptionist Australia</a></li>
          <li><a href="/lead-gen-websites" class="text-paper-lit hover:text-copper transition-colors">Lead Gen Websites</a></li>
          <li><a href="/websites/" class="text-paper-lit hover:text-copper transition-colors">Website Design & Build</a></li>
          <li><a href="/lead-reactor" class="text-paper-lit hover:text-copper transition-colors">The Lead Reactor</a></li>
          <li><a href="/private-assistant" class="text-paper-lit hover:text-copper transition-colors">The Private Assistant</a></li>
          <li><a href="/consulting" class="text-paper-lit hover:text-copper transition-colors">Consultation</a></li>
          <li><a href="/training" class="text-paper-lit hover:text-copper transition-colors">Training</a></li>
          <li><a href="/training/n8n/" class="text-paper-lit hover:text-copper transition-colors">n8n Training</a></li>
          <li><a href="/pricing" class="text-paper-lit hover:text-copper transition-colors">Pricing</a></li>
          <li><a href="/audit/" class="text-paper-lit hover:text-copper transition-colors">Free AI Readiness Audit</a></li>
          <li><a href="/marketing/" class="text-paper-lit hover:text-copper transition-colors">Marketing Services</a></li>
          <li><a href="/marketing/google-business-profile/" class="text-paper-lit hover:text-copper transition-colors">Google Business Profile Management</a></li>
          <li><a href="/marketing/reviews-reputation/" class="text-paper-lit hover:text-copper transition-colors">Review & Reputation Management</a></li>
          <li><a href="/marketing/social-media-management/" class="text-paper-lit hover:text-copper transition-colors">Social Media Management</a></li>
          <li><a href="/marketing/facebook-instagram-ads/" class="text-paper-lit hover:text-copper transition-colors">Facebook & Instagram Ads</a></li>
          <li><a href="/marketing/google-ads/" class="text-paper-lit hover:text-copper transition-colors">Google Ads</a></li>
        </ul>
      </div>
      <div>
        <div class="face-data text-paper-dim mb-4">OPENCLAW</div>
        <ul class="space-y-2.5">
          <li><a href="/openclaw" class="text-paper-lit hover:text-copper transition-colors">What is OpenClaw?</a></li>
          <li><a href="/openclaw/use-cases" class="text-paper-lit hover:text-copper transition-colors">Use Cases</a></li>
          <li><a href="/openclaw/for-business" class="text-paper-lit hover:text-copper transition-colors">For Business</a></li>
          <li><a href="/openclaw/vs-chatgpt" class="text-paper-lit hover:text-copper transition-colors">vs ChatGPT</a></li>
          <li><a href="/openclaw/skills" class="text-paper-lit hover:text-copper transition-colors">Skills Guide</a></li>
          <li><a href="/openclaw/setup-guide" class="text-paper-lit hover:text-copper transition-colors">Setup Guide</a></li>
        </ul>
      </div>
      <div>
        <div class="face-data text-paper-dim mb-4">INDUSTRIES</div>
        <ul class="space-y-2.5">
          <li><a href="/solutions/roofing" class="text-paper-lit hover:text-copper transition-colors">Roofing</a></li>
          <li><a href="/solutions/dental" class="text-paper-lit hover:text-copper transition-colors">Dental</a></li>
          <li><a href="/solutions/chiropractors" class="text-paper-lit hover:text-copper transition-colors">Chiropractic</a></li>
          <li><a href="/solutions/landscaping" class="text-paper-lit hover:text-copper transition-colors">Landscaping</a></li>
          <li><a href="/solutions/auto-detailing" class="text-paper-lit hover:text-copper transition-colors">Auto Detailing</a></li>
          <li><a href="/solutions/counselling" class="text-paper-lit hover:text-copper transition-colors">Counselling</a></li>
          <li><a href="/solutions/coaching" class="text-paper-lit hover:text-copper transition-colors">Coaching</a></li>
          <li><a href="/solutions/independent-living" class="text-paper-lit hover:text-copper transition-colors">Senior Living</a></li>
          <li><a href="/industries" class="link-ink !text-paper-dim">All industries →</a></li>
        </ul>
      </div>
      <div>
        <div class="face-data text-paper-dim mb-4">CONTACT</div>
        <ul class="space-y-2.5 face-data !text-[13px]">
          <li class="flex items-center gap-2"><span class="text-paper-dim w-6">NZ</span> <a href={PHONES.NZ.tel} class="text-paper-lit hover:text-copper transition-colors">{PHONES.NZ.display}</a></li>
          <li class="flex items-center gap-2"><span class="text-paper-dim w-6">AU</span> <a href={PHONES.AU.tel} class="text-paper-lit hover:text-copper transition-colors">{PHONES.AU.display}</a></li>
          <li class="flex items-center gap-2"><span class="text-paper-dim w-6">US</span> <a href={PHONES.US.tel} class="text-paper-lit hover:text-copper transition-colors">{PHONES.US.display}</a></li>
          <li class="flex items-center gap-2"><span class="text-paper-dim w-6" aria-hidden="true">@</span> <a href={`mailto:${BRAND.email}`} class="text-paper-lit hover:text-copper transition-colors break-all">{BRAND.email}</a></li>
        </ul>
        <ul class="space-y-2.5 mt-6 text-[14px]">
          <li><a href="/locations/australia" class="text-paper-lit hover:text-copper transition-colors">Australia</a></li>
          <li><a href="/locations/new-zealand" class="text-paper-lit hover:text-copper transition-colors">New Zealand</a></li>
          <li><a href="/consulting/australia/" class="text-paper-lit hover:text-copper transition-colors">AI Consulting Australia</a></li>
          <li><a href="/consulting/new-zealand/" class="text-paper-lit hover:text-copper transition-colors">AI Consulting NZ</a></li>
          <li><a href="/contact" class="text-paper-lit hover:text-copper transition-colors">Contact</a></li>
          <li><a href="/blog" class="text-paper-lit hover:text-copper transition-colors">Blog</a></li>
        </ul>
      </div>
    </div>

    <!-- Legal line -->
    <div class="pt-8 border-t border-line-drench flex flex-col sm:flex-row justify-between gap-4 face-data !text-[12px] text-paper-dim">
      <span>© {currentYear} SYSTEM PROS AI — ALL SYSTEMS OPERATIONAL <span class="dot-live inline-block ml-1 align-middle"></span></span>
      <span class="flex gap-6">
        <a href="/privacy" class="hover:text-copper transition-colors">PRIVACY</a>
        <a href="/terms" class="hover:text-copper transition-colors">TERMS</a>
      </span>
    </div>
    <p class="mt-4 text-[13px] text-paper-dim">System Pros AI is a brand of {BRAND.legalName}.</p>
  </div>
</footer>
