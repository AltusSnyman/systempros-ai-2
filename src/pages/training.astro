---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';
import ServiceSchema from '../components/seo/ServiceSchema.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "Training", "item": "https://systempros.ai/training/" },
	],
};

const topics = [
	{ title: 'AI fundamentals', desc: 'Prompting, models, context windows, and how to think about AI as a tool. The foundation everything else builds on.' },
	{ title: 'AI agents', desc: 'Building autonomous workflows that execute multi-step tasks. Understand agent loops, tool use, and orchestration.' },
	{ title: 'Claude Code', desc: "Anthropic's AI coding tool. Code generation, debugging, refactoring, and full-project development." },
	{ title: 'GoHighLevel', desc: 'CRM, funnels, automations, and pipeline management. The all-in-one platform for agencies and service businesses.' },
	{ title: 'N8N', desc: 'Self-hosted workflow automation. Connect APIs, build complex logic, and automate anything without vendor lock-in.' },
	{ title: 'Make.com', desc: 'Visual automation for non-developers. Build powerful integrations with drag-and-drop scenarios.' },
	{ title: 'Image & generative AI', desc: 'Midjourney, DALL-E, Gemini image generation. Create professional visuals and marketing assets.' },
	{ title: 'Voice AI agents', desc: 'Build and deploy voice AI receptionists and outbound callers using Vapi, ElevenLabs, and custom integrations.' },
	{ title: 'OpenClaw', desc: 'Set up, configure, and extend your personal AI assistant. Skills, SOUL.md, integrations, and automation.' },
];

const problems = [
	{
		label: 'TRAP A',
		name: 'Generic content, not your use case',
		desc: "Every tutorial teaches a toy example that has nothing to do with your actual business. You're left translating theory to practice — alone.",
	},
	{
		label: 'TRAP B',
		name: 'No real application',
		desc: "Watching someone else build something is not the same as building it yourself. You forget 80% within 48 hours if you didn't apply it live.",
	},
	{
		label: 'TRAP C',
		name: 'Tools change fast',
		desc: "AI tools update weekly. By the time a course ships, half the UI has changed and the techniques are already outdated. We teach what's live now.",
	},
];

const steps = [
	{ no: '1', title: 'Book a session', desc: 'Pick a time that works for you. Tell us what you want to learn and your current skill level. No prep required.' },
	{ no: '2', title: 'Custom curriculum', desc: 'We prepare a hands-on session built entirely around your use case, your tools, and your goals. Zero generic slides.' },
	{ no: '3', title: 'Build together', desc: 'Live 1-on-1 via video call. We build real things together. You leave with working knowledge and a recorded session to keep.' },
];

const audiences = [
	'Founders & CEOs', 'Marketing teams', 'Operations managers', 'Developers',
	'Freelancers', 'Agency owners', 'Sales teams', 'Content creators',
];

const faqs = [
	{ question: 'How are training sessions delivered?', answer: '1-on-1 via video call (Zoom or Google Meet). We share screens, build together in real-time, and record the session for you to review later.' },
	{ question: 'Do I need technical experience?', answer: "No. We tailor each session to your level. Whether you're a complete beginner or an experienced developer, we meet you where you are." },
	{ question: 'Can I book training for my team?', answer: 'Yes. We offer team training sessions and can create custom curricula for your organization. Contact us for team pricing.' },
	{ question: 'How long is each session?', answer: 'Standard sessions are 60-90 minutes. We focus on hands-on application, not lectures. You build real things in every session.' },
];
---

<Layout
	title="1-on-1 AI Training | Claude Code, GoHighLevel, N8N, Voice AI & More | System Pros AI"
	description="Hands-on 1-on-1 training on AI agents, Claude Code, GoHighLevel, N8N, Make.com, Voice AI, and OpenClaw. No theory — pure application from people who build with these tools every day."
>
	<ServiceSchema
		name="AI Training"
		description="1-on-1 hands-on training sessions covering AI fundamentals, AI agents, Claude Code, GoHighLevel, N8N, Make.com, Voice AI, and OpenClaw."
		serviceType="EducationalService"
	/>
	<FAQSchema faqs={faqs} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet SP-06                   -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">SP-06 · 1-ON-1 TRAINING</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> SESSIONS AVAILABLE NOW</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Learn AI from people who <span class="text-green">build with it every day</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Hands-on training sessions covering the tools and platforms driving real
						results right now. No theory — pure application. You build real things
						in every session.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Training Session</a>
						<a href="#curriculum" class="btn-secondary">
							See all 9 subjects
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="SP-06 — TRAINING, HANDS-ON FORMAT">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="training" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>

			<!-- Commissioning figures -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-3">
				<div class="py-6 pr-6 border-r border-line" data-reveal>
					<dt class="face-data text-muted">SUBJECTS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="9">9</span></dd>
					<dd class="text-[13px] text-muted">from fundamentals to OpenClaw</dd>
				</div>
				<div class="py-6 px-6 border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">SESSION LENGTH</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">60–90 min</dd>
					<dd class="text-[13px] text-muted">hands-on, not lectures</dd>
				</div>
				<div class="py-6 pl-6" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">FORMAT</dt>
					<dd class="mt-1 text-2xl font-bold text-copper">1-on-1</dd>
					<dd class="text-[13px] text-muted">every session, recorded for you</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE PROBLEM — tutorial hell                  -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 02" caption="SP-06 — FROM TUTORIALS TO WORKING SYSTEMS">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="training-results" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						Stop drowning in tutorial hell.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						You've watched the YouTube videos. You've bought the courses. But you're
						still not automating anything. The problem isn't effort — it's the
						learning format.
					</p>
					<ul class="mt-8">
						{problems.map((p, i) => (
							<li class="spec-row flex gap-5 py-5 px-2" data-reveal style={`--reveal-delay: ${160 + i * 80}ms;`}>
								<span class="face-data text-copper pt-0.5 shrink-0 w-14">{p.label}</span>
								<div>
									<h3 class="font-bold text-ink">{p.name}</h3>
									<p class="text-[14.5px] text-muted mt-1">{p.desc}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- CURRICULUM — session spec table              -->
	<!-- ============================================ -->
	<section id="curriculum" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						The curriculum.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[38rem]" data-reveal style="--reveal-delay: 80ms;">
						Pick one subject or build a custom curriculum across several. Every
						session is tailored to your goals and current skill level.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>SESSION SPECIFICATION · 9 SUBJECTS</p>
			</div>

			<div class="border border-line overflow-x-auto" data-reveal style="--reveal-delay: 140ms;">
				<table class="w-full text-left min-w-[560px]">
					<thead>
						<tr class="border-b border-line bg-green-faint">
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 w-56">SUBJECT</th>
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 border-l border-line">SESSION CONTENT</th>
						</tr>
					</thead>
					<tbody>
						{topics.map((t) => (
							<tr class="border-t border-line hover:bg-green-faint transition-colors">
								<th scope="row" class="align-top py-4 px-4 font-bold text-ink text-[15px]">{t.title}</th>
								<td class="py-4 px-4 text-[15px] text-muted leading-relaxed border-l border-line">{t.desc}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="face-data text-muted mt-3">FORMAT — 1-ON-1 VIA VIDEO CALL · 60–90 MIN · RECORDED FOR YOUR TEAM</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- HOW IT WORKS — sequential                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-12">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					How it works.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>BOOKING SEQUENCE · 3 STEPS</p>
			</div>

			<ol class="grid md:grid-cols-3 gap-x-10 gap-y-10">
				{steps.map((s, i) => (
					<li class="border-t-2 border-green pt-5 relative" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
						<span class="absolute -top-[19px] left-0 w-9 h-9 bg-green text-paper-lit font-bold flex items-center justify-center" aria-hidden="true">{s.no}</span>
						<p class="face-data text-muted mt-4">STEP {s.no} OF 3</p>
						<h3 class="text-xl font-bold text-ink mt-2">{s.title}</h3>
						<p class="text-[15px] text-muted leading-relaxed mt-2">{s.desc}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- WHO IT'S FOR                                 -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
				<h2 class="face-display font-extrabold text-[clamp(1.8rem,3.4vw,2.6rem)] leading-tight text-ink" data-reveal>
					Who it's for.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>TRAINED ROLES · ALL LEVELS</p>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
			<ul class="flex flex-wrap gap-x-8 gap-y-4 py-6">
				{audiences.map((a) => (
					<li class="face-data !text-[13px] text-ink border-b border-line pb-1 hover:text-green hover:border-green transition-colors">{a}</li>
				))}
			</ul>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAQ                                          -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[880px] mx-auto px-5">
			<div class="text-center mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink" data-reveal>
					Frequently asked questions.
				</h2>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{faqs.map((faq) => (
				<details class="spec-row group px-2 bg-paper">
					<summary class="flex items-center justify-between gap-6 py-5 px-2 cursor-pointer list-none font-bold text-ink [&::-webkit-details-marker]:hidden">
						{faq.question}
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="shrink-0 text-green group-open:rotate-180 transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
					</summary>
					<p class="text-muted leading-relaxed px-2 pb-6 max-w-[44rem]">{faq.answer}</p>
				</details>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — practitioners, not theorists        -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit max-w-[20ch]" data-reveal>
				Stop watching tutorials. Start building.
			</h2>
			<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
				Learn from practitioners, not theorists. These are the same tools we use
				to install every system in this dossier — taught by the engineers who
				install them. Book your first session and walk away with something working.
			</p>
			<div class="mt-10 flex flex-col sm:flex-row gap-4 sm:items-center" data-reveal style="--reveal-delay: 240ms;">
				<a href="/contact" class="btn-primary-inverse">Book a Training Session</a>
				<a href="/pricing" class="face-data text-paper-lit underline underline-offset-4 hover:text-copper transition-colors">VIEW PRICING</a>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>SP-06 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your first session can be this week.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free consultation takes thirty minutes. Tell us what you want to build,
				and we'll design the curriculum around it.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
