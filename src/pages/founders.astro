---
import Layout from '../layouts/Layout.astro';

const auditPoints = [
	'How your website presents your offer and guides visitors to enquire',
	'Where leads enter your forms, booking flow and CRM',
	'How enquiries are followed up across your current tools',
	'Where AI or automation could make the process simpler',
];
---

<Layout
	title="Schedule Your Founders Call Now | System Pros AI"
	description="Book a founders call with System Pros AI to review your website, lead capture, follow-up and AI opportunities."
	hideCTA={true}
	noindex={true}
	nofollow={true}
>
	<section class="relative overflow-hidden" aria-labelledby="founders-heading">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted pt-8 pb-4">SYSTEM PROS AI · FOUNDERS CALL</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-end py-14 lg:py-20">
				<div class="lg:col-span-8">
					<h1 id="founders-heading" class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.5rem)] leading-[1.02] text-ink" data-reveal>
						Schedule Your <span class="text-green">Founders Call</span> Now
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[39rem]" data-reveal style="--reveal-delay: 100ms;">
						Talk through how your business handles enquiries today. We'll look at the systems behind your website, leads and follow-up, then discuss where AI and automation may help.
					</p>
					<a href="#booking" class="btn-primary mt-9" data-reveal style="--reveal-delay: 180ms;">Choose a time</a>
				</div>
				<div class="lg:col-span-4 lg:pb-2" data-reveal style="--reveal-delay: 160ms;">
					<div class="border-l-2 border-copper pl-5 py-1">
						<p class="face-data text-copper uppercase">A practical conversation</p>
						<p class="mt-3 text-[15px] leading-relaxed text-muted">Bring the questions and bottlenecks you want to explore. We'll use them to focus the call on your business.</p>
						<span class="inline-block mt-5 border border-copper px-3 py-1.5 face-data text-copper">Bonuses may apply</span>
					</div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<section class="py-(--spacing-section-sm)" aria-labelledby="audit-heading">
		<div class="max-w-[1200px] mx-auto px-5 grid lg:grid-cols-12 gap-8 lg:gap-14">
			<div class="lg:col-span-4" data-reveal>
				<p class="face-data text-copper mb-4">WHAT THE CALL INCLUDES</p>
				<h2 id="audit-heading" class="face-display font-extrabold text-[clamp(2rem,3.8vw,3.25rem)] leading-tight text-ink">Full Business Audit</h2>
				<p class="mt-4 text-muted leading-relaxed">A clear look at the customer journey and the systems supporting it.</p>
			</div>
			<ul class="lg:col-span-8 border-t border-line" aria-label="Business audit topics">
				{auditPoints.map((point, index) => (
					<li class="grid grid-cols-[2.5rem_1fr] gap-4 items-start py-5 border-b border-line" data-reveal>
						<span class="face-data text-copper pt-0.5" aria-hidden="true">0{index + 1}</span>
						<span class="text-[16px] md:text-lg leading-relaxed text-ink">{point}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section id="booking" class="scroll-mt-20 bg-green-faint border-y border-line py-(--spacing-section-sm)" aria-labelledby="booking-heading">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="max-w-[680px] mb-9" data-reveal>
				<p class="face-data text-copper mb-4">BOOK YOUR CALL</p>
				<h2 id="booking-heading" class="face-display font-extrabold text-[clamp(2rem,3.8vw,3.25rem)] leading-tight text-ink">Choose a time that works for you.</h2>
				<p class="mt-4 text-muted text-lg leading-relaxed">Pick an available slot below, and we'll send you the details for your founders call.</p>
			</div>
			<div id="ghl-calendar-embed" class="w-full min-h-[700px] bg-paper border border-line" aria-label="Booking calendar">
				<iframe src="https://api.leadconnectorhq.com/widget/booking/6sgIBl89eJR2VH4GvRB5" allow="payment" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="6sgIBl89eJR2VH4GvRB5_1791508694176"></iframe><br><script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
			</div>
		</div>
	</section>
</Layout>
