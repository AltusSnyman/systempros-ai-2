---
import Layout from '../../layouts/Layout.astro';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import FAQ from '../../components/seo/FAQ.astro';

const pageTitle = "AI Consultant Australia | System Pros AI";
const pageDescription = "AI consultant and AI consulting services for Australian businesses in Sydney, Melbourne and Brisbane — audit, roadmap, then the build.";

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "Consultation", "item": "https://systempros.ai/consulting/" },
		{ "@type": "ListItem", "position": 3, "name": "AI Consulting Australia", "item": "https://systempros.ai/consulting/australia/" },
	],
};

const faqs = [
	{
		question: "What does an AI consultant actually do?",
		answer: "A good AI consultant maps how your business actually runs — phone coverage, lead response, the tools your team already uses — then designs the system that closes the gaps. We start every Australian engagement with a forensic audit (the Blueprint) and, if you want it built, follow through with design, build and commissioning (the Turnkey Integration)."
	},
	{
		question: "How much do AI consultants charge in Australia?",
		answer: "It depends on the consultant. Some charge by the hour, some resell software at a markup, some price by outcome. We work on a fixed price and fixed scope, agreed after a free consultation. What moves the number is the size of your operation, how many workflows and systems are in scope, and whether you want the Blueprint audit only or the Blueprint plus the Turnkey build."
	},
	{
		question: "How can AI help my Australian business with rising wage costs?",
		answer: "Australia has some of the highest minimum and award wages in the world. AI agents handling repetitive tasks like appointment setting, data entry and level-1 customer support don't accrue penalty rates, superannuation or recruitment fees the way an additional hire does, so you can scale coverage without scaling headcount at the same rate."
	},
	{
		question: "Is your AI compliant with Australian Privacy Laws?",
		answer: "Yes. We work within the Privacy Act 1988 (Cth) and the Australian Privacy Principles (APPs), with data governance frameworks to keep customer data handled securely. For sensitive industries like healthcare or finance, we offer private cloud or on-premise deployments that keep data within Australian borders where required."
	},
	{
		question: "Do you offer services in Perth and regional Australia?",
		answer: "Yes, System Pros AI is a national provider. Our cloud-native infrastructure serves Sydney, Melbourne and Brisbane the same way it serves Perth, Adelaide and regional areas — the same digital workforce, regardless of where your office is."
	},
	{
		question: "What specific software do you integrate with?",
		answer: "We integrate with the standard Australian business stack: Xero and MYOB for finance, Salesforce and HubSpot for CRM, and specialised tools like ServiceM8, Tradify and Cliniko. If it has an API, we can likely build an agent to drive it."
	},
	{
		question: "Will the AI understand a strong Aussie accent?",
		answer: "Yes. Our voice agents are built on models tuned for natural conversation, and during setup we configure local place names, product names and common phrasing so your callers aren't stuck repeating themselves."
	},
	{
		question: "How reliable is the technology for critical business functions?",
		answer: "We build redundancy into every system. For critical functions like emergency dispatch or after-hours triage, we design fail-over protocols that escalate to a human when the AI can't resolve something. Reliability is tested during commissioning against real calls, not promised in the abstract."
	},
	{
		question: "What is the typical ROI timeframe?",
		answer: "It depends on your call volume, average lead value, and how many calls or leads you're currently missing. We measure it against your own numbers, established in the audit — not an industry-wide average. High-volume businesses like trade businesses, clinics and real estate tend to see the clearest payback because a missed call has an obvious dollar cost; lower-volume businesses see it more in staff time freed up."
	},
	{
		question: "Do you provide training for my team?",
		answer: "Yes. Change management is a core part of our consulting. We train your staff on how to work alongside the new systems — monitoring performance, handling escalations, and using the data the AI generates to make better business decisions."
	},
	{
		question: "Can AI handle complex negotiations?",
		answer: "AI is best suited for structured tasks, qualification and information gathering. For complex, high-stakes negotiations, we recommend a human-in-the-loop approach: AI handles the fact-gathering, qualifying and scheduling, so your senior negotiators can focus on closing."
	},
	{
		question: "How do I get started?",
		answer: "It starts with a forensic audit. We look at your call logs, email volumes and workflow bottlenecks to give you a concrete roadmap for automation, scoped to your business rather than a generic template. Book a strategy session to begin."
	}
];

const pressures = [
	{
		label: 'PRESSURE A',
		name: 'Award rate inflation',
		desc: 'With penalty rates for weekends and overtime, a simple 24/7 support line adds significant wage cost for an Australian business. AI delivers the same coverage without penalty rates, superannuation or recruitment fees.',
	},
	{
		label: 'PRESSURE B',
		name: 'Compliance burden',
		desc: "Managing roster compliance, Fair Work regulations, and superannuation adds massive administrative overhead. AI agents don't need breaks, don't accrue leave, and are always compliant.",
	},
	{
		label: 'PRESSURE C',
		name: 'Speed to lead',
		desc: 'In a competitive market like Sydney or Melbourne, if you miss a call, you lose the job. AI ensures zero missed calls and instant response times, capturing revenue your competitors are leaking.',
	},
];

const pillars = [
	{
		ref: 'PILLAR 1',
		name: 'AI voice and reception',
		desc: 'Your 24/7 Aussie receptionist. Handles bookings, FAQs, and triage without the coffee breaks.',
		points: ['Natural Australian accent models', 'Integration with ServiceM8 and Tradify', 'Privacy Act compliant, HIPAA ready'],
		href: '/voice-ai',
		cta: 'Explore Voice AI',
	},
	{
		ref: 'PILLAR 2',
		name: 'Operational automation',
		desc: 'The engine room of your business — automating the flow of data between your fragmented systems.',
		points: ['Xero and MYOB reconciliation', 'Automated compliance reporting', 'Smart CRM management (Salesforce)'],
		href: '/solutions/ai-business-solutions',
		cta: 'See business solutions',
	},
];

const industries = [
	{ name: 'Roofing & trades', href: '/solutions/roofing' },
	{ name: 'Landscaping', href: '/solutions/landscaping' },
	{ name: 'Dental clinics', href: '/solutions/dental' },
	{ name: 'Chiropractic', href: '/solutions/chiropractors' },
	{ name: 'Auto detailing', href: '/solutions/auto-detailing' },
	{ name: 'NDIS & aged care', href: '/solutions/independent-living' },
	{ name: 'Psychology', href: '/solutions/counselling' },
	{ name: 'Coaching', href: '/solutions/coaching' },
];

const reasons = [
	{
		label: 'R-1',
		name: 'Sovereign capability',
		desc: 'We prioritize data sovereignty. We configure our systems to keep sensitive Australian consumer data onshore where possible, ensuring you comply with APPs and industry-specific regulations.',
	},
	{
		label: 'R-2',
		name: 'Fair Work compliant',
		desc: 'Our automated rostering and payload calculations can be configured to respect award rates and break times for your human staff, reducing your liability and admin headache.',
	},
	{
		label: 'R-3',
		name: 'Real support, real people',
		desc: "While we sell AI, we support it with humans. Our support team is available during Australian business hours. You won't be shouting at a chatbot when you need help — ironically.",
	},
	{
		label: 'R-4',
		name: 'Integration specialists',
		desc: "We speak API. Whether it's connecting to your legacy server in the back office or your modern Xero cloud stack, we ensure the data flows seamlessly without double handling.",
	},
];

const hubs = [
	{ city: 'Sydney', focus: 'Financial and professional services' },
	{ city: 'Melbourne', focus: 'Retail, healthcare and logistics' },
	{ city: 'Brisbane', focus: 'Tourism and construction' },
	{ city: 'Perth', focus: 'Mining services and industrial' },
];

const chooseChecklist = [
	'Does it integrate with your existing stack, or does it ask you to replace what already works?',
	'Is the price fixed to a fixed scope, agreed before work starts?',
	'Does it run commissioning tests — real calls, real leads — before calling the job done?',
	'How does it handle your data? Ask specifically about the Privacy Act 1988 (Cth) and the Australian Privacy Principles (APPs), and where your data is stored.',
	"Is there a human escalation path when the AI hits something it can't handle?",
	'Do you get handover documentation, or just access to a dashboard someone else controls?',
];
---

<Layout title={pageTitle} description={pageDescription}>
	<ServiceSchema
		name="AI Consulting Services Australia"
		description={pageDescription}
		areaServed={["Australia", "Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide", "Gold Coast", "Canberra"]}
		serviceType="AI Consulting Service"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — regional desk AU                      -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<a href="/consulting" class="hover:text-green transition-colors">SP-05</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">REGIONAL DESK · AUSTRALIA</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> SERVING AUSTRALIAN INDUSTRY</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Smarter business for <span class="text-green">the lucky country</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Australia's high cost of doing business is killing margins. It's time to
						fight back. System Pros AI deploys autonomous AI agents to slash your overheads
						and scale your operations from Sydney to Perth.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="#solutions" class="btn-secondary">
							See our solutions
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<!-- Cost schematic: wage line vs AI line -->
				<div class="lg:col-span-5" aria-hidden="true">
					<div class="border border-line p-6">
						<p class="face-data text-muted">FIG. 01 — 24/7 PHONE COVERAGE, ANNUAL COST</p>
						<div class="mt-6 space-y-6">
							<div>
								<div class="flex justify-between gap-2 mb-2">
									<span class="face-data text-muted">STAFFED LINE (AWARD + PENALTY RATES)</span>
									<span class="face-data text-ink">HIGHER, FIXED COST</span>
								</div>
								<div class="h-5 bg-line w-full" data-draw-rule></div>
							</div>
							<div>
								<div class="flex justify-between gap-2 mb-2">
									<span class="face-data text-green">SYSTEM PROS AI AGENT</span>
									<span class="face-data text-copper font-bold">USAGE-BASED COST</span>
								</div>
								<div class="h-5 bg-green w-1/4 min-w-[14px]" data-draw-rule style="--reveal-delay: 200ms;"></div>
							</div>
						</div>
						<p class="face-data text-muted mt-6">SAME COVERAGE. NO PENALTY RATES, SUPER, OR RECRUITMENT FEES.</p>
					</div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE PROBLEM — high cost of human capital     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						The high cost of human capital.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[40rem]" data-reveal style="--reveal-delay: 80ms;">
						Australian businesses operate in one of the world's most expensive labor
						markets. Traditional scaling — throwing bodies at the problem — is no
						longer a viable strategy for growth.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>MARKET PRESSURES · AU</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{pressures.map((p, i) => (
				<div class="spec-row grid md:grid-cols-[8.5rem_16rem_1fr] gap-x-8 gap-y-2 py-7 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
					<span class="face-data text-copper">{p.label}</span>
					<h3 class="text-xl font-bold text-ink">{p.name}</h3>
					<p class="text-[15px] text-muted leading-relaxed max-w-[42rem]">{p.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- AI CONSULTING SERVICES IN AUSTRALIA — depth  -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						AI consulting services in Australia.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[44rem]" data-reveal style="--reveal-delay: 80ms;">
						Most Australian businesses that call us aren't short on AI tools. They've
						already tried a chatbot, a Zapier flow, maybe a virtual receptionist trial.
						What they're short on is architecture — someone who looks at the whole
						operation and designs how the pieces should fit before anything gets built.
						That's the job an AI consulting company does, and it's the job we do for
						businesses across Sydney, Melbourne, Brisbane, Perth and regional Australia.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>SP-05 · AU DEPTH</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-2 gap-x-14 gap-y-10 py-10">
				<div data-reveal>
					<h3 class="face-display font-extrabold text-xl text-ink">What the engagement covers</h3>
					<p class="text-muted leading-relaxed mt-3">
						Every engagement starts with the Blueprint: a forensic audit of how your
						business actually runs today. We look at phone coverage — who answers, when,
						and what happens when nobody does — lead response time, the bottlenecks in
						your current workflow, the tools already in your stack, and where your
						compliance exposure sits under Australian privacy law. The output is a
						roadmap: what to build, in what order, and why.
					</p>
					<p class="text-muted leading-relaxed mt-3">
						From there, most clients move to the Turnkey phase: we design the system,
						build it, connect it to your existing tools, commission it against real
						calls and real leads, then hand it over running. You're not left with a
						login and a PDF — you're left with something built, tested and handed over.
					</p>
					<p class="text-muted leading-relaxed mt-3">
						Some clients only want the Blueprint — the audit and the roadmap — and
						build it themselves with an internal IT team. That's a legitimate choice;
						the Blueprint is scoped so it stands alone. Most business owners we work
						with would rather hand the build to someone who does this every week, which
						is where the Turnkey phase comes in.
					</p>
				</div>
				<div data-reveal style="--reveal-delay: 80ms;">
					<h3 class="face-display font-extrabold text-xl text-ink">Who this suits</h3>
					<p class="text-muted leading-relaxed mt-3">
						This is built for operators running 1 to 50 staff — the owner-operator
						who's on-site or on the phone, not behind a desk full-time. If you're
						already generating leads through ads, a website or a Google listing, but
						your phone is the bottleneck and your follow-up is inconsistent, that's
						the gap a consulting engagement is designed to close. It also suits
						businesses juggling several tools that were bought separately over time —
						a booking system here, a CRM there, a spreadsheet holding the rest
						together — where nobody has stepped back to look at how they should connect.
					</p>
					<h3 class="face-display font-extrabold text-xl text-ink mt-8">An AI consultant company vs a tool reseller</h3>
					<p class="text-muted leading-relaxed mt-3">
						Plenty of businesses that call themselves an AI automation consultant are
						really reselling someone else's software with a markup and a login. That's
						distribution, not consulting. An AI consultant company should audit your
						operation before recommending anything, design a system specific to how you
						work rather than a template, integrate with the CRM and calendar you already
						use, and test what it builds before handover rather than after you've found
						the bugs yourself.
					</p>
				</div>
				<div class="lg:col-span-2" data-reveal style="--reveal-delay: 120ms;">
					<h3 class="face-display font-extrabold text-xl text-ink">The automation consultant side</h3>
					<p class="text-muted leading-relaxed mt-3 max-w-[52rem]">
						Underneath the strategy work, most engagements involve automation pipelines
						— connecting your CRM, calendar, phone system and lead sources so information
						moves without someone re-typing it. We build these on
						<a href="/training/n8n/" class="link-ink">n8n and Make.com</a>, with error
						handling, fallback paths and monitoring, so when a step fails a human is
						notified instead of a lead going quiet.
					</p>
				</div>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			<div class="py-10">
				<p class="face-data text-copper mb-5">HOW TO CHOOSE AN AI CONSULTING COMPANY</p>
				<ul class="grid md:grid-cols-2 gap-x-10">
					{chooseChecklist.map((item) => (
						<li class="spec-row flex items-start gap-3.5 py-3.5 px-1 text-[14.5px] text-ink">
							<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</li>
					))}
				</ul>
				<p class="text-muted leading-relaxed mt-6 max-w-[48rem]">
					If a consultant can't answer those questions plainly, that's the answer.
				</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<div class="grid md:grid-cols-3 gap-x-10 gap-y-8 py-10">
				<div data-reveal>
					<h3 class="text-lg font-bold text-ink">Sydney</h3>
					<p class="text-[14.5px] text-muted leading-relaxed mt-2">
						The engagements we see most are financial and professional services firms,
						where lead response time and after-hours coverage matter most. A call that
						goes unanswered on a Friday evening is a lead that's already calling a
						competitor by Monday.
					</p>
				</div>
				<div data-reveal style="--reveal-delay: 80ms;">
					<h3 class="text-lg font-bold text-ink">Melbourne</h3>
					<p class="text-[14.5px] text-muted leading-relaxed mt-2">
						Retail, healthcare and logistics operators lead here, often juggling
						multiple locations and inconsistent phone coverage across them — one site
						answers promptly, another goes to voicemail, and customers notice the gap.
					</p>
				</div>
				<div data-reveal style="--reveal-delay: 160ms;">
					<h3 class="text-lg font-bold text-ink">Brisbane</h3>
					<p class="text-[14.5px] text-muted leading-relaxed mt-2">
						Tourism and construction businesses tend to lead with seasonal demand
						spikes and the compliance overhead that comes with them, which is often
						where phone coverage and workflow bottlenecks show up first in the audit.
					</p>
				</div>
			</div>
			<p class="text-muted leading-relaxed mt-2 max-w-[52rem]">
				The Blueprint audit is the same process in every city — what changes is which
				bottleneck shows up first. <a href="/consulting/" class="link-ink">Read more about how our consulting engagements work</a>,
				pair it with <a href="/voice-ai/australia/" class="link-ink">an AI receptionist for Australian businesses</a> if
				phone coverage is the gap, or check <a href="/pricing/" class="link-ink">how pricing works</a> before you book.
			</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- SOLUTIONS — two pillars + industries         -->
	<!-- ============================================ -->
	<section id="solutions" class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Enterprise-grade AI for Australian industry.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[40rem]" data-reveal style="--reveal-delay: 80ms;">
					We engineer bespoke AI architectures for Australian business. From
					construction to clinical care, we have the specialized agents you need.
				</p>
			</div>

			<div class="grid md:grid-cols-2 gap-x-14">
				{pillars.map((p, i) => (
					<div class="border-t-2 border-green pt-6 pb-8" data-reveal style={`--reveal-delay: ${i * 100}ms;`}>
						<p class="face-data text-copper">{p.ref}</p>
						<h3 class="face-display font-extrabold text-2xl text-ink mt-2">{p.name}</h3>
						<p class="text-muted leading-relaxed mt-3">{p.desc}</p>
						<ul class="mt-5">
							{p.points.map((pt) => (
								<li class="spec-row flex items-center gap-3.5 py-2.5 px-1 text-[14.5px] text-ink">
									<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
									{pt}
								</li>
							))}
						</ul>
						<a href={p.href} class="link-ink inline-flex items-center gap-2 mt-5 text-[15px] font-semibold">
							{p.cta}
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					</div>
				))}
			</div>

			<div class="mt-10">
				<p class="face-data text-muted mb-4">TAILORED FOR AUSSIE INDUSTRIES</p>
				<ul class="flex flex-wrap gap-x-7 gap-y-3">
					{industries.map((ind) => (
						<li>
							<a href={ind.href} class="face-data !text-[13px] text-ink border-b border-line pb-1 hover:text-green hover:border-green transition-colors">{ind.name}</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- WHY AU CHOOSES SYSTEM PROS AI                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Why Australian business leaders choose us.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SELECTION CRITERIA</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<div class="grid md:grid-cols-2 md:gap-x-14">
				{reasons.map((r, i) => (
					<div class="spec-row flex gap-5 py-6 px-2" data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms;`}>
						<span class="face-data text-copper pt-1 shrink-0 w-10">{r.label}</span>
						<div>
							<h3 class="font-bold text-ink">{r.name}</h3>
							<p class="text-[14.5px] text-muted mt-1.5 leading-relaxed">{r.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — major hubs                          -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-paper-lit max-w-[22ch]" data-reveal>
				One national desk. Every major hub.
			</h2>
			<p class="mt-6 text-lg text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 100ms;">
				Cloud-native infrastructure means the same digital workforce serves Sydney's
				CBD and regional Australia alike — no tyranny of distance.
			</p>
			<div class="rule-ticked mt-10" data-draw-rule></div>
			<dl class="grid grid-cols-2 lg:grid-cols-4">
				{hubs.map((h, i) => (
					<div class={`py-6 pr-6 ${i < hubs.length - 1 ? 'lg:border-r border-line-drench' : ''} ${i > 0 ? 'lg:pl-6' : ''}`} data-reveal style={`--reveal-delay: ${i * 80}ms;`}>
						<dt class="text-xl font-bold text-paper-lit">{h.city}</dt>
						<dd class="face-data text-paper-dim mt-2">{h.focus.toUpperCase()}</dd>
					</div>
				))}
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<FAQ
		faqs={faqs}
		heading="Frequently asked questions."
		label="FIELD MANUAL · AU EDITION"
	/>

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>REGIONAL DESK · AUSTRALIA · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Ready to automate your Australian business?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				Don't get left behind. Join the Australian businesses scaling faster
				and cheaper with System Pros AI.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
			<p class="face-data text-muted mt-8" data-reveal style="--reveal-delay: 300ms;">
				OR CALL SYSTEM PROS AI AU — <a href="tel:+61255632110" class="link-ink">+61 2 5563 2110</a>
			</p>
		</div>
	</section>
</Layout>
