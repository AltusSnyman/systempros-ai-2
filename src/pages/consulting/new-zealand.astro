---
import Layout from '../../layouts/Layout.astro';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import FAQ from '../../components/seo/FAQ.astro';

const pageTitle = "AI Agency NZ & AI Consultant Auckland | System Pros AI";
const pageDescription = "AI agency and AI consultant for New Zealand businesses, based in Auckland and serving clients nationwide — audit, roadmap, then the build.";

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "Consultation", "item": "https://systempros.ai/consulting/" },
		{ "@type": "ListItem", "position": 3, "name": "AI Consulting New Zealand", "item": "https://systempros.ai/consulting/new-zealand/" },
	],
};

const faqs = [
	{
		question: "What exactly does an AI Consultant do for my NZ business?",
		answer: "An AI consultant analyzes your current business operations to identify bottlenecks, repetitive tasks, and inefficiencies that can be solved with Artificial Intelligence. At System Pros AI, we don't just advise; we build. We look at your customer support, sales pipelines, and data entry processes, then design and deploy custom AI agents (Voice, Chat, or Process Automation) to handle these tasks. For a New Zealand business, this often means replacing expensive outsourced call centers or freeing up local staff from low-value admin work so they can focus on growth."
	},
	{
		question: "Is AI expensive to implement for a small Kiwi business?",
		answer: "AI is priced differently to labor — usage-based rather than an hourly wage, so the ongoing cost scales with how much it's actually used rather than a fixed shift. There's an upfront investment for strategy and setup; we agree a fixed quote scoped to your business during the free consultation. Our consulting engagements are tiered, so automation is accessible to SMEs in Auckland, Wellington and Christchurch, not just large enterprises."
	},
	{
		question: "Will AI replace my current employees?",
		answer: "AI replaces tasks, not necessarily people. Our goal is to remove the repetitive work from your human staff. Data entry, appointment reminders, invoice chasing, and basic triage should be automated. This allows your team to focus on high-value interactions, complex problem solving, and relationship building — work that actually drives revenue. Businesses that make this shift often find their staff more engaged without the drudgery of repetitive admin."
	},
	{
		question: "How secure is my business data with AI?",
		answer: "Security is our primary directive. We utilize enterprise-grade encryption and strictly adhere to New Zealand Privacy Act 2020 principles. We do not train public models on your private data. All System Pros AI implementations can be ring-fenced, ensuring your customer lists, financial data, and proprietary processes remain strictly confidential. We offer on-premise solutions for highly sensitive industries like healthcare and finance."
	},
	{
		question: "Do you serve businesses outside of Auckland?",
		answer: "Yes. System Pros AI operates fully remotely across New Zealand — we work with businesses across Wellington, Christchurch, Hamilton, Tauranga and Dunedin, not just Auckland. AI infrastructure is cloud-based, so updates apply regardless of your physical headquarters. Our consultation process runs via video conference, with on-site workshops available for larger enterprise integrations."
	},
	{
		question: "What industries do you specialize in?",
		answer: "We have deep expertise in service-based industries where client communication and scheduling are critical. This includes Trades (Plumbing, Roofing, Electrical), Healthcare (Dental, Chiropractic, GPs), Professional Services (Legal, Accounting, Real Estate), and Aged Care. Any business that relies on the phone ringing or appointments being booked is a prime candidate for our automation."
	},
	{
		question: "How long does an AI implementation take?",
		answer: "The process runs in phases: a forensic audit to map your processes, then build and train, then testing and refinement, then go live. Complex integrations with legacy CRM systems take longer than a simple voice agent. We scope the actual timeline during the audit rather than promising a fixed number upfront."
	},
	{
		question: "Does the AI sound robotic?",
		answer: "No — we use conversational voice models built for natural conversation, and during setup we configure local place names, phrasing and common questions so your callers aren't stuck repeating themselves."
	},
	{
		question: "Can the AI integrate with Xero?",
		answer: "Yes, Xero integration is one of our most requested features for NZ businesses. Our AI agents can generate invoices, chase up overdue accounts, reconcile payments, and update client details directly in Xero. We also integrate with Salesforce, HubSpot, Pipedrive, and clinically specific software like Cliniko or Gensolve."
	},
	{
		question: "What is the ROI on AI Consulting?",
		answer: "It depends on your call volume, lead value, and how much you're currently losing to missed calls or slow follow-up. We measure it against your own numbers, established during the audit, rather than a generic industry percentage. If your AI agent captures leads that would otherwise go to voicemail, that's where the return shows up first."
	}
];

const traps = [
	{
		label: 'TRAP A',
		name: 'Wage compression',
		desc: 'With the median wage rising and productivity stagnating, margins are thinner than ever. Paying humans for repetitive data entry or simple phone queries is mathematically unsustainable.',
	},
	{
		label: 'TRAP B',
		name: 'The talent void',
		desc: 'Finding reliable staff in Auckland or Wellington is a battle. Retaining them is harder. AI provides a stable, knowledgeable workforce that never resigns, never gets sick, and never requires visa sponsorship.',
	},
	{
		label: 'TRAP C',
		name: 'Global competition',
		desc: "Your competitors aren't just down the street anymore; they are online and using automation to undercut your prices and outperform your service speed. Adaptation is survival.",
	},
];

const pillars = [
	{
		ref: 'PILLAR 1',
		name: 'AI voice and reception',
		desc: 'The frontline of your business. We replace voicemail and hold times with intelligent agents.',
		points: ['New Zealand accent models', '24/7 appointment scheduling', 'Emergency triage protocols'],
		href: '/voice-ai',
		cta: 'Explore Voice AI',
	},
	{
		ref: 'PILLAR 2',
		name: 'Business logic automation',
		desc: 'The backend brain — connecting your disjointed software stack into a cohesive, self-driving engine.',
		points: ['Automated invoicing (Xero)', 'Dynamic staff rostering', 'Lead qualification and scoring'],
		href: '/solutions/ai-business-solutions',
		cta: 'See business solutions',
	},
];

const industries = [
	{ name: 'Dental clinics', href: '/solutions/dental' },
	{ name: 'Chiropractic', href: '/solutions/chiropractors' },
	{ name: 'Roofing & trades', href: '/solutions/roofing' },
	{ name: 'Landscaping', href: '/solutions/landscaping' },
	{ name: 'Auto detailing', href: '/solutions/auto-detailing' },
	{ name: 'Aged care', href: '/solutions/independent-living' },
	{ name: 'Counselling', href: '/solutions/counselling' },
	{ name: 'Coaching', href: '/solutions/coaching' },
];

const reasons = [
	{
		label: 'R-1',
		name: 'Data sovereignty and privacy',
		desc: 'We understand the NZ Privacy Act 2020. Your data isn\'t just "in the cloud"; it\'s secured with strict access controls and encryption. We respect the taonga that is your business information.',
	},
	{
		label: 'R-2',
		name: 'Local integration support',
		desc: "We don't leave you to figure it out. Our team assists with the integration into Xero, MYOB, and other ANZ-specific software stacks, ensuring smooth financial operations.",
	},
	{
		label: 'R-3',
		name: 'Agile and adaptive',
		desc: 'Kiwi businesses are agile. Our AI solutions are designed to pivot with you. Needs change? Our modular architecture allows you to scale agents up or down instantly.',
	},
	{
		label: 'R-4',
		name: 'ROI-first mentality',
		desc: "If it doesn't make money or save time, we don't build it. We provide transparent ROI calculators and reporting so you see exactly how much your digital workforce is earning you.",
	},
];

const regions = [
	{ city: 'Auckland', focus: 'Corporate HQ and enterprise solutions' },
	{ city: 'Wellington', focus: 'Government and professional services' },
	{ city: 'Christchurch', focus: 'Tech innovation and manufacturing' },
	{ city: 'Hamilton', focus: 'Agri-tech and logistics automation' },
];
---

<Layout title={pageTitle} description={pageDescription}>
	<ServiceSchema
		name="System Pros AI New Zealand | AI Strategic Consulting"
		description={pageDescription}
		areaServed={["New Zealand", "Auckland", "Wellington", "Christchurch", "Hamilton", "Tauranga", "Dunedin"]}
		serviceType="AI Consulting Service"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — regional desk NZ                      -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<a href="/consulting" class="hover:text-green transition-colors">SP-05</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">REGIONAL DESK · NEW ZEALAND</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> SERVING AOTEAROA BUSINESS</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Future-proof your <span class="text-green">Kiwi business</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						The "number 8 wire" mentality isn't enough anymore. While New Zealand
						sleeps, the global market is automating. System Pros AI brings enterprise-grade
						AI infrastructure to Auckland, Wellington, and Christchurch.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="#solutions" class="btn-secondary">
							Explore solutions
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<!-- Cost schematic: minimum wage vs agent -->
				<div class="lg:col-span-5" aria-hidden="true">
					<div class="border border-line p-6">
						<p class="face-data text-muted">FIG. 01 — COST PER HOUR OF CONVERSATION</p>
						<div class="mt-6 space-y-6">
							<div>
								<div class="flex justify-between gap-2 mb-2">
									<span class="face-data text-muted">HOURLY WAGE</span>
									<span class="face-data text-ink">FIXED, PER SHIFT</span>
								</div>
								<div class="h-5 bg-line w-full" data-draw-rule></div>
							</div>
							<div>
								<div class="flex justify-between gap-2 mb-2">
									<span class="face-data text-green">SYSTEM PROS AI VOICE AI AGENT</span>
									<span class="face-data text-copper font-bold">USAGE-BASED</span>
								</div>
								<div class="h-5 bg-green w-1/4 min-w-[14px]" data-draw-rule style="--reveal-delay: 200ms;"></div>
							</div>
						</div>
						<p class="face-data text-muted mt-6">SAME CONVERSATION, PRICED DIFFERENTLY — NOT BY THE HOUR.</p>
					</div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE PROBLEM — productivity trap              -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						The productivity trap.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[40rem]" data-reveal style="--reveal-delay: 80ms;">
						New Zealand businesses face unique challenges: high wage costs, geographic
						isolation, and a talent shortage. Sticking to traditional hiring models
						is becoming a liability.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>MARKET PRESSURES · NZ</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{traps.map((t, i) => (
				<div class="spec-row grid md:grid-cols-[8.5rem_16rem_1fr] gap-x-8 gap-y-2 py-7 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
					<span class="face-data text-copper">{t.label}</span>
					<h3 class="text-xl font-bold text-ink">{t.name}</h3>
					<p class="text-[15px] text-muted leading-relaxed max-w-[42rem]">{t.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- SOLUTIONS — two pillars + industries         -->
	<!-- ============================================ -->
	<section id="solutions" class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Comprehensive AI ecosystems.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[40rem]" data-reveal style="--reveal-delay: 80ms;">
					We don't sell software; we sell outcomes. Our consulting engagements deploy
					one or more of these core pillars into your business architecture.
				</p>
			</div>

			<div class="grid md:grid-cols-2 gap-x-14">
				{pillars.map((p, i) => (
					<div class="border-t-2 border-green pt-6 pb-8" data-reveal style={`--reveal-delay: ${i * 100}ms;`}>
						<p class="face-data text-copper">{p.ref}</p>
						<h3 class="face-display font-extrabold text-2xl text-ink mt-2">{p.name}</h3>
						<p class="text-muted leading-relaxed mt-3">{p.desc}</p>
						<ul class="mt-5">
							{p.points.map((pt) => (
								<li class="spec-row flex items-center gap-3.5 py-2.5 px-1 text-[14.5px] text-ink">
									<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
									{pt}
								</li>
							))}
						</ul>
						<a href={p.href} class="link-ink inline-flex items-center gap-2 mt-5 text-[15px] font-semibold">
							{p.cta}
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					</div>
				))}
			</div>

			<div class="mt-10">
				<p class="face-data text-muted mb-4">TAILORED INDUSTRIES</p>
				<ul class="flex flex-wrap gap-x-7 gap-y-3">
					{industries.map((ind) => (
						<li>
							<a href={ind.href} class="face-data !text-[13px] text-ink border-b border-line pb-1 hover:text-green hover:border-green transition-colors">{ind.name}</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- WHY NZ CHOOSES SYSTEM PROS AI                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Why leading Kiwi firms choose System Pros AI.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SELECTION CRITERIA</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<div class="grid md:grid-cols-2 md:gap-x-14">
				{reasons.map((r, i) => (
					<div class="spec-row flex gap-5 py-6 px-2" data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms;`}>
						<span class="face-data text-copper pt-1 shrink-0 w-10">{r.label}</span>
						<div>
							<h3 class="font-bold text-ink">{r.name}</h3>
							<p class="text-[14.5px] text-muted mt-1.5 leading-relaxed">{r.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — regions served                      -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-paper-lit max-w-[22ch]" data-reveal>
				Serving regions across New Zealand.
			</h2>
			<p class="mt-6 text-lg text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 100ms;">
				Fully remote, cloud-based deployment — with active implementations from
				Auckland to Dunedin and on-site workshops for larger enterprise integrations.
			</p>
			<div class="rule-ticked mt-10" data-draw-rule></div>
			<dl class="grid grid-cols-2 lg:grid-cols-4">
				{regions.map((r, i) => (
					<div class={`py-6 pr-6 ${i < regions.length - 1 ? 'lg:border-r border-line-drench' : ''} ${i > 0 ? 'lg:pl-6' : ''}`} data-reveal style={`--reveal-delay: ${i * 80}ms;`}>
						<dt class="text-xl font-bold text-paper-lit">{r.city}</dt>
						<dd class="face-data text-paper-dim mt-2">{r.focus.toUpperCase()}</dd>
					</div>
				))}
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<FAQ
		faqs={faqs}
		heading="Frequently asked questions."
		label="FIELD MANUAL · NZ EDITION"
	/>

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>REGIONAL DESK · NEW ZEALAND · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Ready to modernize your operations?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				Join the forward-thinking Kiwi businesses already using System Pros AI
				to outperform the market.
			</p>
			<p class="text-muted text-[15px] mt-4 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 200ms;">
				Operating out of Australia too? See
				<a href="/consulting/australia/" class="link-ink">AI consulting for Australian business</a>, or
				explore <a href="/voice-ai/" class="link-ink">our AI receptionist</a> if phone coverage is the
				immediate gap.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
			<p class="face-data text-muted mt-8" data-reveal style="--reveal-delay: 300ms;">
				OR CALL SYSTEM PROS AI NZ — <a href="tel:+64212550493" class="link-ink">021 255 0493</a>
			</p>
		</div>
	</section>
</Layout>
