---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';
import ServiceSchema from '../components/seo/ServiceSchema.astro';

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "The Revenue Triad", "item": "https://systempros.ai/voice-ai" },
	],
};

const agents = [
	{
		ref: 'AGENT 01',
		name: 'The 24/7 Gatekeeper',
		sub: 'Zero latency. Infinite capacity. Perfect brand adherence.',
		body: 'Your front desk has a limit: they sleep, they take breaks, and they can only handle one call at a time. Agent 01 is the ultimate defensive line for your revenue. It lives on your phone lines, handling 10,000+ concurrent calls without a single busy signal. It answers FAQs, qualifies prospects based on your specific playbook, and books appointments directly into your calendar software — all while sounding indistinguishably human.',
		specs: [
			{ label: 'STATION', value: 'Inbound phone lines, 24/7' },
			{ label: 'CAPACITY', value: '10,000+ concurrent calls, zero busy signals' },
			{ label: 'DUTIES', value: 'FAQs, qualification, direct calendar booking' },
		],
	},
	{
		ref: 'AGENT 02',
		name: 'The Speed-to-Lead Engine',
		sub: 'Form-to-call automation in under 10 seconds.',
		body: "The 'death zone' for a web lead is 5 minutes. If you don't call them by then, you've lost them. Agent 02 eliminates human delay. The millisecond a prospect fills out a Facebook lead form or website enquiry, Agent 02 triggers an outbound call instantly. It gets them on the phone while their interest is at its peak, qualifies their intent, and transfers the hot call to your sales team only when they are ready to buy.",
		specs: [
			{ label: 'TRIGGER', value: 'Facebook lead form or website enquiry' },
			{ label: 'RESPONSE', value: 'Outbound call in under 10 seconds' },
			{ label: 'HANDOFF', value: 'Warm transfer to sales when ready to buy' },
		],
	},
	{
		ref: 'AGENT 03',
		name: 'The Lazarus Engine',
		sub: "Turn dead data into new revenue on autopilot.",
		body: 'You are sitting on a goldmine: your list of past clients and old leads (6 months+). Agent 03 is your automated miner. It systematically calls your dormant database with a reactivation offer. It navigates gatekeepers, leaves voicemails, and has full conversations to wake up old opportunities. It fills your pipeline with zero new ad spend, turning a static spreadsheet into a dynamic revenue stream.',
		specs: [
			{ label: 'SOURCE', value: 'Dormant database, aged 6 months+' },
			{ label: 'METHOD', value: 'Calls, voicemails, full reactivation conversations' },
			{ label: 'AD SPEND', value: 'Zero — pipeline from data you already own' },
		],
	},
];

const infrastructure = [
	{ label: 'NETWORK', value: 'Low-latency global voice network — seamless whether your agents answer in New York, chase leads in London, or reactivate databases in Sydney.' },
	{ label: 'SOVEREIGNTY', value: 'Strict data-sovereignty adherence, with dedicated environments for high-volume clients instead of public, shared infrastructure.' },
	{ label: 'FAILOVER', value: 'Robust failover protocols engineered to enterprise standards — the phone line never goes dark.' },
	{ label: 'COMPLIANCE', value: 'Built compliant with regional regulations: GDPR, CCPA, HIPAA ready.' },
];
---

<Layout
	title="The Revenue Triad Architecture | Voice AI Agents | SystemPros.ai"
	description="Stop hiring receptionists. Deploy the 3-agent voice AI architecture: The Gatekeeper (24/7 receptionist), The Hunter (speed-to-lead), and The Miner (database reactivation). Complete revenue automation."
>
	<ServiceSchema
		name="The Revenue Triad"
		description="3-Agent Voice AI Architecture: The Gatekeeper (24/7 receptionist), The Hunter (speed-to-lead), and The Miner (database reactivation). Complete revenue automation."
		serviceType="VoiceAI"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet SP-01                   -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">SP-01 · VOICE AI AGENTS</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> THREE AGENTS ON DUTY</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-14 lg:py-20">
				<div class="lg:col-span-6">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Stop hiring receptionists. Install a <span class="text-green">revenue ecosystem</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
						The Revenue Triad is a 3-agent voice AI architecture. It doesn't just answer
						your phones — it chases web leads the moment they arrive and resurrects
						dormant clients automatically. One platform, engineered end to end.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="#agents" class="btn-secondary">
							View the architecture
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<!-- Call-flow schematic: the page's signature drawing -->
				<div class="lg:col-span-6" aria-hidden="true">
					<svg viewBox="0 0 480 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
						<!-- connectors: inputs → agents -->
						<g stroke="var(--color-green)" stroke-width="1.5">
							<path d="M 118 60 H 180" data-draw-path />
							<path d="M 118 200 H 180" data-draw-path style="--reveal-delay: 150ms;" />
							<path d="M 118 340 H 180" data-draw-path style="--reveal-delay: 300ms;" />
							<!-- agents → booked -->
							<path d="M 308 60 H 344 V 190 H 366" data-draw-path style="--reveal-delay: 450ms;" />
							<path d="M 308 200 H 366" data-draw-path style="--reveal-delay: 550ms;" />
							<path d="M 308 340 H 344 V 210 H 366" data-draw-path style="--reveal-delay: 650ms;" />
						</g>
						<!-- inputs -->
						<g data-reveal>
							<rect x="14" y="40" width="104" height="40" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="66" y="64" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-ink)">INBOUND CALL</text>
						</g>
						<g data-reveal style="--reveal-delay: 120ms;">
							<rect x="14" y="180" width="104" height="40" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="66" y="204" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-ink)">WEB LEAD</text>
						</g>
						<g data-reveal style="--reveal-delay: 240ms;">
							<rect x="14" y="320" width="104" height="40" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="66" y="344" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-ink)">DORMANT LIST</text>
						</g>
						<!-- agents -->
						<g data-reveal style="--reveal-delay: 300ms;">
							<rect x="180" y="34" width="128" height="52" fill="var(--color-green)" />
							<text x="244" y="56" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-paper-lit)">AGENT 01</text>
							<text x="244" y="74" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">GATEKEEPER</text>
						</g>
						<g data-reveal style="--reveal-delay: 400ms;">
							<rect x="180" y="174" width="128" height="52" fill="var(--color-green)" />
							<text x="244" y="196" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-paper-lit)">AGENT 02</text>
							<text x="244" y="214" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">HUNTER</text>
						</g>
						<g data-reveal style="--reveal-delay: 500ms;">
							<rect x="180" y="314" width="128" height="52" fill="var(--color-green)" />
							<text x="244" y="336" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-paper-lit)">AGENT 03</text>
							<text x="244" y="354" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">MINER</text>
						</g>
						<!-- output -->
						<g data-reveal style="--reveal-delay: 700ms;">
							<rect x="366" y="176" width="100" height="48" stroke="var(--color-copper)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="416" y="204" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-copper)">BOOKED</text>
						</g>
						<!-- dimension caption -->
						<g stroke="var(--color-line)" stroke-width="1" data-reveal style="--reveal-delay: 800ms;">
							<path d="M 14 396 H 466" />
							<path d="M 14 391 V 401" />
							<path d="M 466 391 V 401" />
						</g>
						<text x="240" y="414" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)" data-reveal style="--reveal-delay: 800ms;">THREE AGENTS · ONE CALENDAR · ZERO LEAKS</text>
					</svg>
				</div>
			</div>

			<!-- Commissioning figures -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-4">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">COVERAGE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">24/7</dd>
					<dd class="text-[13px] text-muted">no breaks, no sick days</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">SPEED TO LEAD</dt>
					<dd class="mt-1 text-2xl font-bold text-copper">&lt;10 sec</dd>
					<dd class="text-[13px] text-muted">form fill to outbound call</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">CAPACITY</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="10000" data-count-suffix="+">10000+</span></dd>
					<dd class="text-[13px] text-muted">concurrent calls, zero busy signals</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">REACTIVATION</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">$0</dd>
					<dd class="text-[13px] text-muted">new ad spend required</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE SYSTEM IN MOTION — dossier figure        -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 01" caption="SP-01 — REVENUE TRIAD, CONTINUOUS OPERATION">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="revenue-triad" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						The triad, shown running.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						How three AI agents work together to capture, respond, and reactivate
						every lead — 24 hours a day, without a human in the loop until a
						human is actually needed.
					</p>
					<ul class="mt-8">
						{agents.map((a, i) => (
							<li class="spec-row flex gap-5 py-5 px-2" data-reveal style={`--reveal-delay: ${160 + i * 80}ms;`}>
								<span class="face-data text-copper pt-0.5 shrink-0 w-20">{a.ref}</span>
								<div>
									<h3 class="font-bold text-ink">{a.name}</h3>
									<p class="text-[14.5px] text-muted mt-1">{a.sub}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE THREE AGENTS — unit spec sheets          -->
	<!-- ============================================ -->
	<section id="agents" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Three agents.<br />Three failure points closed.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>UNIT SPECIFICATIONS · AGENTS 01–03</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{agents.map((a, i) => (
				<article class="spec-row grid lg:grid-cols-12 gap-x-10 gap-y-6 py-12 px-2">
					<div class="lg:col-span-6">
						<p class="face-data text-copper" data-reveal>{a.ref} · {a.name.toUpperCase()}</p>
						<h3 class="face-display font-extrabold text-2xl md:text-3xl text-ink mt-3" data-reveal style="--reveal-delay: 60ms;">{a.name}</h3>
						<p class="mt-2 font-semibold text-green" data-reveal style="--reveal-delay: 100ms;">{a.sub}</p>
						<p class="text-muted leading-relaxed mt-4 max-w-[38rem]" data-reveal style="--reveal-delay: 140ms;">{a.body}</p>
					</div>
					<div class="lg:col-span-6 lg:pt-10">
						<table class="w-full border border-line text-left" data-reveal style="--reveal-delay: 200ms;">
							<caption class="sr-only">{a.name} specification</caption>
							<tbody>
								{a.specs.map((s, j) => (
									<tr class={j > 0 ? 'border-t border-line' : ''}>
										<th scope="row" class="face-data text-muted font-normal align-top py-3.5 px-4 w-32 border-r border-line bg-green-faint">{s.label}</th>
										<td class="py-3.5 px-4 text-[15px] text-ink">{s.value}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — the compound effect                 -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit max-w-[20ch]" data-reveal>
				Single-agent solutions leak. The triad compounds.
			</h2>
			<div class="rule-ticked mt-10" data-draw-rule></div>
			<div class="grid md:grid-cols-2">
				<div class="py-8 md:pr-10 md:border-r border-line-drench" data-reveal style="--reveal-delay: 120ms;">
					<p class="face-data text-paper-dim">WITHOUT THE TRIAD — THE LEAKY BUCKET</p>
					<ul class="mt-5 space-y-3 text-paper-dim leading-relaxed">
						<li class="flex gap-3"><span class="face-data text-paper-dim shrink-0 pt-0.5">✗</span> You pay for ads, then miss the inbound call.</li>
						<li class="flex gap-3"><span class="face-data text-paper-dim shrink-0 pt-0.5">✗</span> You call the web lead back hours too late.</li>
						<li class="flex gap-3"><span class="face-data text-paper-dim shrink-0 pt-0.5">✗</span> You never follow up with the ones that ghosted.</li>
					</ul>
					<p class="face-data text-paper-dim mt-6">RESULT: LINEAR, PAINFUL GROWTH</p>
				</div>
				<div class="py-8 md:pl-10" data-reveal style="--reveal-delay: 240ms;">
					<p class="face-data text-paper-lit">WITH THE TRIAD — THE FORTRESS</p>
					<ul class="mt-5 space-y-3 text-paper-lit leading-relaxed">
						<li class="flex gap-3"><span class="face-data text-copper shrink-0 pt-0.5">✓</span> Ads launch. Agent 02 calls within ten seconds.</li>
						<li class="flex gap-3"><span class="face-data text-copper shrink-0 pt-0.5">✓</span> If they miss it, Agent 01 catches the callback.</li>
						<li class="flex gap-3"><span class="face-data text-copper shrink-0 pt-0.5">✓</span> If they ghost, Agent 03 reactivates them in six months.</li>
					</ul>
					<p class="face-data text-copper mt-6">RESULT: ZERO LEAD WASTE</p>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
			<a href="/contact" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 300ms;">Book a Free Consultation</a>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- GLOBAL INFRASTRUCTURE & COMPLIANCE           -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-x-12 gap-y-10">
				<div class="lg:col-span-5">
					<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink" data-reveal>
						Engineered for global scale. Built for enterprise compliance.
					</h2>
					<p class="mt-5 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						Deploying voice AI agents at enterprise level requires more than a fast API.
						It demands a low-latency global network, strict data-sovereignty adherence,
						and robust failover protocols. Unlike agencies that rent public, shared
						infrastructure, we architect dedicated environments for high-volume clients.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{infrastructure.map((row, i) => (
						<div class="spec-row grid md:grid-cols-[9rem_1fr] gap-x-6 gap-y-1 py-5 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
							<span class="face-data text-copper pt-0.5">{row.label}</span>
							<p class="text-[15px] text-ink leading-relaxed">{row.value}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>SP-01 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Which architecture does your business need?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free consultation takes thirty minutes. We'll map your call and lead flow,
				then specify whether you need the full triad — or just Agent 01 to start.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
			<p class="text-[14px] text-muted mt-6" data-reveal style="--reveal-delay: 300ms;">
				Starting small? <a href="/pricing" class="link-ink">Agent 01 pricing is on the pricing page</a>.
			</p>
		</div>
	</section>
</Layout>
