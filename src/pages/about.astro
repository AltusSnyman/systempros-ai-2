---
import Layout from '../layouts/Layout.astro';
import Stamp from '../components/Stamp.astro';

// The career register — a genuine chronology, so dated entries are earned.
const register = [
	{
		period: '1990s',
		title: 'Enterprise infrastructure',
		copy: 'Our core team commissions critical IT infrastructure for enterprise-scale organizations — systems that are not allowed to fail.',
	},
	{
		period: '2000s',
		title: 'The rise of the internet',
		copy: 'We watch the web move from novelty to backbone, and build the networks and platforms that carry businesses onto it.',
	},
	{
		period: '2010s',
		title: 'Cloud migration and the SaaS revolution',
		copy: 'We migrate enterprise workloads to the cloud and integrate the SaaS stack — the same discipline, new terrain.',
	},
	{
		period: '2020s',
		title: 'The AI wave — and a problem',
		copy: 'Businesses start plugging powerful AI models into their systems like exposed wires. Messy, insecure, unreliable.',
	},
	{
		period: 'Today',
		title: 'System Pros AI is formed to fix that',
		copy: 'We don’t just “turn on” AI. We integrate it with the rigor, security and stability of an enterprise IT rollout.',
	},
];

const teamStats = [
	{ label: 'COMBINED IT EXPERIENCE', value: '30+ years', sub: 'average per architect' },
	{ label: 'ENTERPRISE PROTOCOLS', value: 'Certified', sub: 'security and infrastructure' },
	{ label: 'TOLERANCE FOR LEAKS', value: 'Zero', sub: 'bank-grade privacy' },
];

const values = [
	{
		ref: 'A',
		title: 'Stability over hype',
		copy: 'We don’t experiment with your business. We use proven, stable AI models in production environments. If it isn’t bulletproof, we don’t ship it.',
	},
	{
		ref: 'B',
		title: 'Data sovereignty',
		copy: 'Your data belongs to you. We architect systems where you hold the keys and control the API access. We build the pipes; you own the water.',
	},
	{
		ref: 'C',
		title: 'Results over activity',
		copy: 'We don’t care about “chat volume” or vanity metrics. We care about revenue deposited in your bank. Every line of code we write is tied to ROI.',
	},
];
---

<Layout
	title="The Digital Architect Team | About System Pros AI"
	description="Meet the 30-year IT veterans behind System Pros AI. We prioritize stability, data sovereignty, and security over hype. The engineering core for your AI workforce."
>
	<!-- ============================================ -->
	<!-- 1. HERO — the philosophy                     -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>PERSONNEL &amp; PROVENANCE FILE</span>
				<span class="hidden md:inline">SYSTEM PROS AI — ABOUT</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="py-16 lg:py-24 max-w-[52rem]">
				<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.03] text-ink" data-reveal>
					AI is powerful. Without <span class="text-green">architecture</span>, it&rsquo;s dangerous.
				</h1>
				<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[38rem]" data-reveal style="--reveal-delay: 120ms;">
					We are not growth hackers chasing the latest trend. We are a collective of
					<strong class="text-ink font-semibold">30-year IT veterans</strong> bringing
					enterprise discipline to the AI wild west.
				</p>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. THE CAREER REGISTER — a true chronology   -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-4">
					<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink lg:sticky lg:top-28" data-reveal>
						Thirty years, one discipline.
					</h2>
					<p class="text-muted text-lg mt-4 leading-relaxed lg:max-w-[20rem]" data-reveal style="--reveal-delay: 100ms;">
						The convergence: three decades of enterprise infrastructure, now applied
						to the AI systems local businesses run on.
					</p>
				</div>

				<div class="lg:col-span-8">
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{register.map((r, i) => (
						<div class="spec-row grid grid-cols-[5.5rem_1fr] md:grid-cols-[7rem_1fr] gap-x-6 gap-y-1 py-7 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
							<span class="face-data text-copper pt-1">{r.period}</span>
							<div>
								<h3 class="text-xl md:text-2xl font-bold text-ink">{r.title}</h3>
								<p class="text-[15px] text-muted mt-1.5 max-w-[36rem]">{r.copy}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. THE ENGINEERING CORE — drench statement   -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-8">
					<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit" data-reveal>
						The engineering core.
					</h2>
					<p class="mt-6 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						System Pros AI is not a revolving door of interns. We are a closed-loop team
						of senior systems architects — the same people who scope your install
						build it, secure it and sign it off.
					</p>

					<dl class="grid sm:grid-cols-3 mt-12 border-t border-line-drench">
						{teamStats.map((s, i) => (
							<div class={`py-6 ${i < 2 ? 'sm:border-r border-line-drench sm:pr-6' : ''} ${i > 0 ? 'sm:pl-6' : ''}`} data-reveal style={`--reveal-delay: ${180 + i * 80}ms;`}>
								<dt class="face-data text-paper-dim">{s.label}</dt>
								<dd class="mt-1 text-2xl font-bold text-paper-lit">{s.value}</dd>
								<dd class="text-[13px] text-paper-dim">{s.sub}</dd>
							</div>
						))}
					</dl>

					<blockquote class="mt-10 border-t border-line-drench pt-8 max-w-[36rem]" data-reveal style="--reveal-delay: 420ms;">
						<p class="text-xl md:text-2xl text-paper-lit leading-relaxed">
							&ldquo;We treat your business data with the same respect as a bank vault.
							Security first. Speed second.&rdquo;
						</p>
						<footer class="face-data text-paper-dim mt-4">— THE SYSTEM PROS AI TEAM</footer>
					</blockquote>
				</div>
				<div class="lg:col-span-4 hidden lg:flex justify-center" data-reveal style="--reveal-delay: 300ms;">
					<Stamp variant="drench" size={190} />
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. THE SYSTEM PROS AI CODE — values as spec rows -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					The System Pros AI code.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>OPERATING PRINCIPLES · NON-NEGOTIABLE</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{values.map((v, i) => (
				<div class="spec-row grid grid-cols-[3rem_1fr] md:grid-cols-[4.5rem_18rem_1fr] gap-x-6 gap-y-2 py-8 px-2 items-baseline" data-reveal style={`--reveal-delay: ${i * 80}ms;`}>
					<span class="face-data text-copper">{v.ref}</span>
					<h3 class="text-xl md:text-2xl font-bold text-ink">{v.title}</h3>
					<p class="col-start-2 md:col-start-3 text-[15px] text-muted leading-relaxed max-w-[42rem]">{v.copy}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<div class="rule-ticked mb-16" data-draw-rule></div>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink max-w-[24ch] mx-auto" data-reveal>
				You know our philosophy. Let&rsquo;s discuss your architecture.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 120ms;">
				A free consultation takes thirty minutes — a working audit of where your
				leads leak, drawn up by the people who will fix it.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 220ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
