---
import Layout from '../layouts/Layout.astro';

// Contact channels — a spec table, not cards. Numbers verbatim.
const channels = [
	{ label: 'US', value: '+1 844 697 9038', href: 'tel:+18446979038', note: 'United States' },
	{ label: 'AU', value: '+61 2 5563 2110', href: 'tel:+61255632110', note: 'Australia' },
	{ label: 'NZ', value: '+64 2 125 50493', href: 'tel:+64212550493', note: 'New Zealand' },
	{ label: 'EMAIL', value: 'hello@systempros.ai', href: 'mailto:hello@systempros.ai', note: 'Sales queries & partnerships' },
];

const steps = [
	{ n: '1', title: 'Pick a time', copy: 'Choose a slot in the calendar. Thirty minutes, no obligation.' },
	{ n: '2', title: 'The discovery call', copy: 'A senior architect maps your operations and finds where leads leak.' },
	{ n: '3', title: 'The specification', copy: 'You receive a written recommendation: the system, the timeline, the number.' },
];
---

<Layout
	title="Schedule Your AI Architecture Audit | SystemPros.ai"
	description="Ready to automate safely? Book a technical discovery call with our Senior Architects. No sales fluff, just engineering strategy."
	hideCTA={true}
>
	<!-- ============================================ -->
	<!-- 1. HEADER — intake sheet                     -->
	<!-- ============================================ -->
	<section class="relative">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>CONSULTATION INTAKE</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> ACCEPTING COMMISSIONS</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-x-14 gap-y-12 py-12 lg:py-16">
				<!-- Left column: copy + channels + procedure -->
				<div class="lg:col-span-5">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,4.6vw,3.8rem)] leading-[1.05] text-ink" data-reveal>
						Book your <span class="text-green">discovery call</span>.
					</h1>
					<p class="mt-6 text-lg text-muted leading-relaxed max-w-[30rem]" data-reveal style="--reveal-delay: 100ms;">
						Ready to automate your operations? Pick a time in the calendar to schedule
						a technical discovery call with a senior architect. No sales fluff —
						engineering strategy.
					</p>

					<!-- Direct channels: spec table -->
					<div class="mt-10" data-reveal style="--reveal-delay: 180ms;">
						<p class="face-data text-muted mb-3">DIRECT CHANNELS — SPEAK TO A HUMAN</p>
						<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
						{channels.map((c) => (
							<a href={c.href} class="spec-row group grid grid-cols-[3.5rem_1fr] md:grid-cols-[3.5rem_1fr_10rem] gap-x-5 items-center py-4 px-2 min-h-[56px]">
								<span class="face-data text-copper">{c.label}</span>
								<span class="face-data !text-[15px] text-ink group-hover:text-green transition-colors">{c.value}</span>
								<span class="hidden md:block text-[13px] text-muted text-right">{c.note}</span>
							</a>
						))}
					</div>

					<!-- Procedure: a true 3-step sequence -->
					<div class="mt-12" data-reveal style="--reveal-delay: 260ms;">
						<p class="face-data text-muted mb-3">PROCEDURE</p>
						<ol class="border-t border-line">
							{steps.map((s) => (
								<li class="spec-row grid grid-cols-[2.5rem_1fr] gap-x-4 py-4 px-2">
									<span class="face-data text-copper pt-0.5">{s.n}</span>
									<div>
										<h2 class="font-bold text-ink text-[16px]">{s.title}</h2>
										<p class="text-[14px] text-muted mt-0.5">{s.copy}</p>
									</div>
								</li>
							))}
						</ol>
					</div>
				</div>

				<!-- Right column: the booking calendar, framed as a dossier figure -->
				<div class="lg:col-span-7" data-reveal style="--reveal-delay: 140ms;">
					<figure class="media-frame">
						<div class="relative bg-paper">
							<iframe
								src="https://api.leadconnectorhq.com/widget/booking/L9a1VqF4ljVNaUhi30Df"
								style="width: 100%; border: none; overflow: hidden; min-height: 700px;"
								scrolling="no"
								id="L9a1VqF4ljVNaUhi30Df_1770784749684"
								title="Book a free consultation — calendar"
							></iframe>
						</div>
						<figcaption>
							<span class="text-copper">FIG. 01</span>
							<span class="truncate">BOOKING CALENDAR — FREE 30-MINUTE CONSULTATION</span>
						</figcaption>
					</figure>
					<script src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript" is:inline></script>
				</div>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<p class="face-data text-muted py-6 text-center">
				NZ · AU · USA — EVERY INSTALL SIGNED OFF BY A 30-YEAR SYSTEMS ENGINEER
			</p>
		</div>
	</section>
</Layout>
