---
import Layout from '../layouts/Layout.astro';
import GoogleRating from '../components/GoogleRating.astro';
import { PHONES, BRAND } from '../lib/site';

// Contact channels — a spec table, not cards. Numbers verbatim, from src/lib/site.ts.
const channels = [
	{ label: PHONES.NZ.code, value: PHONES.NZ.display, href: PHONES.NZ.tel, note: PHONES.NZ.country },
	{ label: PHONES.AU.code, value: PHONES.AU.display, href: PHONES.AU.tel, note: PHONES.AU.country },
	{ label: PHONES.US.code, value: PHONES.US.display, href: PHONES.US.tel, note: PHONES.US.country },
	{ label: 'EMAIL', value: BRAND.email, href: `mailto:${BRAND.email}`, note: 'Sales queries & partnerships' },
];

const steps = [
	{ n: '1', title: 'Pick a time', copy: 'Choose a slot in the calendar. Thirty minutes, no obligation.' },
	{ n: '2', title: 'The discovery call', copy: 'A senior architect maps your operations and finds where leads leak.' },
	{ n: '3', title: 'The specification', copy: 'You receive a written recommendation: the system, the timeline, the number.' },
];
---

<Layout
	title="Book a Free Consultation | System Pros AI"
	description="Book a free 30-minute consultation with System Pros AI. We map your call handling and lead follow-up, then recommend the AI systems that close the gap."
	hideCTA={true}
>
	<link slot="head" rel="preconnect" href="https://api.leadconnectorhq.com" crossorigin />
	<link slot="head" rel="dns-prefetch" href="https://api.leadconnectorhq.com" />
	<link slot="head" rel="preconnect" href="https://link.msgsndr.com" crossorigin />
	<link slot="head" rel="dns-prefetch" href="https://link.msgsndr.com" />
	<!-- ============================================ -->
	<!-- 1. HEADER — intake sheet                     -->
	<!-- ============================================ -->
	<section class="relative">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>CONSULTATION INTAKE</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> ACCEPTING COMMISSIONS</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<!-- Mobile order: intro, calendar, channels + procedure. Desktop: intro and
			     channels stacked in the left column, calendar spanning both rows on the right. -->
			<div class="grid grid-cols-1 lg:grid-cols-12 lg:grid-rows-[auto_1fr] gap-x-14 gap-y-10 lg:gap-y-0 py-10 lg:py-16">
				<!-- Left column, row 1: intro -->
				<div class="order-1 lg:order-none lg:col-span-5 lg:col-start-1 lg:row-start-1">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,4.6vw,3.8rem)] leading-[1.05] text-ink" data-reveal>
						Book a <span class="text-green">free consultation</span>.
					</h1>
					<p class="mt-6 text-lg text-muted leading-relaxed max-w-[30rem]" data-reveal style="--reveal-delay: 100ms;">
						Ready to automate your operations? Pick a time in the calendar to schedule
						a technical discovery call with a senior architect. No sales fluff —
						engineering strategy.
					</p>

					<GoogleRating class="mt-6" />
				</div>

				<!-- Left column, row 2: direct channels + procedure -->
				<div class="order-3 lg:order-none lg:col-span-5 lg:col-start-1 lg:row-start-2 lg:pt-2">
					<!-- Direct channels: spec table -->
					<div class="lg:mt-10" data-reveal style="--reveal-delay: 180ms;">
						<p class="face-data text-muted mb-3">DIRECT CHANNELS — SPEAK TO A HUMAN</p>
						<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
						{channels.map((c) => (
							<a href={c.href} class="spec-row group grid grid-cols-[3.5rem_1fr] md:grid-cols-[3.5rem_1fr_10rem] gap-x-5 items-center py-4 px-2 min-h-[56px]">
								<span class="face-data text-copper">{c.label}</span>
								<span class="face-data !text-[15px] text-ink group-hover:text-green transition-colors">{c.value}</span>
								<span class="hidden md:block text-[13px] text-muted text-right">{c.note}</span>
							</a>
						))}
					</div>

					<!-- Procedure: a true 3-step sequence -->
					<div class="mt-12" data-reveal style="--reveal-delay: 260ms;">
						<p class="face-data text-muted mb-3">PROCEDURE</p>
						<ol class="border-t border-line">
							{steps.map((s) => (
								<li class="spec-row grid grid-cols-[2.5rem_1fr] gap-x-4 py-4 px-2">
									<span class="face-data text-copper pt-0.5">{s.n}</span>
									<div>
										<h2 class="font-bold text-ink text-[16px]">{s.title}</h2>
										<p class="text-[14px] text-muted mt-0.5">{s.copy}</p>
									</div>
								</li>
							))}
						</ol>
					</div>
				</div>

				<!-- Right column: the booking calendar, framed as a dossier figure.
				     No reveal animation: the skeleton must be visible immediately. -->
				<div class="order-2 lg:order-none lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:row-span-2 self-start">
					<figure class="media-frame">
						<div class="relative bg-paper min-h-[760px] sm:min-h-[700px]">
							<!-- Branded loading skeleton, positioned underneath the iframe.
							     The iframe background is transparent until GoHighLevel's own
							     white document paints and covers it. Static — no animation. -->
							<div class="absolute inset-0 flex flex-col gap-4 p-5 sm:p-6">
								<p class="face-data text-muted">LOADING THE BOOKING CALENDAR&hellip;</p>
								<div class="flex-1 min-h-0 border border-line grid grid-rows-[auto_1fr]" aria-hidden="true">
									<div class="grid grid-cols-7 border-b border-line">
										{['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d) => (
											<div class="face-data !text-[10px] text-muted text-center py-2 border-r border-line last:border-r-0">{d}</div>
										))}
									</div>
									<div class="grid grid-cols-7 grid-rows-5">
										{Array.from({ length: 35 }).map((_, i) => (
											<div class="border-r border-b border-line [&:nth-child(7n)]:border-r-0"></div>
										))}
									</div>
								</div>
								<p class="text-[13px] text-muted">
									Calendar not loading? Call <a href={PHONES.NZ.tel} class="link-ink">{PHONES.NZ.display}</a> or email <a href={`mailto:${BRAND.email}`} class="link-ink">{BRAND.email}</a>.
								</p>
							</div>
							<iframe
								src="https://api.leadconnectorhq.com/widget/booking/L9a1VqF4ljVNaUhi30Df"
								style="width: 100%; height: 760px; border: none; overflow: hidden; background: transparent;"
								class="relative z-10 sm:!h-[700px]"
								scrolling="no"
								id="L9a1VqF4ljVNaUhi30Df_1770784749684"
								title="Book a free consultation — calendar"
								onload="window.spTrack && window.spTrack('booking_iframe_load', {}, 'booking')"
							></iframe>
						</div>
						<figcaption>
							<span class="text-copper">FIG. 01</span>
							<span class="truncate">BOOKING CALENDAR — FREE 30-MINUTE CONSULTATION</span>
						</figcaption>
					</figure>
					<script src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript" is:inline></script>
				</div>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<p class="face-data text-muted py-6 text-center">
				NZ · AU · USA — EVERY INSTALL SIGNED OFF BY A 30-YEAR SYSTEMS ENGINEER
			</p>
		</div>
	</section>
</Layout>
