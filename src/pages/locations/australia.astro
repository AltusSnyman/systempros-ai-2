---
import Layout from '../../layouts/Layout.astro';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';

const pageTitle = "AI Voice Agents Australia | 24/7 AI Receptionist";
const pageDescription = "24/7 AI Receptionist for Australian businesses. Aussie-accented voice agents book appointments, integrate with ServiceM8, cost fraction of hiring staff.";

const comparison = [
	{ metric: 'Total cost', human: '$75k+ / year (salary + Super)', ai: 'From $250 / month', win: true },
	{ metric: 'Availability', human: '9am – 5pm, Mon – Fri', ai: '24/7/365', win: true },
	{ metric: 'Liability', human: 'Sick leave, WorkCover', ai: 'Zero. None.', win: true },
];

const features = [
	{
		ref: 'A',
		title: 'True blue accent',
		copy: 'Don’t sound like outsourced overseas support. Our agents sound like they’re sitting in your own office. Trust is retention.',
	},
	{
		ref: 'B',
		title: 'State-based numbers',
		copy: 'Provision local numbers (02, 03, 07, 08) instantly. Great for local SEO and building trust within your specific catchment area.',
	},
	{
		ref: 'C',
		title: 'Trade integrations',
		copy: 'We connect directly to ServiceM8, Tradify, and SimPRO. Automate your job scheduling and stop answering the phone while up a ladder.',
	},
	{
		ref: 'D',
		title: 'Privacy Act compliant',
		copy: 'We take Australian data sovereignty seriously. Fully compliant with APPs and suitable for medical and legal practices.',
	},
	{
		ref: 'E',
		title: 'After-hours triage',
		copy: 'Perfect for property managers. The AI filters urgent maintenance requests from non-urgent ones, saving you thousands in call-out fees.',
	},
	{
		ref: 'F',
		title: 'Zero abandon rate',
		copy: 'Never miss a lead again. Even if 50 people call at once during a radio ad spot, the AI answers every single one simultaneously.',
	},
];

const cities = [
	{ city: 'Sydney', code: '02' },
	{ city: 'Melbourne', code: '03' },
	{ city: 'Brisbane', code: '07' },
	{ city: 'Perth', code: '08' },
	{ city: 'Adelaide', code: '08' },
	{ city: 'Canberra', code: '02' },
];

const industries = [
	{ href: '/solutions/chiropractors', name: 'Chiropractors', copy: 'Fill your adjustment tables. AI books appointments directly into your practice software.' },
	{ href: '/solutions/roofing', name: 'Roofing & Trades', copy: 'Qualify leads instantly. AI handles the inquiries so you can focus on the job site.' },
	{ href: '/solutions/dental', name: 'Dental Practice', copy: 'Reduce no-shows with AI confirmation calls and fill empty slots automatically.' },
	{ href: '/solutions/landscaping', name: 'Landscaping', copy: 'Automate quote collection and seasonal bookings.' },
	{ href: '/solutions/ai-business-solutions', name: 'Business Solutions', copy: 'Broad automation for Australian SMEs across all sectors.' },
	{ href: '/solutions/independent-living', name: 'NDIS & Aged Care', copy: '24/7 empathetic support for participants and families.' },
];

const faqs = [
	{
		question: "How does the AI handle Australian accents and slang?",
		answer: "Our AI models are specifically fine-tuned on Australian English datasets. They understand 'G'day', 'Arvo', and the unique inflection of Australian speech. This ensures your customers feel like they are speaking to a local, building trust and rapport instantly."
	},
	{
		question: "Is this compliant with Australian Privacy Principles (APPs)?",
		answer: "Yes. Data sovereignty and privacy are core to our offering. We ensure all voice data handling complies with the Privacy Act 1988 (Cth). Calls are encrypted, and for sensitive industries (medical, legal), we offer specific configurations to ensure data remains within Australian borders."
	},
	{
		question: "Can I use a local (02, 03, 07, 08) number?",
		answer: "Absolutely. We can provision local numbers for Sydney (02), Melbourne (03), Brisbane (07), Perth (08), and Adelaide (08). Alternatively, we can host 1300 or 1800 numbers if you want a national presence. You can forward your existing business lines to these numbers instantly."
	},
	{
		question: "Does it work with ServiceM8 and Tradify?",
		answer: "Yes, these are two of our most popular integrations for Australian trade businesses. When a customer calls to book a quote, the AI can check your real-time availability in ServiceM8 or Tradify, create a new job card, and even schedule the site visit without you lifting a finger."
	},
	{
		question: "What is the cost compared to an Australian receptionist?",
		answer: "The average receptionist salary in Australia is over $70,000 when you include Superannuation, leave loading, and WorkCover. System Pros AI Voice AI costs a fraction of this—typically around $1,500 - $3,000 per year depending on call volume. That's a ~95% saving on operational overheads."
	},
	{
		question: "Can it handle emergency after-hours calls?",
		answer: "Yes. You can configure 'Emergency Escalation' protocols. For example, if a tenant calls a Property Manager at 3 AM about a burst pipe, the AI detects the urgency and key phrases, and calls your on-call plumber immediately. Non-urgent calls are booked for the next business day."
	},
	{
		question: "Do I need to sign a lock-in contract?",
		answer: "No. We believe the product speaks for itself. We offer month-to-month agreements. You can scale your capacity up or down as your business seasonality dictates, which is perfect for industries like tourism or retail."
	},
	{
		question: "How reliable is the connection?",
		answer: "We use enterprise-grade Tier-1 carrier networks. Our uptime is 99.99%. Unlike a human receptionist who might get sick, take lunch breaks, or have a bad day, your AI agent is consistently polite, professional, and available 24/7/365."
	},
	{
		question: "Can I customize the script?",
		answer: "Fully. You have complete control over the 'System Prompt'. You can tell the AI to be formal, casual, bubbly, or strictly professional. You can update your opening greeting daily if you wish to promote special offers or announce holiday operating hours."
	},
	{
		question: "How long does setup take?",
		answer: "We can have a basic agent live in 24 hours. A fully integrated agent connected to your CRM and Calendar usually takes 3-5 business days to build, test, and refine."
	}
];
---

<Layout title={pageTitle} description={pageDescription}>
	<ServiceSchema
		name="System Pros AI Australia | AI Virtual Receptionist"
		description={pageDescription}
		serviceType="Virtual Receptionist Service"
		areaServed={["Australia", "Sydney", "Melbourne", "Brisbane", "Perth", "Adelaide", "Gold Coast", "Canberra", "Hobart"]}
	/>
	<FAQSchema faqs={faqs} />

	<!-- ============================================ -->
	<!-- 1. HERO — regional file: Australia           -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>REGIONAL FILE — AUSTRALIA</span>
				<span class="face-data text-ink">AU <a href="tel:+61255632110" class="hover:text-green transition-colors">+61 2 5563 2110</a></span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.03] text-ink" data-reveal>
						Your new 24/7 <span class="text-green">Aussie receptionist</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
						Stop paying award wages for someone to answer the phone. Deploy a
						<strong class="text-ink font-semibold">System Pros AI agent</strong> today:
						it speaks with a local Australian accent, integrates with ServiceM8 and
						Salesforce, and never calls in sick.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Get Started in AU</a>
						<a href="#comparison" class="btn-secondary">
							Compare the costs
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<!-- Regional schematic: exchange codes wired to one agent -->
				<div class="lg:col-span-5" aria-hidden="true">
					<svg viewBox="0 0 440 340" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
						<g stroke="var(--color-green)" stroke-width="1.5">
							<path d="M 84 56 H 176 V 138" data-draw-path />
							<path d="M 84 160 H 176" data-draw-path style="--reveal-delay: 150ms;" />
							<path d="M 84 264 H 176 V 182" data-draw-path style="--reveal-delay: 300ms;" />
							<path d="M 264 160 H 356" data-draw-path style="--reveal-delay: 500ms;" />
						</g>
						<g data-reveal>
							<rect x="16" y="34" width="68" height="44" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="50" y="60" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">SYD 02</text>
						</g>
						<g data-reveal style="--reveal-delay: 100ms;">
							<rect x="16" y="138" width="68" height="44" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="50" y="164" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">MEL 03</text>
						</g>
						<g data-reveal style="--reveal-delay: 200ms;">
							<rect x="16" y="242" width="68" height="44" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="50" y="268" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">BNE 07</text>
						</g>
						<g data-reveal style="--reveal-delay: 350ms;">
							<rect x="176" y="128" width="88" height="64" fill="var(--color-green)" />
							<text x="220" y="156" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-paper-lit)">AI AGENT</text>
							<text x="220" y="174" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">AU ACCENT</text>
						</g>
						<g data-reveal style="--reveal-delay: 600ms;">
							<rect x="356" y="138" width="68" height="44" stroke="var(--color-copper)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="390" y="164" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-copper)">BOOKED</text>
						</g>
						<g stroke="var(--color-line)" stroke-width="1" data-reveal style="--reveal-delay: 750ms;">
							<path d="M 16 316 H 424" />
							<path d="M 16 311 V 321" />
							<path d="M 424 311 V 321" />
						</g>
						<text x="220" y="334" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)" data-reveal style="--reveal-delay: 750ms;">EVERY EXCHANGE, ONE AGENT · 24/7/365</text>
					</svg>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. THE COST COMPARISON — spec table          -->
	<!-- ============================================ -->
	<section id="comparison" class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="max-w-[44rem] mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Beat the cost-of-living crisis.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">
					Australian businesses face the highest administrative wages in the world.
					Stop bleeding cash on overheads.
				</p>
			</div>

			<div class="overflow-x-auto" data-reveal style="--reveal-delay: 160ms;">
				<table class="w-full border border-line bg-paper text-left min-w-[560px]">
					<thead>
						<tr class="border-b border-line">
							<th class="face-data text-muted font-normal p-4 w-[24%]">LINE ITEM</th>
							<th class="face-data text-muted font-normal p-4 w-[38%]">HUMAN RECEPTIONIST</th>
							<th class="face-data text-green font-normal p-4 w-[38%]">SYSTEM PROS AI AGENT</th>
						</tr>
					</thead>
					<tbody>
						{comparison.map((row) => (
							<tr class="border-b border-line last:border-b-0 hover:bg-green-faint transition-colors">
								<td class="p-4 font-bold text-ink text-[15px]">{row.metric}</td>
								<td class="p-4 text-muted text-[15px]">{row.human}</td>
								<td class="p-4 text-[15px]">
									<span class="face-data !text-[14px] text-green font-bold">{row.ai}</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="face-data !text-[11px] text-muted mt-3" data-reveal style="--reveal-delay: 220ms;">
				TYPICAL VOICE AI RUNNING COST: $1,500 – $3,000 / YEAR DEPENDING ON CALL VOLUME — A ~95% SAVING ON OVERHEADS
			</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. FEATURES — built for Australian industry  -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Built for Australian industry.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>CAPABILITY SHEET · AU CONFIGURATION</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{features.map((f, i) => (
				<div class="spec-row grid grid-cols-[3rem_1fr] md:grid-cols-[4.5rem_16rem_1fr] gap-x-6 gap-y-2 py-7 px-2 items-baseline" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper">{f.ref}</span>
					<h3 class="text-lg md:text-xl font-bold text-ink">{f.title}</h3>
					<p class="col-start-2 md:col-start-3 text-[15px] text-muted leading-relaxed max-w-[44rem]">{f.copy}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. COVERAGE — drench with number register    -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-6">
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-paper-lit" data-reveal>
						Coast to coast coverage.
					</h2>
					<p class="text-paper-dim text-lg mt-4 leading-relaxed max-w-[30rem]" data-reveal style="--reveal-delay: 100ms;">
						From the CBDs to the outback, System Pros AI keeps your business online.
						We provide localized number provisioning for every major Australian
						capital city.
					</p>
					<a href="/contact" class="btn-primary-inverse mt-8" data-reveal style="--reveal-delay: 200ms;">Provision Your Number</a>
				</div>
				<div class="lg:col-span-6" data-reveal style="--reveal-delay: 160ms;">
					<p class="face-data text-paper-dim mb-3">EXCHANGE REGISTER</p>
					<div class="border-t border-line-drench">
						{cities.map((c) => (
							<div class="flex items-center justify-between py-3.5 px-1 border-b border-line-drench">
								<span class="text-paper-lit font-semibold text-[15px]">{c.city}</span>
								<span class="face-data text-copper">({c.code})</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. INDUSTRY INDEX — ruled links              -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					A complete automation ecosystem.
				</h2>
				<a href="/industries" class="btn-secondary !px-5 !py-2.5 !text-[14px]" data-reveal>All industries</a>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{industries.map((ind, i) => (
				<a href={ind.href} class="spec-row group grid md:grid-cols-[16rem_1fr_2rem] gap-x-8 gap-y-1 items-center py-6 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<h3 class="text-lg md:text-xl font-bold text-ink group-hover:text-green transition-colors">{ind.name}</h3>
					<p class="text-[14.5px] text-muted max-w-[44rem]">{ind.copy}</p>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 6. FAQ                                       -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section-sm)">
		<div class="max-w-[860px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(1.9rem,4vw,3rem)] leading-tight text-ink mb-10" data-reveal>
				Frequently asked questions.
			</h2>

			<div class="rule-ticked" data-draw-rule></div>
			{faqs.map((faq, i) => (
				<details class="spec-row group px-2" data-reveal style={`--reveal-delay: ${Math.min(i, 5) * 50}ms;`}>
					<summary class="flex items-center justify-between gap-6 py-5 cursor-pointer list-none font-bold text-ink text-[17px]">
						{faq.question}
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="shrink-0 text-muted group-open:rotate-180 transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
					</summary>
					<p class="text-muted leading-relaxed pb-6 max-w-[46rem]">{faq.answer}</p>
				</details>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 7. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<div class="rule-ticked mb-16" data-draw-rule></div>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink max-w-[22ch] mx-auto" data-reveal>
				Automate your Aussie business.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 120ms;">
				Get the competitive edge with a 24/7 AI workforce that costs less than
				your coffee budget.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 220ms;">
				Book a Voice AI Demo
			</a>
		</div>
	</section>
</Layout>
