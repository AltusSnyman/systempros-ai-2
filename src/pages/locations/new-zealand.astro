---
import Layout from '../../layouts/Layout.astro';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import FAQSchema from '../../components/seo/FAQSchema.astro';

const pageTitle = "AI Voice Agents New Zealand | 24/7 Kiwi Receptionist";
const pageDescription = "24/7 AI Receptionist for NZ businesses. Kiwi-accented voice agents book appointments, integrate with Xero, cost fraction of hiring reception staff.";

const comparison = [
	{ metric: 'Cost', human: '$65k+ / year in wages', ai: '~$0.25 / hour' },
	{ metric: 'Missed calls', human: 'High (lunch, busy, sick)', ai: 'Zero — infinite capacity' },
	{ metric: 'Availability', human: '40 hours / week', ai: '168 hours / week' },
];

const features = [
	{
		ref: 'A',
		title: 'Natural Kiwi accent',
		copy: 'Trained on thousands of hours of New Zealand speech patterns. It understands “Yeah, nah”, “Sweet as”, and regional place names correctly.',
	},
	{
		ref: 'B',
		title: 'Local NZ numbers',
		copy: 'We provision 09 (Auckland), 04 (Wellington), or 03 (South Island) landlines instantly. Keep your local presence strong.',
	},
	{
		ref: 'C',
		title: 'Instant integrations',
		copy: 'Connects natively with the tools Kiwi businesses use: Xero, Fergus, Tradify, Cliniko, and Timely.',
	},
	{
		ref: 'D',
		title: 'Sovereign security',
		copy: 'Protecting your customer data is paramount. We adhere to NZ Privacy Act requirements and use encrypted enterprise-grade channels.',
	},
	{
		ref: 'E',
		title: 'SMS follow-up',
		copy: 'Automatically send a text message confirmation after booking an appointment or answering a query, complete with Google Maps links.',
	},
	{
		ref: 'F',
		title: 'Infinite scalability',
		copy: 'Running a radio campaign? Expecting a flood of calls? Your AI receptionist can handle 1,000 concurrent calls without breaking a sweat.',
	},
];

const cities = [
	{ city: 'Auckland', code: '09' },
	{ city: 'Wellington', code: '04' },
	{ city: 'Christchurch', code: '03' },
	{ city: 'Hamilton', code: '07' },
];

const industries = [
	{ href: '/solutions/chiropractors', name: 'Chiropractors & Physios', copy: 'Automate patient bookings into Cliniko or Gensolve. Reduce front-desk chaos.' },
	{ href: '/solutions/roofing', name: 'Trades & Roofing', copy: 'Capture every lead while you\'re on the roof. Qualify jobs and book assessments automatically.' },
	{ href: '/solutions/dental', name: 'Dental Clinics', copy: 'Handle emergency triage, hygiene appointments, and post-op check-ups via voice.' },
	{ href: '/solutions/landscaping', name: 'Landscaping', copy: 'Quote faster. Qualify residential vs commercial jobs before you drive to the site.' },
	{ href: '/solutions/ai-business-solutions', name: 'General Business', copy: 'From accounting firms to marketing agencies — automate your client intake.' },
	{ href: '/solutions/independent-living', name: 'Aged Care', copy: 'Compassionate, 24/7 inquiry handling for families and residents.' },
];

const faqs = [
	{
		question: "Do your AI agents really sound like New Zealanders?",
		answer: "Yes. Use our demo to hear for yourself. We utilize state-of-the-art voice synthesis that has been fine-tuned on New Zealand English. This means our agents understand and use local intonation, handle 'Kiwi slang' appropriately, and don't sound like a generic American robot. This builds trust with your local customers immediately."
	},
	{
		question: "Can I keep my current 09 or 021 phone number?",
		answer: "Yes. You have two options: we can port your existing landline number to our system, or you can simply set up a 'Call Forwarding' rule (on busy or no answer) to a dedicated number we provide. This means you don't need to change your marketing materials or business cards."
	},
	{
		question: "What happens if the AI doesn't know the answer?",
		answer: "Our agents are trained to handle uncertainty gracefully. If a caller asks a question that isn't in the knowledge base, the AI can be configured to take a message, escalate the call to a human mobile number, or advise the caller that a specialist will return their call shortly. You receive a full transcript and audio recording of the interaction instantly."
	},
	{
		question: "Does it integrate with my calendar?",
		answer: "Seamlessly. We integrate with Google Calendar, Outlook, Calendly, and industry-specific scheduling tools like Cliniko (for health), Fergus (for trades), or Timely. The AI sees your real-time availability and will only book slots that are actually open, preventing double bookings."
	},
	{
		question: "Is client data secure under NZ law?",
		answer: "Absolutely. We are fully compliant with the New Zealand Privacy Act 2020. All call data is encrypted in transit and at rest. We adhere to strict data governance protocols to ensure your customer's personal information is protected."
	},
	{
		question: "How much does it cost compared to a receptionist?",
		answer: "A full-time receptionist in Auckland costs upwards of $60,000 per year plus KiwiSaver and ACC. System Pros AI Voice AI costs a fraction of that, typically saving businesses between 60-80% on their front-desk operational costs while providing 24/7 coverage that a human cannot match."
	},
	{
		question: "Can the AI handle after-hours emergency calls?",
		answer: "Yes. This is a popular use case for plumbers, electricians, and property managers. The AI can screen calls at 2 AM, determine if it is a genuine emergency based on your criteria, and then wake up the on-call technician if—and only if—it's urgent. Otherwise, it books a job for the morning."
	},
	{
		question: "What industries do you support?",
		answer: "We support any industry that relies on phone bookings. Our most popular sectors in NZ are Trades (Plumbing, Electrical), Healthcare (Dental, Physio), Professional Services (Law, Accounting), and Real Estate."
	},
	{
		question: "Can I customize the greeting?",
		answer: "Completely. You can change the script, the tone of voice, and the specific greeting at any time. You might have a different greeting for public holidays, or a special promotion you want the AI to mention to every caller."
	},
	{
		question: "How fast can we go live?",
		answer: "For a standard setup, we can have you live within 48-72 hours. This includes setting up your knowledge base, connecting your calendar, and testing the voice flows. More complex integrations with CRM databases may take 1-2 weeks."
	}
];
---

<Layout title={pageTitle} description={pageDescription}>
	<ServiceSchema
		name="System Pros AI NZ | AI Virtual Receptionist"
		description={pageDescription}
		serviceType="Virtual Receptionist Service"
		areaServed={["New Zealand", "Auckland", "Wellington", "Christchurch", "Hamilton", "Tauranga", "Dunedin", "Queenstown"]}
	/>
	<FAQSchema faqs={faqs} />

	<!-- ============================================ -->
	<!-- 1. HERO — regional file: New Zealand         -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>REGIONAL FILE — NEW ZEALAND</span>
				<span class="face-data text-ink">NZ <a href="tel:+64212550493" class="hover:text-green transition-colors">021 255 0493</a></span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="py-14 lg:py-20 max-w-[54rem]">
				<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.03] text-ink" data-reveal>
					Stop missing calls. Stop <span class="text-green">losing revenue</span>.
				</h1>
				<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[38rem]" data-reveal style="--reveal-delay: 120ms;">
					In New Zealand, if you don&rsquo;t answer, they call the next bloke on Google.
					Deploy a <strong class="text-ink font-semibold">System Pros AI receptionist</strong>
					today: it answers instantly 24/7, speaks with a natural
					<strong class="text-ink font-semibold">Kiwi accent</strong>, and books jobs
					directly into your calendar while you sleep (or fish).
				</p>
				<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
					<a href="/contact" class="btn-primary">Deploy AI in NZ</a>
					<a href="#comparison" class="btn-secondary">
						See what missed calls cost
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
					</a>
				</div>
			</div>

			<!-- Bottleneck figures: ruled strip -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-4">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">CALLS TO VOICEMAIL</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="40" data-count-suffix="%">40%</span></dd>
					<dd class="text-[13px] text-muted">while you pay for the ads</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">AI AVAILABILITY</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="168">168</span> h/wk</dd>
					<dd class="text-[13px] text-muted">versus 40 for a human desk</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">GO-LIVE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">48–72 h</dd>
					<dd class="text-[13px] text-muted">standard setup, tested</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">RUNNING COST</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">~$0.25/h</dd>
					<dd class="text-[13px] text-muted">no KiwiSaver, no sick days</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. THE SILENT KILLER — comparison table      -->
	<!-- ============================================ -->
	<section id="comparison" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-5">
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink lg:sticky lg:top-28" data-reveal>
						The silent killer of NZ service businesses.
					</h2>
					<p class="text-muted text-lg mt-4 leading-relaxed lg:max-w-[24rem]" data-reveal style="--reveal-delay: 100ms;">
						You spend thousands on Google Ads to make the phone ring. Why are you
						letting 40% of those calls go to voicemail?
					</p>
				</div>
				<div class="lg:col-span-7" data-reveal style="--reveal-delay: 160ms;">
					<table class="w-full border border-line text-left">
						<thead>
							<tr class="border-b border-line bg-green-faint">
								<th class="face-data text-muted font-normal p-4 w-[26%]">LINE ITEM</th>
								<th class="face-data text-muted font-normal p-4 w-[37%]">THE &ldquo;HUMAN&rdquo; BOTTLENECK</th>
								<th class="face-data text-green font-normal p-4 w-[37%]">SYSTEM PROS AI VOICE AI</th>
							</tr>
						</thead>
						<tbody>
							{comparison.map((row) => (
								<tr class="border-b border-line last:border-b-0 hover:bg-green-faint transition-colors">
									<td class="p-4 font-bold text-ink text-[15px]">{row.metric}</td>
									<td class="p-4 text-muted text-[15px]">{row.human}</td>
									<td class="p-4"><span class="face-data !text-[14px] text-green font-bold">{row.ai}</span></td>
								</tr>
							))}
						</tbody>
					</table>
					<p class="face-data !text-[11px] text-muted mt-3">
						TYPICAL FRONT-DESK SAVING: 60 – 80% OF OPERATIONAL COST, WITH 24/7 COVERAGE
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. CAPABILITY SHEET                          -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					More than just answering the phone.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>CAPABILITY SHEET · NZ CONFIGURATION</p>
			</div>

			<div class="grid md:grid-cols-2 gap-x-14">
				{features.map((f, i) => (
					<div class="spec-row grid grid-cols-[3rem_1fr] gap-x-5 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
						<span class="face-data text-copper pt-1">{f.ref}</span>
						<div>
							<h3 class="text-lg font-bold text-ink">{f.title}</h3>
							<p class="text-[14.5px] text-muted mt-1.5 leading-relaxed">{f.copy}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. COVERAGE — drench with number register    -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-6">
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-paper-lit" data-reveal>
						Local presence. National reach.
					</h2>
					<p class="text-paper-dim text-lg mt-4 leading-relaxed max-w-[30rem]" data-reveal style="--reveal-delay: 100ms;">
						System Pros AI provides digital infrastructure for businesses across the
						North and South Islands. Whether you are a plumber in Ponsonby or a
						clinic in Christchurch, we deliver the same enterprise-grade reliability.
					</p>
					<a href="/contact" class="btn-primary-inverse mt-8" data-reveal style="--reveal-delay: 200ms;">Provision Your Number</a>
				</div>
				<div class="lg:col-span-6" data-reveal style="--reveal-delay: 160ms;">
					<p class="face-data text-paper-dim mb-3">EXCHANGE REGISTER</p>
					<div class="border-t border-line-drench">
						{cities.map((c) => (
							<div class="flex items-center justify-between py-3.5 px-1 border-b border-line-drench">
								<span class="text-paper-lit font-semibold text-[15px]">{c.city}</span>
								<span class="face-data text-copper">({c.code})</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. SECTOR INDEX — ruled links                -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Solutions for every Kiwi sector.
				</h2>
				<a href="/industries" class="btn-secondary !px-5 !py-2.5 !text-[14px]" data-reveal>All industries</a>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{industries.map((ind, i) => (
				<a href={ind.href} class="spec-row group grid md:grid-cols-[16rem_1fr_2rem] gap-x-8 gap-y-1 items-center py-6 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<h3 class="text-lg md:text-xl font-bold text-ink group-hover:text-green transition-colors">{ind.name}</h3>
					<p class="text-[14.5px] text-muted max-w-[44rem]">{ind.copy}</p>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 6. FAQ                                       -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section-sm)">
		<div class="max-w-[860px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(1.9rem,4vw,3rem)] leading-tight text-ink mb-10" data-reveal>
				Questions we get asked.
			</h2>

			<div class="rule-ticked" data-draw-rule></div>
			{faqs.map((faq, i) => (
				<details class="spec-row group px-2" data-reveal style={`--reveal-delay: ${Math.min(i, 5) * 50}ms;`}>
					<summary class="flex items-center justify-between gap-6 py-5 cursor-pointer list-none font-bold text-ink text-[17px]">
						{faq.question}
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="shrink-0 text-muted group-open:rotate-180 transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
					</summary>
					<p class="text-muted leading-relaxed pb-6 max-w-[46rem]">{faq.answer}</p>
				</details>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 7. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<div class="rule-ticked mb-16" data-draw-rule></div>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink max-w-[22ch] mx-auto" data-reveal>
				Ready to scale your NZ business?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 120ms;">
				Join leading Kiwi enterprises using System Pros AI to automate their workflow.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 220ms;">
				Book a Voice AI Demo
			</a>
		</div>
	</section>
</Layout>
