---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import RoofingChatbot from '../../components/solutions/RoofingChatbot';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

// Leak audit — known faults and unmeasured leaks, consolidated into one inspection record.
const leakAudit = [
	{ ref: 'L-01', finding: 'The ladder paradox', detail: 'You can’t safely answer the phone from 20 feet up. Every missed call during a storm goes straight to the next roofer on Google — and they close the job.', measured: '20 ft', label: 'up a ladder, phone ringing' },
	{ ref: 'L-02', finding: 'Storm surge overwhelm', detail: '500+ calls hit in 24 hours. Your team is already deployed on-site. No answering service knows roofing well enough to qualify damage or book inspections.', measured: '500+', label: 'calls in 24 hours' },
	{ ref: 'L-03', finding: 'Insurance follow-up slips', detail: 'Leads go cold in 48 hours. With 3 jobs running simultaneously, the insurance follow-up falls through the cracks — and that $22k job evaporates.', measured: '48 hrs', label: 'until a lead goes cold' },
	{ ref: 'L-04', finding: 'Storm leads shop around', detail: '68% of storm-affected homeowners contact 3 or more roofers within the first hour. Speed-to-call isn’t a nice-to-have — it’s the only thing that wins the contract.', measured: '68%', label: 'contact 3+ roofers in hour one' },
	{ ref: 'L-05', finding: 'Enquiries arrive after hours', detail: '55% of all storm inquiry calls come after 5pm — when homeowners get home and see the damage. Your office is closed. The competitor’s AI isn’t.', measured: '55%', label: 'of calls land after 5pm' },
	{ ref: 'L-06', finding: 'Shared leads expire fast', detail: 'Angi and HomeAdvisor leads expire in under 5 minutes if no call is made. You’re paying for leads you can’t convert because nothing responds instantly.', measured: '<5 min', label: 'before a paid lead dies' },
];

const timeline = [
	{ t: 'THIS STORM SEASON', body: 'Competitors with AI response capture the leads your team physically can’t answer. You win the slow week — they win the storm season.' },
	{ t: 'NEXT 12 MONTHS', body: 'No follow-up system means your past clients get called by competitors. You’re running full speed just to stay flat — zero compounding revenue from existing relationships.' },
	{ t: 'YEAR 3+', body: 'The roofers who deployed AI systems now have a cost advantage you can’t match manually. Recruiting, retaining, and competing on price becomes a losing battle.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Answer every storm call. Automatically.',
		body: 'Your AI voice agent handles 1,000 concurrent calls — qualifying damage severity, booking inspections into AccuLynx, and delivering a flawless customer experience at 2am on a Sunday.',
		points: [
			'Handles 1,000+ concurrent storm calls with zero hold time',
			'Qualifies damage: active leak vs. cosmetic vs. insurance claim',
			'Books inspections directly into AccuLynx or JobNimbus',
			'Reactivates past clients with pre-winter inspection outreach',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A website that converts storm traffic 24/7.',
		body: 'Your current site is a brochure. We build a lead machine — with AI chat, instant quote capture, and storm-season landing pages that turn Google traffic into booked inspections while you sleep.',
		points: [
			'Storm-season landing pages built to rank and convert',
			'AI chat widget captures leads when you can’t answer',
			'Instant quote forms with damage-type qualification',
			'Google review automation increases local ranking',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Beat four other roofers to every Angi lead.',
		body: 'Shared leads die in minutes. The Lead Reactor calls your Angi, HomeAdvisor, and Facebook ad leads in under 10 seconds — before the other roofers even open the notification.',
		points: [
			'Calls Angi/HomeAdvisor leads in under 10 seconds',
			'Follows up via voice, SMS and WhatsApp simultaneously',
			'Facebook ad leads called while still on the ad',
			'Automated follow-up sequence until the prospect responds',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your entire operation. One AI brain.',
		body: 'A private AI that knows your business — crew schedules, job statuses, supplier contacts, insurance processes. Accessible via WhatsApp, so your team gets answers instantly while you focus on the roof.',
		points: [
			'Field crew gets job updates and schedules via WhatsApp',
			'Insurance claim documentation generated automatically',
			'Supplier pricing lookups and material orders supported',
			'Client follow-up reminders sent without you thinking about it',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A blueprint for your AI-powered operation.',
		body: 'Before we build, we audit. Our consultation identifies every gap in your current lead and operations workflow — then architects the exact system stack for your size, market, and growth goals.',
		points: [
			'Forensic audit of your current call and lead flow',
			'Competitor gap analysis — where they’re winning on speed',
			'Custom AI deployment roadmap for your roofing operation',
			'Integration plan for AccuLynx, JobNimbus, or your existing tools',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'Turn your whole crew into AI-powered operators.',
		body: 'The systems are only as good as the people running them. We train your estimators, office staff, and project managers to work alongside AI — cutting the learning curve from months to days.',
		points: [
			'Hands-on AI training for estimators and office staff',
			'Custom AI workflows for your exact quoting process',
			'SOPs built around AI tools so adoption actually sticks',
			'Ongoing curriculum updates as AI tools evolve',
		],
	},
];

const asFound = [
	'Missed calls during storm surge — jobs go to competitors',
	'Angi leads go cold before anyone calls them',
	'Generic website that captures no after-hours leads',
	'Field crew chasing you for updates mid-job',
	'No system for past-client reactivation in slow season',
	'Team not using AI — burning hours on manual tasks',
];

const asCommissioned = [
	'1,000 concurrent calls answered — zero missed leads',
	'Shared leads called in under 10 seconds automatically',
	'Lead-gen site converts storm traffic around the clock',
	'Crew gets schedules and updates via WhatsApp AI',
	'Automated annual inspection outreach fills the slow season',
	'Full team trained on AI tools — 3× productivity baseline',
];
---

<Layout
	title="AI Systems for Roofing Contractors | Storm Response & Lead Automation"
	description="Handle 1,000+ storm calls instantly. Full-stack AI for roofers: Voice AI, Lead Gen, Lead Reactor, Private Assistant, Consultation & Training — all engineered for your vertical."
>
	<ServiceSchema
		name="AI Storm Response & Lead Automation for Roofing"
		description="Full-stack AI deployment for roofing contractors covering voice response, lead generation, automated follow-up, and field operations."
		serviceType="Roofing AI Automation"
	/>
	<Breadcrumbs currentTitle="Roofing" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — ROOFING</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> STORM-SEASON READY</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
						Storm season doesn't wait <span class="text-green">for voicemail.</span>
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
						When hail hits, your phone rings 500 times and your crew is on every roof in town.
						We install six AI systems — so every lead is captured, every estimate is booked,
						and every season is your best yet.
					</p>
					<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<AudioDemoModal videoSrc="/assets/industry-videos/roofing.mp4" industryName="Roofing" client:visible />
					</div>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 180ms;">
					<MediaFrame fig="FIG. 01" caption="ROOFING — STORM-SEASON INTAKE, LIVE CALL">
						<video
							src="/assets/industry-videos/roofing.mp4"
							poster="/assets/industry-videos/roofing.webp"
							muted
							loop
							playsinline
							preload="none"
							class="w-full aspect-[4/5] object-cover"
							data-hover-play
						></video>
					</MediaFrame>
				</div>
			</div>

			<!-- Commissioning figures -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-4">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">MISSED STORM CALLS</dt>
					<dd class="mt-1 text-2xl font-bold text-green">0</dd>
					<dd class="text-[13px] text-muted">once the system is live</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">LEAD RESPONSE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">&lt;10s</dd>
					<dd class="text-[13px] text-muted">from form fill to first call</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">CONCURRENT LINES</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="1000">1000</span></dd>
					<dd class="text-[13px] text-muted">calls handled at once</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">ESTIMATES BOOKED</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="3" data-count-suffix="&times;">3&times;</span></dd>
					<dd class="text-[13px] text-muted">against manual intake</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- 2. STORM SCHEMATIC — the signature move -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<p class="face-data text-muted mb-6" data-reveal>DWG. R-01 — STORM EVENT, AS-COMMISSIONED CALL PATH</p>
			<svg viewBox="0 0 960 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="Schematic: a storm event triggers 500 calls in 24 hours, AI triage answers all of them and routes each to a booked inspection, crew dispatch or insurance documentation">
				<g stroke="var(--color-green)" stroke-width="1.5">
					<path d="M 140 160 H 236" data-draw-path />
					<path d="M 400 160 H 496" data-draw-path style="--reveal-delay: 250ms;" />
					<path d="M 660 160 H 720 V 64 H 780" data-draw-path style="--reveal-delay: 500ms;" />
					<path d="M 660 160 H 780" data-draw-path style="--reveal-delay: 600ms;" />
					<path d="M 660 160 H 720 V 256 H 780" data-draw-path style="--reveal-delay: 700ms;" />
				</g>
				<g data-reveal>
					<rect x="20" y="128" width="120" height="64" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
					<text x="80" y="156" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="12" fill="var(--color-ink)">STORM</text>
					<text x="80" y="174" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)">HAIL / WIND EVENT</text>
				</g>
				<g data-reveal style="--reveal-delay: 150ms;">
					<rect x="236" y="128" width="164" height="64" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
					<text x="318" y="156" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="12" fill="var(--color-ink)">CALLS &times;500</text>
					<text x="318" y="174" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)">WITHIN 24 HRS</text>
				</g>
				<g data-reveal style="--reveal-delay: 350ms;">
					<rect x="496" y="120" width="164" height="80" fill="var(--color-green)" />
					<text x="578" y="152" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="12" fill="var(--color-paper-lit)">AI TRIAGE</text>
					<text x="578" y="172" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">LEAK / COSMETIC / CLAIM</text>
				</g>
				<g data-reveal style="--reveal-delay: 650ms;">
					<rect x="780" y="36" width="160" height="56" stroke="var(--color-copper)" stroke-width="1.5" fill="var(--color-paper)" />
					<text x="860" y="68" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-copper)">INSPECTION BOOKED</text>
					<rect x="780" y="132" width="160" height="56" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
					<text x="860" y="164" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">CREW DISPATCH</text>
					<rect x="780" y="228" width="160" height="56" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
					<text x="860" y="260" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">INSURANCE DOCS</text>
				</g>
				<g stroke="var(--color-line)" stroke-width="1" data-reveal style="--reveal-delay: 800ms;">
					<path d="M 20 308 H 940" />
					<path d="M 20 303 V 313" />
					<path d="M 940 303 V 313" />
				</g>
				<text x="480" y="300" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9.5" fill="var(--color-muted)" data-reveal style="--reveal-delay: 800ms;">EVERY CALL ANSWERED · ZERO HOLD TIME · 2AM SUNDAY INCLUDED</text>
			</svg>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					The leak audit.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SIX FINDINGS · MEASURED ON REAL ROOFING OPERATIONS</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- 4. COST OF INACTION -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 grid lg:grid-cols-12 gap-12">
			<div class="lg:col-span-5">
				<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
				<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5.2rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
					$<span data-count="330" data-count-suffix=",000+">330,000+</span>
				</div>
				<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
					Based on 15 missed storm calls per week &times; $22,000 average job value.
					This isn't a warning — it's a pattern every roofing company without systems eventually hits.
				</p>
			</div>
			<div class="lg:col-span-7">
				<div class="rule-ticked" data-draw-rule></div>
				{timeline.map((t, i) => (
					<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
						<span class="face-data text-copper pt-0.5">{t.t}</span>
						<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 5. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for roofing.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 6. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your roofing operation.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your business — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 7. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEM PROS AI DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 8. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — ROOFING DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your next storm season should be your best.
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll map exactly which of the six systems
				will have the biggest impact on your roofing operation — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>

	<RoofingChatbot client:idle />
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
