---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'C-01', finding: 'The lunch-hour gap', detail: '60% of new patient calls happen during lunch and after 5pm — exactly when your CA is on break or the clinic is closed. Every unanswered call is a patient in pain who just called your competitor.', measured: '60%', label: 'of calls land in coverage gaps' },
	{ ref: 'C-02', finding: 'The one-CA bottleneck', detail: 'Your chiropractic assistant can only do one thing at a time. When phones ring during a busy intake, something breaks — the call goes unanswered, the patient waits, or billing gets delayed.', measured: '1', label: 'CA, three simultaneous jobs' },
	{ ref: 'C-03', finding: 'Insurance qualification drain', detail: '"Do you take my insurance?" calls take 10+ minutes each and consume your CA’s most productive hours. AI answers these instantly — and qualifies the patient simultaneously.', measured: '10 min', label: 'per insurance call' },
	{ ref: 'C-04', finding: 'No-shows bleed revenue silently', detail: 'The average chiropractic practice loses $3,500–$6,000 per week to no-shows and late cancellations. Without an automated reminder and reschedule system, you pay that tax every week.', measured: '$4,200/wk', label: 'lost to no-shows' },
	{ ref: 'C-05', finding: 'Facebook leads go cold instantly', detail: 'Facebook ad leads for chiropractic services go cold in 5 minutes without a call. You’re running ads but not capturing the window that converts them.', measured: '5 min', label: 'lead conversion window' },
];

const timeline = [
	{ t: 'THIS MONTH', body: 'Patients in acute pain call the clinic that answers. Without after-hours AI, you’re handing new patients to the practice down the street — every single lunch hour.' },
	{ t: 'NEXT 12 MONTHS', body: 'No-show losses compound. Without an automated reminder and reschedule system, you lose 15–20% of booked appointments every week — all carrying your fixed clinic overhead.' },
	{ t: 'YEAR 3+', body: 'Clinics with AI-managed intake, recall, and ad follow-up have a structural cost advantage. You’re still hiring a second CA just to handle the call volume they manage automatically.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Answer every patient call. Including lunch break.',
		body: 'Your AI voice agent handles calls during lunch, after 5pm, and on weekends — qualifying patients, booking appointments, and delivering a professional experience when your CA simply can’t be there.',
		points: [
			'Handles calls during lunch, after 5pm, and weekends — zero coverage gaps',
			'Qualifies new patients: insurance, injury type, urgency level, and availability',
			'Books directly into your scheduling system — confirmed appointments, not callbacks',
			'Reactivates lapsed patients with automated re-engagement outreach',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A clinic website that books new patients while you adjust.',
		body: 'Your current site is a brochure. We build a patient acquisition machine — with 24/7 booking, insurance FAQ automation, and landing pages that convert urgently searching patients while you’re mid-adjustment.',
		points: [
			'New patient booking widget works 24/7 — no staff required',
			'"Accepting new patients near me" landing pages rank and convert urgently',
			'Insurance FAQ answered automatically — "Do you take Blue Cross?" in seconds',
			'Intake forms completed before the first appointment to save front-desk time',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Call your Facebook ad leads before they see your competitor’s ad.',
		body: 'Facebook chiropractic leads go cold in under 5 minutes. The Lead Reactor calls them within 10 seconds of form submission — before they’ve even closed the tab and found another clinic.',
		points: [
			'Facebook chiropractic leads called in under 10 seconds of form submission',
			'Multi-channel follow-up via voice, SMS, and WhatsApp simultaneously',
			'No-show patients automatically rescheduled without CA involvement',
			'Drop-off patients reactivated with care-plan continuation outreach',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your CA has an AI co-pilot for every question.',
		body: 'A private AI that knows your clinic — patient records, insurance plans, schedules, and supplier contacts. Accessible instantly, answering the questions that currently interrupt your sessions.',
		points: [
			'Insurance verification and benefits lookups handled instantly',
			'Patient history and treatment notes pulled during any call',
			'Daily schedule summaries and no-show alerts delivered to your team automatically',
			'Supplier and equipment queries resolved without interrupting your sessions',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A clinic growth blueprint from healthcare-focused AI strategists.',
		body: 'Before we build, we audit. Our consultation identifies every gap in your intake, no-show, and recall workflow — then architects the exact AI stack for your patient volume and growth goals.',
		points: [
			'Audit of your current new patient acquisition and intake workflow',
			'No-show pattern analysis and automated solution design',
			'Custom AI deployment roadmap for your clinic size and patient volume',
			'Integration design for your EHR and scheduling platform',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'Train your CA and front desk to use AI tools daily.',
		body: 'The systems are only as good as the people running them. We train your chiropractic assistants and front office team to work alongside AI — cutting the learning curve from months to days.',
		points: [
			'Hands-on training for chiropractic assistants and front office staff',
			'AI workflows for scheduling, insurance queries, and patient communication',
			'SOPs that embed AI into your clinic’s daily rhythm within days',
			'Ongoing updates as better healthcare AI tools are released',
		],
	},
];

const asFound = [
	'New patients call during lunch and get voicemail',
	'CA overwhelmed managing phones + intake simultaneously',
	'No-shows cost $4,000+ per week without a system',
	'Facebook ad leads go cold in minutes',
	'Insurance calls drain 2+ hours of CA time daily',
	'Manual recall — lapsed patients don’t return',
];

const asCommissioned = [
	'After-hours and lunch calls answered and booked automatically',
	'AI handles call volume so CA focuses on patient experience',
	'Automated reminders and reschedule system slashes no-shows',
	'Facebook leads called in under 10 seconds',
	'Insurance FAQs handled instantly by AI',
	'Automated reactivation outreach brings back lapsed patients',
];
---

<Layout
	title="AI Systems for Chiropractors | Patient Intake & No-Show Reduction"
	description="Patients in pain don't leave voicemails. Full-stack AI for chiropractic clinics: Voice AI, Lead Gen, Lead Reactor, Private Assistant, Consultation & Training."
>
	<ServiceSchema
		name="AI Patient Intake & No-Show Reduction for Chiropractic Clinics"
		description="Full-stack AI deployment for chiropractic clinics covering voice response, patient intake, automated follow-up, and practice operations."
		serviceType="Chiropractic Practice AI Automation"
	/>
	<Breadcrumbs currentTitle="Chiropractic" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — CHIROPRACTIC</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> LUNCH-HOUR COVERAGE ACTIVE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
						Patients in pain don't leave <span class="text-green">voicemails.</span>
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
						When someone's back goes out, they call the first clinic that answers.
						Your CA is already handling check-ins, billing, and insurance questions simultaneously.
						We install six AI systems so no patient slips through the cracks.
					</p>
					<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<AudioDemoModal videoSrc="/assets/industry-videos/chiro.mp4" industryName="Chiropractic" client:visible />
					</div>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 180ms;">
					<MediaFrame fig="FIG. 01" caption="CHIROPRACTIC — NEW PATIENT INTAKE, LIVE CALL">
						<video
							src="/assets/industry-videos/chiro.mp4"
							poster="/assets/industry-videos/chiro.webp"
							muted
							loop
							playsinline
							preload="none"
							class="w-full aspect-[4/5] object-cover"
							data-hover-play
						></video>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. COVERAGE CLOCK — distinctive device -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					Your phone coverage, surveyed.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>DWG. C-01 — 24-HOUR COVERAGE SECTION</p>
			</div>

			<svg viewBox="0 0 960 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="Coverage diagram: front desk covers 9 to 12 and 1 to 5; lunch, evenings and nights are uncovered — where 60% of new patient calls land. The AI line covers all 24 hours.">
				<!-- hour scale -->
				<g font-family="Fragment Mono, monospace" font-size="10" fill="var(--color-muted)">
					<text x="80" y="20">12AM</text>
					<text x="320" y="20">9AM</text>
					<text x="420" y="20">12PM</text>
					<text x="455" y="20">1PM</text>
					<text x="590" y="20">5PM</text>
					<text x="900" y="20">12AM</text>
				</g>
				<!-- FRONT DESK row -->
				<text x="20" y="76" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)" data-reveal>FRONT DESK</text>
				<g data-reveal style="--reveal-delay: 120ms;">
					<rect x="80" y="40" width="860" height="52" stroke="var(--color-line)" stroke-width="1" fill="var(--color-paper)" />
					<rect x="330" y="40" width="100" height="52" fill="var(--color-green)" opacity="0.85" />
					<rect x="466" y="40" width="130" height="52" fill="var(--color-green)" opacity="0.85" />
				</g>
				<g data-reveal style="--reveal-delay: 300ms;">
					<rect x="430" y="40" width="36" height="52" stroke="var(--color-copper)" stroke-width="1.5" fill="none" />
					<text x="448" y="112" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9.5" fill="var(--color-copper)">LUNCH GAP</text>
					<rect x="596" y="40" width="344" height="52" stroke="var(--color-copper)" stroke-width="1.5" fill="none" />
					<text x="768" y="112" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9.5" fill="var(--color-copper)">AFTER 5PM — 60% OF NEW PATIENT CALLS</text>
				</g>
				<!-- AI AGENT row -->
				<text x="20" y="182" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)" data-reveal style="--reveal-delay: 420ms;">AI AGENT</text>
				<g data-reveal style="--reveal-delay: 480ms;">
					<rect x="80" y="146" width="860" height="52" fill="var(--color-green)" />
					<text x="510" y="178" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-paper-lit)">CONTINUOUS COVERAGE · 24/7 · NO BREAKS, NO SICK DAYS</text>
				</g>
				<g stroke="var(--color-line)" stroke-width="1" data-reveal style="--reveal-delay: 600ms;">
					<path d="M 80 226 H 940" />
					<path d="M 80 221 V 231" />
					<path d="M 940 221 V 231" />
				</g>
			</svg>

			<dl class="grid grid-cols-2 md:grid-cols-3 mt-10 border-t border-line">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">MISSED LUNCH-HOUR CALLS</dt>
					<dd class="mt-1 text-2xl font-bold text-green">0</dd>
					<dd class="text-[13px] text-muted">once the system is live</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">NO-SHOWS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="60" data-count-suffix="%">60%</span> fewer</dd>
					<dd class="text-[13px] text-muted">automated reminders + reschedules</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">NEW PATIENT VOLUME</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="2.5" data-count-suffix="&times;">2.5&times;</span></dd>
					<dd class="text-[13px] text-muted">against manual intake</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					The leak audit.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>FIVE FINDINGS · INTAKE TO RECALL</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}

			<!-- Cost of inaction -->
			<div class="grid lg:grid-cols-12 gap-12 mt-16">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
					<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
						$<span data-count="218" data-count-suffix=",400+">218,400+</span>
					</div>
					<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
						Based on 14 missed calls per week &times; $900 average plan-of-care value over 52 weeks.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{timeline.map((t, i) => (
						<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
							<span class="face-data text-copper pt-0.5">{t.t}</span>
							<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for chiropractic.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your clinic.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your practice — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEM PROS AI DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — CHIROPRACTIC DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your next new patient just called. Did you answer?
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll identify exactly where your clinic is losing
				patients and map the AI systems that will fill your schedule — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
