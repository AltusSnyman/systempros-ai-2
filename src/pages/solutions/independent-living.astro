---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import IndependentLivingChatbot from '../../components/solutions/IndependentLivingChatbot';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'SL-01', finding: 'The after-hours inquiry gap', detail: 'Families make senior living decisions in the evenings, after they’ve been to work and spent time with their loved one. Your sales desk closes at 5pm. The first community to respond — day or night — wins the tour.', measured: '5PM', label: 'when your desk closes' },
	{ ref: 'SL-02', finding: 'First response wins the decision', detail: 'Research shows 78% of families choose the first senior living community to respond to their inquiry. Not the nicest. Not the cheapest. The fastest. Your 9-to-5 response window is giving tours away.', measured: '78%', label: 'choose the first responder' },
	{ ref: 'SL-03', finding: 'Manual tour booking', detail: 'Every tour booking requires a back-and-forth with your admissions team. Families who can’t instantly confirm a time call the next community on their list. Manual scheduling is costing you occupancy.', measured: '2.4', label: 'communities compared per family' },
	{ ref: 'SL-04', finding: 'Waitlist management by spreadsheet', detail: 'Leads who inquire but aren’t ready yet fall off your radar. Without an automated nurture sequence, those families choose a competitor six months later because they hadn’t heard from you.', measured: '6 mo', label: 'nurture window going unused' },
	{ ref: 'SL-05', finding: 'Every empty suite is cash leaving', detail: 'Each empty suite costs the community $3,000–$8,000 per month in lost revenue against fixed operating costs. Occupancy below 85% creates financial distress that compounds every month.', measured: '$4,500/mo', label: 'per empty suite' },
];

const timeline = [
	{ t: 'THIS WEEK', body: 'A family called at 7:30pm to ask about a room for their mother. Your voicemail told them to call back. The community across town answered. That’s $4,500/month gone — and it started with a single unanswered call.' },
	{ t: 'NEXT 6 MONTHS', body: 'Occupancy drifts below 85% — the threshold where fixed costs begin to outpace revenue. Without a recovery system, it takes 6–12 months to stabilise, and the financial pressure affects everything from staffing to maintenance.' },
	{ t: 'YEAR 3+', body: 'Communities with AI-managed inquiry capture, tour booking, and family nurturing maintain 90%+ occupancy consistently. The gap in financial health between AI-enabled and manual communities compounds every quarter.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Answer every family inquiry. Including Sunday evening.',
		body: 'Your AI voice agent handles family inquiries at any hour — with warmth, patience, and accurate information. It qualifies care level needs, books tours directly into your admissions calendar, and reactivates past inquiries automatically.',
		points: [
			'Handles family inquiries at any hour — with warmth, patience, and accurate information',
			'Qualifies care level needs: independent living vs. assisted vs. memory care',
			'Books community tours directly into your admissions calendar automatically',
			'Reactivates waitlist and past-inquiry families with compassionate re-engagement',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A community website that converts evening research into morning tours.',
		body: 'Your website needs to do the heavy lifting after 5pm. We build after-hours booking widgets, care-level landing pages, virtual tour galleries, and AI chat that answers family questions around the clock.',
		points: [
			'After-hours tour booking widget captures families when they’re ready to commit',
			'Landing pages for specific care levels and amenity categories',
			'Virtual tour and photo galleries with AI chat for late-night questions',
			'Family testimonial pages built for the emotional confidence that drives decisions',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Follow up every inquiry before another community books the tour.',
		body: 'New inquiries followed up in under 10 seconds. Waitlist families nurtured over months. Tour no-shows rescheduled automatically. Multi-channel outreach so your community is always the first name families remember.',
		points: [
			'New inquiries followed up in under 10 seconds — day, evening, and weekend',
			'Multi-channel follow-up: voice, SMS, and email with warm, professional messaging',
			'Waitlist families nurtured automatically over weeks and months',
			'Tour no-shows rescheduled immediately — without admissions team involvement',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your admissions and care team. Supported by AI.',
		body: 'A private AI that knows your community — suite availability, pricing, care levels, and inquiry history. Accessible by any staff member. Delivers daily occupancy reports and move-in coordination automatically.',
		points: [
			'Suite availability, pricing, and care-level FAQs answered instantly for any staff member',
			'Family inquiry history and notes pulled up during any call or tour',
			'Move-in documentation and checklist coordination managed automatically',
			'Daily occupancy reports and inquiry pipeline summaries delivered to management',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'An occupancy strategy built for your community’s specific market.',
		body: 'Before we build, we audit. Our consultation maps your inquiry capture, tour conversion, and occupancy gaps — then architects the exact AI deployment for your community size, care mix, and market position.',
		points: [
			'Audit of your current inquiry capture and tour conversion process',
			'Occupancy gap analysis — where families are choosing competitors and why',
			'Custom AI deployment roadmap for your community size and care mix',
			'Integration design for your CRM and admissions management platform',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'AI tools that improve every family interaction.',
		body: 'We train admissions coordinators, care managers, and administrative staff to use AI for inquiry management, tour follow-up, move-in coordination, and family engagement — making every interaction faster and warmer.',
		points: [
			'AI training for admissions coordinators, care managers, and administrative staff',
			'Communication workflows that make every family feel heard and prioritised',
			'AI tools for tour follow-up, move-in coordination, and family engagement',
			'Ongoing training curriculum as senior living AI capabilities evolve',
		],
	},
];

const asFound = [
	'After-hours family inquiries go to voicemail — community loses the tour',
	'Manual tour booking requires back-and-forth — families book elsewhere',
	'Waitlist leads fall off the radar with no follow-up',
	'Occupancy drifts below 85% without a recovery system',
	'Admissions team manually tracking leads in spreadsheets',
	'Family questions answered only during business hours',
];

const asCommissioned = [
	'Every family inquiry answered 24/7 with compassion and accurate information',
	'Instant tour booking confirmation — families commit in the moment',
	'Waitlist nurture sequences run for months automatically',
	'Proactive occupancy management maintains 85%+ consistently',
	'Full inquiry pipeline tracked and actioned by AI',
	'AI answers family FAQs around the clock — tours happen from evening enquiries',
];
---

<Layout
	title="AI Systems for Senior Living Communities | Occupancy & Family Inquiry Automation"
	description="Families call after hours. Full-stack AI for senior living communities: 24/7 inquiry capture, automated tour booking, and occupancy management."
>
	<ServiceSchema
		name="AI Occupancy & Family Inquiry Automation for Senior Living"
		description="Full-stack AI deployment for senior living communities covering 24/7 family inquiry capture, automated tour booking, occupancy management, and community operations."
		serviceType="Senior Living AI Automation"
	/>
	<Breadcrumbs currentTitle="Senior Living" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — SENIOR LIVING</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> EVENING INQUIRIES COVERED</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
						Families call at 7pm. Is someone <span class="text-green">answering?</span>
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[35rem]" data-reveal style="--reveal-delay: 120ms;">
						Families research senior living for their loved ones after work — when your sales team
						has gone home. The community that responds first wins the tour 78% of the time. We
						install six AI systems that capture every inquiry, book every tour, and maintain
						occupancy above 85% — around the clock.
					</p>
					<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<AudioDemoModal videoSrc="/assets/industry-videos/ndis.mp4" industryName="Senior Living" client:visible />
					</div>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 180ms;">
					<MediaFrame fig="FIG. 01" caption="SENIOR LIVING — FAMILY INQUIRY, LIVE CALL">
						<video
							src="/assets/industry-videos/ndis.mp4"
							poster="/assets/industry-videos/ndis.webp"
							muted
							loop
							playsinline
							preload="none"
							class="w-full aspect-[4/5] object-cover"
							data-hover-play
						></video>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. OCCUPANCY GAUGE — distinctive device -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-5" aria-hidden="true">
					<svg viewBox="0 0 400 250" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[26rem] mx-auto">
						<!-- gauge track: 180° arc -->
						<path d="M 50 210 A 150 150 0 0 1 350 210" stroke="var(--color-line)" stroke-width="14" stroke-linecap="butt" />
						<!-- filled to 90%: sweep 162° of the half-circle -->
						<path d="M 50 210 A 150 150 0 0 1 335.4 163.6" stroke="var(--color-green)" stroke-width="14" stroke-linecap="butt" data-draw-path />
						<!-- 85% threshold tick -->
						<g data-reveal style="--reveal-delay: 700ms;">
							<path d="M 328 116 L 349 100" stroke="var(--color-copper)" stroke-width="2.5" />
							<text x="356" y="96" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-copper)">85%</text>
						</g>
						<text x="200" y="176" text-anchor="middle" font-family="Archivo, sans-serif" font-weight="800" font-size="52" fill="var(--color-ink)" data-reveal style="--reveal-delay: 400ms;">90%+</text>
						<text x="200" y="204" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-muted)" data-reveal style="--reveal-delay: 500ms;">OCCUPANCY, AI-MANAGED INTAKE</text>
						<text x="200" y="242" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)" data-reveal style="--reveal-delay: 600ms;">BELOW THE 85% MARK, FIXED COSTS OUTPACE REVENUE</text>
					</svg>
				</div>
				<div class="lg:col-span-7">
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
						Occupancy is an intake problem, not a marketing problem.
					</h2>
					<p class="text-muted text-lg leading-relaxed mt-4 max-w-[36rem]" data-reveal style="--reveal-delay: 100ms;">
						The average family evaluates 2.4 communities and commits to the one that responded
						first and followed up consistently. Every evening inquiry your desk misses is a
						suite that stays empty against full operating costs.
					</p>
					<dl class="grid grid-cols-2 md:grid-cols-3 mt-8 border-t border-line">
						<div class="py-5 pr-5 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
							<dt class="face-data text-muted">INQUIRIES MISSED</dt>
							<dd class="mt-1 text-2xl font-bold text-green">0</dd>
							<dd class="text-[13px] text-muted">after hours included</dd>
						</div>
						<div class="py-5 md:px-5 md:border-r border-line" data-reveal style="--reveal-delay: 240ms;">
							<dt class="face-data text-muted">FIRST-RESPONDER WIN RATE</dt>
							<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="78" data-count-suffix="%">78%</span></dd>
							<dd class="text-[13px] text-muted">of family decisions</dd>
						</div>
						<div class="py-5 md:pl-5" data-reveal style="--reveal-delay: 320ms;">
							<dt class="face-data text-muted">EMPTY SUITE COST</dt>
							<dd class="mt-1 text-2xl font-bold text-ink">$4,500<span class="text-[0.55em] text-muted font-bold">/mo</span></dd>
							<dd class="text-[13px] text-muted">against fixed overheads</dd>
						</div>
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					Where occupancy leaks away.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>FIVE FINDINGS · INQUIRY TO MOVE-IN</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}

			<!-- Cost of inaction -->
			<div class="grid lg:grid-cols-12 gap-12 mt-16">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
					<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
						$<span data-count="648" data-count-suffix=",000+">648,000+</span>
					</div>
					<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
						Based on 3 empty suites &times; $4,500/month &times; 12 months from missed inquiry capture.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{timeline.map((t, i) => (
						<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
							<span class="face-data text-copper pt-0.5">{t.t}</span>
							<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for senior living.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your community.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your community — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEMPROS DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — SENIOR LIVING DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[24ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				The suite is ready. Let's make sure every family knows.
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll map exactly how to capture every after-hours inquiry,
				book more tours, and maintain occupancy above 85% — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>

	<IndependentLivingChatbot client:idle />
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
