---
import Layout from '../../layouts/Layout.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'CO-01', finding: 'The discovery call trap', detail: 'Most coaches spend 20–30% of their working week on discovery calls with people who have no budget, no urgency, and no decision authority. Every unqualified call is time you could have spent delivering to paying clients.', measured: '30%', label: 'of your week, unqualified' },
	{ ref: 'CO-02', finding: 'Manual DM outreach burnout', detail: 'Chasing leads through Instagram DMs, email, and follow-up calls takes 3–4 hours a day. That’s delivery time you’re trading for admin work — and it still doesn’t scale.', measured: '4 hrs/day', label: 'on manual follow-up' },
	{ ref: 'CO-03', finding: 'The launch-to-enrollment gap', detail: 'Most coaches lose 60–90 days between launching a program and getting their first payment. Without an automated funnel follow-up system, momentum dies and the launch resets to zero.', measured: '90 days', label: 'launch to first payment' },
	{ ref: 'CO-04', finding: 'Sales close on touch 3–7, not call 1', detail: '60–80% of coaching program sales close on follow-up touchpoints three through seven. Most coaches stop at one or two. The revenue isn’t lost — it’s just not being chased.', measured: '80%', label: 'of sales close on touch 3–7' },
	{ ref: 'CO-05', finding: 'Masterclass no-shows don’t come back', detail: '70% of masterclass registrants don’t attend live. Without an automated replay sequence and follow-up, you pitched your best content to an empty room and got nothing for it.', measured: '70%', label: 'of registrants skip the live' },
	{ ref: 'CO-06', finding: 'Objections go unhandled', detail: '"I need to think about it" objections go unhandled in most coaching funnels. AI follow-up with objection-specific sequences converts 40% of stalled leads that would otherwise go cold.', measured: '40%', label: 'of stalled leads recoverable' },
];

const timeline = [
	{ t: 'THIS LAUNCH', body: 'Unqualified discovery calls drain your energy and fill your calendar with people who never buy. Meanwhile, the qualified leads who said "I’ll think about it" book with someone who followed up.' },
	{ t: 'NEXT 12 MONTHS', body: 'Without a systematic follow-up sequence, every launch resets. You’re starting from zero acquisition every 8–12 weeks instead of building a compounding enrolled client base.' },
	{ t: 'YEAR 3+', body: 'Coaches with AI-managed funnels, follow-up, and qualifying have predictable enrollment — not feast-or-famine launches. The gap between you and them compounds every launch.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Only talk to people who are ready to buy.',
		body: 'Your AI voice agent pre-qualifies every discovery call applicant before they reach your calendar — screening for budget, urgency, and program fit so every call is a genuine sales conversation.',
		points: [
			'AI pre-qualifies all discovery call applicants — budget, urgency, and fit screened first',
			'Unqualified leads routed to nurture sequences instead of your calendar',
			'Missed calls and voicemails followed up automatically — no lead left without a touchpoint',
			'Past clients reactivated with upgrade program outreach automatically',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A funnel that converts traffic to discovery calls automatically.',
		body: 'Your current website is a brochure. We build a conversion machine — with AI-qualified booking pages, masterclass registration flows, and social proof architecture that turns traffic into booked calls around the clock.',
		points: [
			'High-converting VSL and application pages built to filter qualified buyers',
			'AI chat qualifies website visitors before they reach your booking page',
			'Masterclass registration pages with automated replay and follow-up sequences',
			'Testimonial and case study pages built for maximum social proof conversion',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Follow up every lead until they say yes or no.',
		body: 'New inquiries, masterclass no-shows, and stalled "I need to think about it" leads all get automated multi-channel follow-up — 7+ touchpoints across voice, SMS, and email without you lifting a finger.',
		points: [
			'New lead inquiries followed up within 10 seconds via voice, SMS, and email',
			'Masterclass no-shows receive an automated replay + follow-up sequence',
			'"I need to think about it" leads enter AI objection-handling sequences',
			'Multi-channel follow-up continues for 7+ touchpoints without you lifting a finger',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Run your entire coaching business from one AI interface.',
		body: 'A private AI that knows your business — client onboarding, program curriculum, content scheduling, and revenue tracking. Accessible on demand, answering your admin questions instantly so you can focus on coaching.',
		points: [
			'Client onboarding documents, contracts, and resources sent automatically',
			'Program curriculum questions answered by AI so you’re not the bottleneck',
			'Content scheduling, social drafts, and email sequences generated on request',
			'Revenue tracking, enrollment stats, and launch performance summaries delivered daily',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A funnel architecture that actually converts your audience.',
		body: 'Before we build, we audit. Our consultation identifies every gap from lead magnet to enrollment — then architects the exact AI system stack for your program price, audience, and launch model.',
		points: [
			'Audit of your current funnel from lead magnet to enrollment',
			'Conversion gap analysis — where qualified buyers drop out of your pipeline',
			'Custom AI stack designed for your program price, audience, and launch model',
			'Offer positioning review to ensure your messaging attracts buyers, not browsers',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'Build a coaching business that runs on systems, not your time.',
		body: 'The systems are only as powerful as the person running them. We train you to use AI for content creation, program delivery, client communication, and admin — so your time stays in delivery, not operations.',
		points: [
			'AI training for coaches on content creation, email writing, and funnel building',
			'Custom AI workflows for program delivery, client communication, and admin',
			'Frameworks for delegating discovery call qualification to AI permanently',
			'Business systems curriculum so your time is always in the highest-leverage activity',
		],
	},
];

const asFound = [
	'Discovery calendar filled with unqualified leads',
	'3–4 hours daily on manual DM and email follow-up',
	'Launch momentum dies after 1–2 follow-up attempts',
	'Masterclass no-shows never re-engaged',
	'"I’ll think about it" leads go cold permanently',
	'Feast-or-famine launch cycle with no compounding revenue',
];

const asCommissioned = [
	'AI pre-qualifies all discovery applicants — only buyers get your time',
	'Automated 7+ touchpoint follow-up across every channel',
	'Launch follow-up runs for 30 days without your involvement',
	'Masterclass no-shows get an automated replay and enrollment sequence',
	'Objection-handling sequences convert 40% of stalled leads',
	'Compounding enrolled client base grows between launches',
];

// The follow-up ledger — a true sequence, so it earns its numbers.
const touchpoints = [
	{ n: '1', ch: 'VOICE', note: 'Called within 10 seconds of the enquiry' },
	{ n: '2', ch: 'SMS', note: 'Booking link, same minute' },
	{ n: '3', ch: 'EMAIL', note: 'Case study matched to their goal' },
	{ n: '4', ch: 'VOICE', note: 'Second call at their stated best time' },
	{ n: '5', ch: 'SMS', note: 'Objection-specific answer sequence' },
	{ n: '6', ch: 'EMAIL', note: 'Replay + enrollment deadline' },
	{ n: '7', ch: 'VOICE', note: 'Final call — a clear yes or no' },
];
---

<Layout
	title="AI Systems for Coaches | System Pros AI"
	description="Stop wasting discovery calls on tire-kickers. Full-stack AI for coaches: Voice AI, Lead Gen, Lead Reactor, Private Assistant, Consultation & Training."
>
	<ServiceSchema
		name="AI Lead Qualification & Enrollment Automation for Coaches"
		description="Full-stack AI deployment for coaching businesses covering discovery call qualification, lead nurture, funnel automation, and business operations."
		serviceType="Coaching Business AI Automation"
	/>
	<Breadcrumbs currentTitle="Coaching" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO — with qualification funnel schematic -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — COACHING</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> QUALIFICATION FILTER ACTIVE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
						Your calendar is for clients. Not <span class="text-green">tire-kickers.</span>
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[35rem]" data-reveal style="--reveal-delay: 120ms;">
						You built a coaching business to transform people — not to spend four hours a day
						qualifying leads, chasing no-shows, and following up with people who say
						"I need to think about it". We install six AI systems so your calendar fills with
						qualified buyers while you focus on delivery.
					</p>
					<div class="mt-8" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
					</div>
				</div>

				<!-- Qualification funnel schematic -->
				<div class="lg:col-span-5" aria-hidden="true">
					<svg viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
						<g stroke="var(--color-green)" stroke-width="1.5">
							<path d="M 220 76 V 128" data-draw-path />
							<path d="M 220 208 V 252 H 110 V 292" data-draw-path style="--reveal-delay: 300ms;" />
							<path d="M 220 208 V 252 H 330 V 292" data-draw-path style="--reveal-delay: 450ms;" />
						</g>
						<g data-reveal>
							<rect x="90" y="24" width="260" height="52" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="220" y="46" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11.5" fill="var(--color-ink)">ENQUIRIES &times;100</text>
							<text x="220" y="64" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)">ADS · DMS · MASTERCLASS · REFERRALS</text>
						</g>
						<g data-reveal style="--reveal-delay: 150ms;">
							<rect x="120" y="128" width="200" height="80" fill="var(--color-green)" />
							<text x="220" y="162" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11.5" fill="var(--color-paper-lit)">AI QUALIFICATION</text>
							<text x="220" y="182" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">BUDGET · URGENCY · FIT</text>
						</g>
						<g data-reveal style="--reveal-delay: 500ms;">
							<rect x="30" y="292" width="160" height="56" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="110" y="316" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-ink)">NURTURE SEQUENCE</text>
							<text x="110" y="334" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)">NOT READY YET</text>
						</g>
						<g data-reveal style="--reveal-delay: 650ms;">
							<rect x="250" y="292" width="160" height="56" stroke="var(--color-copper)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="330" y="316" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-copper)">YOUR CALENDAR</text>
							<text x="330" y="334" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-copper)">BUYERS ONLY</text>
						</g>
						<text x="220" y="374" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)" data-reveal style="--reveal-delay: 750ms;">DISCOVERY CALLS BECOME SALES CONVERSATIONS</text>
					</svg>
				</div>
			</div>

			<!-- Figures strip -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-3">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">QUALIFIED LEADS LOST</dt>
					<dd class="mt-1 text-2xl font-bold text-green">0</dd>
					<dd class="text-[13px] text-muted">every lead followed to yes or no</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">FOLLOW-UP TOUCHPOINTS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="7" data-count-suffix="+">7+</span></dd>
					<dd class="text-[13px] text-muted">voice, SMS and email, automated</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">ENROLLMENT CONVERSION</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="2.4" data-count-suffix="&times;">2.4&times;</span></dd>
					<dd class="text-[13px] text-muted">against manual funnels</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- 2. THE FOLLOW-UP LEDGER — distinctive device (true sequence) -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					The sale closes on touch three to seven.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SEQ. CO-01 — FOLLOW-UP LEDGER, ONE LEAD</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{touchpoints.map((t, i) => (
				<div class="spec-row grid grid-cols-[2.5rem_5.5rem_1fr] gap-x-6 items-center py-4 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
					<span class={`face-data ${i >= 2 ? 'text-copper' : 'text-muted'}`}>{t.n}</span>
					<span class="face-data text-green">{t.ch}</span>
					<p class="text-[15px] text-ink">{t.note}</p>
				</div>
			))}
			<p class="face-data text-muted mt-6" data-reveal>MOST COACHES STOP AT TOUCH 2 · 60–80% OF SALES SIT BEYOND IT · THE SYSTEM NEVER STOPS EARLY</p>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					The leak audit.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SIX FINDINGS · LEAD MAGNET TO ENROLLMENT</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}

			<!-- Cost of inaction -->
			<div class="grid lg:grid-cols-12 gap-12 mt-16">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
					<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
						$<span data-count="312" data-count-suffix=",000+">312,000+</span>
					</div>
					<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
						Based on 12 unqualified or missed leads per week &times; $5,000 average program &times; a 52% conversion rate improvement.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{timeline.map((t, i) => (
						<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
							<span class="face-data text-copper pt-0.5">{t.t}</span>
							<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for coaching.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your coaching business.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your business — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEM PROS AI DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — COACHING DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[24ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your next client already said yes. They just need the right follow-up.
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll map exactly where your funnel is losing qualified
				buyers and design the AI systems that fill your calendar with people ready to enroll.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
