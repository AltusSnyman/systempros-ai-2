---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'D-01', finding: 'Monday morning phone storm', detail: 'Weekend voicemails stack up. Monday morning is a war between new patient calls, appointment confirmations, and an overwhelmed front desk that can only talk to one person at a time.', measured: 'MON 8AM', label: 'the weekly bottleneck' },
	{ ref: 'D-02', finding: 'The one-person bottleneck', detail: 'One staff member handling phones AND check-ins means patients wait, calls go unanswered, and your front desk person burns out every week.', measured: '1', label: 'person, two full-time jobs' },
	{ ref: 'D-03', finding: 'The insurance time sink', detail: '"Do you take Delta Dental?" takes 8 minutes of your most expensive staff member’s time. Multiplied by 20 calls a day, that’s 2.5 hours of productivity lost to a question AI can answer in 10 seconds.', measured: '2.5 hrs', label: 'lost to insurance FAQs daily' },
	{ ref: 'D-04', finding: 'New patients call after hours', detail: '47% of new dental patients call after hours, when they’re finally in enough discomfort to act. Your office is closed. The competitor’s AI answers immediately.', measured: '47%', label: 'of new patients call after hours' },
	{ ref: 'D-05', finding: 'Chair capacity lost to gaps', detail: 'Most practices lose 15% of monthly chair capacity to recall gaps and unconfirmed appointments. That’s fixed overhead generating zero revenue.', measured: '15%', label: 'of chair capacity idle' },
	{ ref: 'D-06', finding: 'The empty chair has a rate card', detail: 'An unoccupied dental chair costs roughly $350/hour in fixed overhead. A missed recall isn’t just lost revenue — it’s an active cost you’re paying anyway.', measured: '$350/hr', label: 'cost of an empty chair' },
];

const timeline = [
	{ t: 'THIS MONTH', body: 'Weekend pain patients who can’t reach you after hours book with the practice that answered. You lose the new patient and the lifetime value.' },
	{ t: 'NEXT 12 MONTHS', body: 'Recall gaps compound. A missed 6-month cleaning becomes a lost patient relationship. No recall system means 20–30% annual patient attrition.' },
	{ t: 'YEAR 3+', body: 'Practices with AI-managed recall and after-hours capture have 30% higher revenue per chair. You’re running the same overhead with fewer chairs producing.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Answer every patient call. Including Saturday at 8pm.',
		body: 'Your AI voice agent handles after-hours calls with dental-trained intelligence — qualifying emergencies, booking appointments directly into your practice management system, and triaging urgency around the clock.',
		points: [
			'Handles after-hours calls with dental-trained AI — no "leave a message"',
			'Qualifies emergencies vs. routine bookings vs. new patient inquiries',
			'Books directly into OpenDental or Dentrix — confirmed appointments, not callbacks',
			'Triages pain level and urgency to route after-hours emergencies appropriately',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A practice website that converts visitors into booked patients.',
		body: 'Your current site is a brochure. We build a patient acquisition machine — with after-hours booking, emergency landing pages, and AI-handled insurance FAQs that convert 24/7.',
		points: [
			'After-hours booking widget captures new patients when your office is closed',
			'"Emergency dental near me" landing pages rank and convert urgent searches',
			'Insurance FAQ handled automatically — "Do you take Delta?" answered in seconds',
			'New patient intake forms completed before the first appointment',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Follow up every new patient inquiry in under 10 seconds.',
		body: 'New patient form submissions die in minutes if no one responds. The Lead Reactor calls them back in under 10 seconds — then follows up via SMS, email and WhatsApp until they’re booked.',
		points: [
			'New patient form submissions called in under 10 seconds',
			'Multi-channel follow-up: voice, SMS, email — until they’re booked',
			'Recall reminders sent automatically at 6-month and 12-month intervals',
			'No-show follow-up rescheduling handled without staff involvement',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your practice knowledge. Instantly available to every staff member.',
		body: 'A private AI that knows your practice — insurance plans, patient histories, treatment protocols, lab schedules. Accessible instantly, so your team stops interrupting the dentist for every question.',
		points: [
			'Insurance verification questions answered instantly for front desk staff',
			'Patient notes and treatment histories pulled up during calls',
			'Lab and supplier queries handled without interrupting the dentist',
			'Daily schedule summaries and chair utilization reports delivered automatically',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A practice growth blueprint from dentistry-focused AI strategists.',
		body: 'Before we build, we audit. Our consultation identifies every gap in your patient acquisition and recall workflows — then architects the exact AI deployment for your practice size and patient volume.',
		points: [
			'Audit of your current patient acquisition and recall workflows',
			'Chair utilization analysis — where revenue is being left on the table',
			'Custom AI deployment roadmap for your practice size and patient volume',
			'Integration design for OpenDental, Dentrix, or your existing practice management system',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'Upskill your entire dental team on AI tools that save hours daily.',
		body: 'The systems are only as good as the people running them. We train your front desk, hygienists, and office managers to work alongside AI — cutting the learning curve from months to days.',
		points: [
			'Hands-on training for front desk, hygienists, and office managers',
			'Custom AI workflows for scheduling, billing queries, and patient communication',
			'SOPs that get your team using AI within days — not months',
			'Continuing education format your staff can revisit as tools update',
		],
	},
];

const asFound = [
	'After-hours patients hit voicemail and book elsewhere',
	'Front desk overwhelmed handling phones + check-ins',
	'Insurance questions burn 2+ hours of staff time daily',
	'Recall gaps create empty chairs with full overhead',
	'No automated new patient follow-up system',
	'Team manually handling tasks AI could process in seconds',
];

const asCommissioned = [
	'Every after-hours call answered and appointment booked',
	'AI handles phone volume so staff focuses on the chair',
	'Insurance FAQs answered instantly by AI 24/7',
	'Automated recall system fills chairs before gaps form',
	'New patient inquiries followed up in under 10 seconds',
	'Full team using AI tools — 3× admin productivity',
];

// Chair-day strip: hour blocks 8am–6pm. 'lost' = capacity leaking today.
const chairDay = [
	{ h: '8', lost: false }, { h: '9', lost: false }, { h: '10', lost: true },
	{ h: '11', lost: false }, { h: '12', lost: true }, { h: '1', lost: false },
	{ h: '2', lost: false }, { h: '3', lost: true }, { h: '4', lost: false }, { h: '5', lost: true },
];
---

<Layout
	title="AI Systems for Dental Practices | Patient Booking & Recall Automation"
	description="Fill every chair. Full-stack AI for dental practices: Voice AI, Lead Gen, Lead Reactor, Private Assistant, Consultation & Training — engineered for dentistry."
>
	<ServiceSchema
		name="AI Patient Booking & Recall Automation for Dental Practices"
		description="Full-stack AI deployment for dental practices covering patient call handling, appointment booking, recall automation, and practice operations."
		serviceType="Dental Practice AI Automation"
	/>
	<Breadcrumbs currentTitle="Dental" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO — centered, with chair ledger below -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — DENTAL</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> AFTER-HOURS COVERAGE ACTIVE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="py-12 lg:py-16 max-w-[52rem]">
				<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
					Fill the chair. Even when the front desk <span class="text-green">is closed.</span>
				</h1>
				<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
					Your front desk handles phones, check-ins, billing, and insurance questions simultaneously.
					Something always slips. We install six AI systems so every patient is captured, every chair
					is filled, and your practice runs without the chaos.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
					<a href="/contact" class="btn-primary">Book a Free Consultation</a>
					<AudioDemoModal videoSrc="/assets/industry-videos/dental.mp4" industryName="Dental" client:visible />
				</div>
			</div>

			<!-- THE CHAIR LEDGER — distinctive device -->
			<div class="rule-ticked" data-draw-rule></div>
			<div class="grid lg:grid-cols-12 gap-10 py-10 items-center">
				<div class="lg:col-span-4">
					<p class="face-data text-muted" data-reveal>CHAIR NO. 2 — TODAY, AS FOUND</p>
					<div class="mt-3 face-display font-extrabold text-[clamp(2.6rem,5vw,4rem)] leading-none text-ink" data-reveal style="--reveal-delay: 80ms;">
						$<span data-count="350">350</span><span class="text-[0.45em] text-muted font-bold">/hr</span>
					</div>
					<p class="text-[14px] text-muted mt-3 max-w-[20rem]" data-reveal style="--reveal-delay: 160ms;">
						Fixed overhead per empty chair-hour. Each marked block below is a gap
						your recall system never filled — billed to you either way.
					</p>
				</div>
				<div class="lg:col-span-8" data-reveal style="--reveal-delay: 200ms;">
					<div class="grid grid-cols-10 gap-1.5" role="img" aria-label="One day of chair time from 8am to 5pm: four of ten hours sit empty">
						{chairDay.map((b, i) => (
							<div>
								<div
									class={`h-16 border ${b.lost ? 'border-copper bg-paper' : 'border-green bg-green'}`}
									data-reveal
									style={`--reveal-delay: ${240 + i * 45}ms;`}
								></div>
								<div class="face-data !text-[10px] text-muted text-center mt-1.5">{b.h}</div>
							</div>
						))}
					</div>
					<div class="flex flex-wrap gap-x-8 gap-y-2 mt-4">
						<span class="face-data text-muted flex items-center gap-2"><span class="inline-block w-3 h-3 bg-green"></span> CHAIR PRODUCING</span>
						<span class="face-data text-muted flex items-center gap-2"><span class="inline-block w-3 h-3 border border-copper"></span> EMPTY — $350/HR OVERHEAD RUNNING</span>
					</div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- 2. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					Where a practice leaks patients.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SIX FINDINGS · FRONT DESK TO RECALL</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- 3. VIDEO + COST OF INACTION -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5 grid lg:grid-cols-2 gap-14 items-center">
			<div data-reveal>
				<MediaFrame fig="FIG. 01" caption="DENTAL — FRONT-DESK OVERFLOW, LIVE CALL">
					<video
						src="/assets/industry-videos/dental.mp4"
						poster="/assets/industry-videos/dental.webp"
						muted
						loop
						playsinline
						preload="none"
						class="w-full aspect-[4/5] object-cover"
						data-hover-play
					></video>
				</MediaFrame>
			</div>
			<div>
				<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
				<div class="mt-4 face-display font-extrabold text-[clamp(2.8rem,6vw,4.6rem)] leading-none text-ink" data-reveal style="--reveal-delay: 80ms;">
					$<span data-count="218" data-count-suffix=",400+">218,400+</span>
				</div>
				<p class="text-[14px] text-muted mt-4 max-w-[26rem]" data-reveal style="--reveal-delay: 140ms;">
					Based on 12 missed new patient calls per week and the empty chair-hours a working recall system recovers.
				</p>
				<div class="rule-ticked mt-8" data-draw-rule></div>
				{timeline.map((t, i) => (
					<div class="spec-row grid sm:grid-cols-[10rem_1fr] gap-x-5 gap-y-1 py-5 px-1" data-reveal style={`--reveal-delay: ${200 + i * 90}ms;`}>
						<span class="face-data text-copper pt-0.5">{t.t}</span>
						<p class="text-[14.5px] text-ink leading-relaxed">{t.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for dentistry.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your practice.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your practice — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEM PROS AI DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — DENTAL DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Every empty chair is a paid invoice you didn't send.
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll identify exactly where your practice is losing
				patients and map the AI systems that will fill your chairs — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
