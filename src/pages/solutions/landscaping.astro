---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'LS-01', finding: 'The zero-turn paradox', detail: 'You can’t hear the phone over a backpack blower at 100dB. While the phone rings, that customer books the landscaper who answered.', measured: '100 dB', label: 'louder than your ringtone' },
	{ ref: 'LS-02', finding: 'Spring rush overwhelm', detail: 'Spring hits every operator at once. One person can’t manage phones, crew logistics, and 40 estimate requests simultaneously.', measured: '40', label: 'estimate requests at once' },
	{ ref: 'LS-03', finding: 'The same-day quote window', detail: 'Quotes not sent same day have a 60% drop-off rate. With jobs running until 6pm, there’s no time to quote while the lead is still hot.', measured: '60%', label: 'drop-off on next-day quotes' },
	{ ref: 'LS-04', finding: 'First responder takes the job', detail: '70% of landscaping leads book whoever responded first. If you follow up tomorrow, they’ve already signed with someone else.', measured: '70%', label: 'book the first responder' },
	{ ref: 'LS-05', finding: 'One lost contract, years of value', detail: 'A recurring maintenance contract lost from a single missed call costs 3+ years of compounding revenue, not just one job.', measured: '3 yrs', label: 'of LTV per missed contract' },
	{ ref: 'LS-06', finding: 'Peak search is your busiest commute', detail: 'Google searches for landscaping peak Monday morning while you’re already on the road heading to your first job.', measured: 'MON AM', label: 'peak demand, zero coverage' },
];

const timeline = [
	{ t: 'THIS SEASON', body: 'Competitors capture spring rush leads while your team is running full crews with no capacity for phone response.' },
	{ t: 'NEXT 12 MONTHS', body: 'Without a retention system, recurring clients don’t renew automatically. You reset to zero acquisition every spring.' },
	{ t: 'YEAR 3+', body: 'Landscapers who built AI-managed recurring revenue portfolios have predictable cashflow — you’re still hunting new clients every spring.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Answer every estimate call. Even at full throttle.',
		body: 'Your AI voice agent handles every call while your crew is running at 100dB — qualifying jobs, booking estimate appointments, and reactivating past clients around the clock.',
		points: [
			'Handles calls while your crew runs at 100dB — never misses a spring inquiry',
			'Qualifies the job: one-time cleanup vs. recurring maintenance vs. hardscape quote',
			'Books estimate appointments into your calendar automatically',
			'Reactivates past clients with spring cleanup and fall leaf outreach',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A website that books estimates while you mow.',
		body: 'Your current site is a brochure. We build a lead machine — with AI chat, instant quote capture, and spring-season landing pages that turn Google traffic into booked estimates while you’re in the field.',
		points: [
			'Spring-season landing pages built to rank for local landscaping searches',
			'Instant quote form captures contact + job type while you’re in the field',
			'AI chat widget answers "do you do cleanups?" questions after hours',
			'Google review requests sent automatically after job completion',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Respond to Facebook ad leads before the mower cools down.',
		body: 'Spring ad leads die in minutes. The Lead Reactor calls your Facebook and Google ad leads in under 10 seconds — before four other landscapers even open the notification.',
		points: [
			'Facebook ad leads called in under 10 seconds — before other landscapers respond',
			'Spring promotion leads followed up via voice, SMS, and WhatsApp simultaneously',
			'Automated sequence continues follow-up until the prospect books or opts out',
			'Filters budget shoppers from serious recurring-contract inquiries',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your entire operation. One WhatsApp conversation.',
		body: 'A private AI that knows your business — crew schedules, client properties, supplier contacts, job notes. Accessible via WhatsApp, answering your team’s questions instantly so you can focus on the job.',
		points: [
			'Field crew gets daily schedules and job updates via WhatsApp',
			'Client notes and property details pulled instantly for any job',
			'Supplier and equipment queries answered without calling you',
			'End-of-day job completion summaries sent to the owner automatically',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A growth roadmap built for your landscaping business.',
		body: 'Before we build, we audit. Our consultation identifies every gap in your current lead and operations workflow — then designs the exact system stack for your crew size, service mix, and growth goals.',
		points: [
			'Audit of your current call and estimate conversion flow',
			'Seasonal demand analysis — where your revenue leaks each off-season',
			'Custom AI stack designed for your crew size and service mix',
			'Integration plan for Jobber, LMN, or your existing scheduling tools',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'Train your crew to work faster with AI tools.',
		body: 'The systems are only as good as the people running them. We train your estimators, crew leads, and office staff to work alongside AI — cutting the learning curve from months to days.',
		points: [
			'Hands-on AI training for estimators, crew leads, and office staff',
			'Custom workflows for quote generation, client communication, and job tracking',
			'SOPs built around AI so your team actually adopts the tools',
			'Ongoing curriculum updates as better AI tools are released',
		],
	},
];

const asFound = [
	'Missed calls during mowing season — jobs go to competitors',
	'Quotes sent next day after the lead goes cold',
	'Generic website with no booking capability',
	'Field crew calling you for every update mid-job',
	'No retention system — restart acquisition every spring',
	'Manual quoting burns 2 hours every evening',
];

const asCommissioned = [
	'Every spring call answered while the crew works',
	'Same-hour quote generation from any device',
	'Lead-gen site books estimates 24/7 without staff',
	'Crew gets all updates via WhatsApp AI',
	'Automated recurring contract renewal outreach',
	'AI generates quotes in minutes — not hours',
];
---

<Layout
	title="AI Systems for Landscaping Companies | System Pros AI"
	description="Answer every call while your crew works. Full-stack AI for landscapers: Voice AI, Lead Gen, Lead Reactor, Private Assistant, Consultation & Training."
>
	<ServiceSchema
		name="AI Lead Capture & Operations for Landscaping"
		description="Full-stack AI deployment for landscaping companies covering voice response, lead generation, automated follow-up, and field operations."
		serviceType="Landscaping AI Automation"
	/>
	<Breadcrumbs currentTitle="Landscaping" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — LANDSCAPING</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> SPRING RUSH COVERED</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-5 order-2 lg:order-1" data-reveal style="--reveal-delay: 180ms;">
					<MediaFrame fig="FIG. 01" caption="LANDSCAPING — QUOTE-TO-BOOKING, LIVE CALL">
						<video
							src="/assets/industry-videos/landscaping.mp4"
							poster="/assets/industry-videos/landscaping.webp"
							muted
							loop
							playsinline
							preload="none"
							class="w-full aspect-[4/5] object-cover"
							data-hover-play
						></video>
					</MediaFrame>
				</div>
				<div class="lg:col-span-7 order-1 lg:order-2">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
						Book estimates while your crew runs <span class="text-green">the field.</span>
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
						You can't hear the phone over a zero-turn at full throttle. We install six AI systems
						so every spring lead is captured, every estimate is sent same-day, and your busiest
						season becomes your most profitable.
					</p>
					<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<AudioDemoModal videoSrc="/assets/industry-videos/landscaping.mp4" industryName="Landscaping" client:visible />
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. SEASON CURVE — distinctive device -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					Demand doesn't wait for a callback.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>DWG. LS-01 — SEASONAL DEMAND PROFILE, 12 MONTHS</p>
			</div>

			<svg viewBox="0 0 960 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label="Seasonal demand curve: enquiries surge from September through December, exactly when crews are fully deployed and calls go unanswered">
				<!-- baseline + months -->
				<g stroke="var(--color-line)" stroke-width="1">
					<path d="M 40 240 H 940" />
					<path d="M 40 235 V 245" /><path d="M 940 235 V 245" />
				</g>
				<g font-family="Fragment Mono, monospace" font-size="10" fill="var(--color-muted)">
					<text x="40" y="264">JUL</text><text x="190" y="264">SEP</text><text x="340" y="264">NOV</text>
					<text x="490" y="264">JAN</text><text x="640" y="264">MAR</text><text x="790" y="264">MAY</text><text x="916" y="264">JUN</text>
				</g>
				<!-- demand curve: spring surge -->
				<path
					d="M 40 220 C 120 210, 160 140, 230 90 C 290 48, 350 40, 420 66 C 500 96, 560 170, 650 196 C 740 220, 850 224, 940 226"
					stroke="var(--color-green)" stroke-width="2.5" data-draw-path
				/>
				<!-- crew capacity flatline -->
				<path d="M 40 150 H 940" stroke="var(--color-ink)" stroke-width="1.25" stroke-dasharray="6 5" data-draw-path style="--reveal-delay: 500ms;" />
				<text x="46" y="142" font-family="Fragment Mono, monospace" font-size="10" fill="var(--color-ink)" data-reveal style="--reveal-delay: 600ms;">WHAT ONE PERSON CAN ANSWER</text>
				<!-- the leak zone marker -->
				<g data-reveal style="--reveal-delay: 750ms;">
					<rect x="210" y="34" width="260" height="26" stroke="var(--color-copper)" stroke-width="1.25" fill="var(--color-paper)" />
					<text x="340" y="51" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10" fill="var(--color-copper)">SPRING RUSH — 22 MISSED CALLS/WK</text>
					<path d="M 340 60 V 84" stroke="var(--color-copper)" stroke-width="1.25" />
				</g>
				<text x="490" y="292" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9.5" fill="var(--color-muted)" data-reveal style="--reveal-delay: 850ms;">EVERYTHING ABOVE THE DASHED LINE CURRENTLY GOES TO WHOEVER ANSWERS · AI CARRIES THE WHOLE CURVE</text>
			</svg>

			<dl class="grid grid-cols-2 md:grid-cols-4 mt-10 border-t border-line">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">MISSED SPRING CALLS</dt>
					<dd class="mt-1 text-2xl font-bold text-green">0</dd>
					<dd class="text-[13px] text-muted">once the system is live</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">BOOKING WINDOW</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">24/7</dd>
					<dd class="text-[13px] text-muted">weekends and evenings included</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">ESTIMATES BOOKED</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="2.8" data-count-suffix="&times;">2.8&times;</span></dd>
					<dd class="text-[13px] text-muted">against manual intake</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">QUOTE TURNAROUND</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">Same hour</dd>
					<dd class="text-[13px] text-muted">while the lead is still hot</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					The leak audit.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SIX FINDINGS · MEASURED ON REAL LANDSCAPING OPERATIONS</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}

			<!-- Cost of inaction -->
			<div class="grid lg:grid-cols-12 gap-12 mt-16">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
					<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
						$<span data-count="92" data-count-suffix=",000+">92,000+</span>
					</div>
					<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
						Based on 10 missed calls per week &times; $4,200 average annual contract value.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{timeline.map((t, i) => (
						<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
							<span class="face-data text-copper pt-0.5">{t.t}</span>
							<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for landscaping.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your operation.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your business — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEM PROS AI DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — LANDSCAPING DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				This spring could be your best season yet.
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll map exactly which of the six systems will convert
				the most spring leads for your landscaping operation — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
