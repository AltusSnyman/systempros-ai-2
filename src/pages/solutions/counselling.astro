---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import CounselingChatbot from '../../components/solutions/CounselingChatbot';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'CN-01', finding: 'The after-hours courage gap', detail: '70% of people in emotional distress reach out after business hours — when the resolve is highest and the courage is fresh. Your voicemail sends them a message that says their moment doesn’t matter.', measured: '70%', label: 'reach out after hours' },
	{ ref: 'CN-02', finding: 'Crisis callers don’t call back', detail: '70% of people who reach a voicemail in a moment of emotional distress don’t call again. That’s not a missed booking — that’s a person who needed help and didn’t get it, and a practice that can’t measure what it’s losing.', measured: '70%', label: 'never try a second time' },
	{ ref: 'CN-03', finding: 'The wrong therapist match', detail: 'A mismatched therapist in session one has an 80% likelihood of the client not returning. Without intake triage, you’re assigning on availability — not clinical fit — and losing clients before they’ve started.', measured: '80%', label: 'attrition on a poor match' },
	{ ref: 'CN-04', finding: 'Inconsistent HIPAA intake', detail: 'Manual intake processes introduce compliance risk. Every staff member handles sensitive disclosures differently. One inconsistency is a liability — in a practice that handles mental health data, that risk is unacceptable.', measured: '1', label: 'inconsistency is one too many' },
	{ ref: 'CN-05', finding: 'Billing errors from manual intake', detail: 'Practices running manual intake lose 12–18% of revenue to billing errors, insurance verification gaps, and coding inconsistencies. AI-standardised intake eliminates this entirely.', measured: '12–18%', label: 'of revenue lost to errors' },
];

const timeline = [
	{ t: 'TONIGHT', body: 'Someone reaches out at 9pm in their most vulnerable moment. Your voicemail tells them to call back tomorrow. 70% of them won’t. That person doesn’t get help, and your practice doesn’t grow.' },
	{ t: 'NEXT 12 MONTHS', body: 'Without a correct-match intake system, client attrition stays high. You’re spending marketing budget acquiring clients who leave after two sessions because the fit wasn’t right.' },
	{ t: 'YEAR 3+', body: 'Practices with AI-managed after-hours intake and therapist matching have lower attrition, higher lifetime client value, and better clinical outcomes. It’s not just a business advantage — it’s a better service.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Compassionate after-hours intake. Every time someone calls.',
		body: 'Your AI voice agent answers after-hours calls with calm, trained compassion — conducting intake triage, routing to the right therapist, and booking appointments overnight so no one falls through the cracks.',
		points: [
			'Answers after-hours calls with a calm, trained AI voice — not a voicemail prompt',
			'Conducts intake triage: presenting concern, urgency level, and therapy modality preference',
			'Routes to on-call therapist for crisis escalation — compliant with duty-of-care protocols',
			'Books initial appointments into your scheduling system overnight',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A practice website that works when you don’t.',
		body: 'We build HIPAA-compliant intake flows, modality-specific landing pages, and after-hours booking widgets that capture clients at the moment they’re ready to commit.',
		points: [
			'After-hours booking widget captures new clients when they’re ready to commit',
			'Landing pages for specific modalities: anxiety, trauma, couples, LGBTQ+ affirming',
			'AI chat handles "do you offer sliding scale?" and intake FAQs without staff',
			'HIPAA-compliant form collection and data handling built into the site architecture',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Follow up every referral before the moment of motivation fades.',
		body: 'Psychology Today, Zocdoc, and direct referrals followed up in under 10 seconds — warm, professional, and compliant. No-shows rescheduled automatically. Lapsed clients reached with care-continuation outreach.',
		points: [
			'Psychology Today, Zocdoc, and direct referrals followed up in under 10 seconds',
			'Multi-channel outreach: voice, SMS, and email — warm, professional, and compliant',
			'Client no-shows automatically offered reschedule options without admin involvement',
			'Lapsed clients receive care-continuation outreach to reduce dropout',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your administrative burden. Handled.',
		body: 'A private AI that handles insurance verification, session documentation support, billing queries, and scheduling coordination — so your therapists spend their time with clients, not paperwork.',
		points: [
			'Insurance verification and benefits lookups handled before intake appointments',
			'Session notes templates and documentation support for practitioners',
			'Billing queries and insurance coding questions answered instantly for admin staff',
			'Scheduling coordination across multiple therapists managed via AI',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A growth strategy that doesn’t compromise clinical values.',
		body: 'Before we build, we audit. Our consultation maps your intake workflow, therapist match process, and attrition points — then designs the AI stack that fills your books without compromising care quality.',
		points: [
			'Audit of your intake workflow, therapist match process, and attrition points',
			'After-hours coverage gap analysis and AI solution architecture',
			'Custom deployment roadmap for your practice size and therapeutic specialities',
			'Integration design for SimplePractice, Theranest, or Jane',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'AI tools that support the therapeutic relationship — never replace it.',
		body: 'We train therapists, admin staff, and practice managers to use AI ethically and efficiently — reducing documentation burden and administrative overhead so more time goes to clients.',
		points: [
			'AI training for therapists, admin staff, and practice managers',
			'Clinical documentation and note-taking efficiency tools',
			'HIPAA compliance training integrated with AI tool usage',
			'Workflows that reduce administrative burden so therapists can focus on clients',
		],
	},
];

const asFound = [
	'After-hours calls hit voicemail — 70% of callers never try again',
	'Therapist assignments based on availability, not clinical fit',
	'Manual HIPAA intake creates compliance risk and inconsistency',
	'No-shows managed manually — admin chases reschedules by hand',
	'Insurance verification done ad hoc — 12–18% billing error rate',
	'High client attrition from poor match and follow-through gaps',
];

const asCommissioned = [
	'Every after-hours call answered with compassion and routed correctly',
	'Intake triage matches clients to the right therapist before session one',
	'HIPAA-compliant AI intake — standardised, documented, and auditable',
	'Automated reschedule offers eliminate the manual no-show process',
	'Insurance verified before intake — billing errors eliminated',
	'Correct match + retention follow-up keeps clients engaged in care',
];

// The 9pm window — one call, handled properly.
const window9pm = [
	{ time: '9:04 PM', event: 'Call placed', note: 'A hard number to dial. They dialled it.' },
	{ time: '9:04 PM', event: 'Answered on the second ring', note: 'A calm, trained voice. Not a voicemail prompt.' },
	{ time: '9:09 PM', event: 'Intake triage completed', note: 'Presenting concern, urgency, modality preference — documented consistently.' },
	{ time: '9:11 PM', event: 'Matched on clinical fit', note: 'Speciality and modality — not whoever had a slot.' },
	{ time: '9:12 PM', event: 'First session booked, 10:15am Thursday', note: 'Confirmation sent. Intake forms on their way.' },
];
---

<Layout
	title="AI Systems for Counselling Practices | HIPAA-Compliant Intake & After-Hours"
	description="The moment of courage shouldn't hit voicemail. Full-stack AI for counsellors: HIPAA-compliant intake, after-hours response, and practice automation."
>
	<ServiceSchema
		name="AI Intake & After-Hours Response for Counselling Practices"
		description="Full-stack AI deployment for counselling practices covering HIPAA-compliant intake, after-hours response, therapist matching, and practice operations."
		serviceType="Counselling Practice AI Automation"
	/>
	<Breadcrumbs currentTitle="Counselling" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO — quieter register than the trade pages -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — COUNSELLING</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> AFTER-HOURS INTAKE ACTIVE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="py-14 lg:py-20 max-w-[50rem]">
				<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.06] text-ink" data-reveal>
					The moment of courage shouldn't hit <span class="text-green">voicemail.</span>
				</h1>
				<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[38rem]" data-reveal style="--reveal-delay: 120ms;">
					People reach out for help at 9pm on a Tuesday — not at 10am on a Wednesday when your
					front desk opens. That moment of resolve is fragile. We install six AI systems that
					answer with compassion, route to the right therapist, and protect every intake with
					HIPAA compliance — around the clock.
				</p>
				<div class="mt-9 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
					<a href="/contact" class="btn-primary">Book a Free Consultation</a>
					<AudioDemoModal videoSrc="/assets/industry-videos/counseling.mp4" industryName="Counselling" client:visible />
				</div>
			</div>
		</div>
	</section>

	<!-- 2. THE 9PM WINDOW — distinctive device -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12 items-start">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>CALL RECORD CN-2091 — TUESDAY EVENING</p>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink mt-3" data-reveal style="--reveal-delay: 80ms;">
						Eight minutes, handled properly.
					</h2>
					<p class="text-muted text-[16px] leading-relaxed mt-4 max-w-[26rem]" data-reveal style="--reveal-delay: 160ms;">
						This is what the system does at the hour your practice can't. Calm intake,
						consistent documentation, a correct clinical match — and an appointment
						confirmed before the resolve fades.
					</p>
					<div class="mt-8" data-reveal style="--reveal-delay: 220ms;">
						<MediaFrame fig="FIG. 01" caption="COUNSELLING — AFTER-HOURS INTAKE, LIVE CALL">
							<video
								src="/assets/industry-videos/counseling.mp4"
								poster="/assets/industry-videos/counseling.webp"
								muted
								loop
								playsinline
								preload="none"
								class="w-full aspect-video object-cover"
								data-hover-play
							></video>
						</MediaFrame>
					</div>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{window9pm.map((w, i) => (
						<div class="spec-row grid sm:grid-cols-[7rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 110}ms;`}>
							<span class="face-data text-copper pt-0.5">{w.time}</span>
							<div>
								<h3 class="font-bold text-ink text-[16px]">{w.event}</h3>
								<p class="text-[14px] text-muted mt-1">{w.note}</p>
							</div>
						</div>
					))}
					<p class="face-data text-muted mt-6" data-reveal style="--reveal-delay: 600ms;">EVERY DISCLOSURE HANDLED IDENTICALLY · STANDARDISED · AUDITABLE</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					What the audit finds in most practices.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>FIVE FINDINGS · INTAKE TO BILLING</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}

			<!-- Cost of inaction -->
			<div class="grid lg:grid-cols-12 gap-12 mt-16">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
					<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
						$<span data-count="134" data-count-suffix=",400+">134,400+</span>
					</div>
					<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
						Based on 8 after-hours missed calls per week &times; $4,800 average client lifetime value over 52 weeks.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{timeline.map((t, i) => (
						<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
							<span class="face-data text-copper pt-0.5">{t.t}</span>
							<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for counselling.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your practice.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your practice — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEMPROS DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — COUNSELLING DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Someone will reach out tonight. Will you be there?
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll map exactly how your practice can provide after-hours
				support, improve client match, and reduce attrition — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>

	<CounselingChatbot client:idle />
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
