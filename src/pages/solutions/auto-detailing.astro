---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import ROICalculator from '../../components/ROICalculator.jsx';
import AudioDemoModal from '../../components/AudioDemoModal';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';

const leakAudit = [
	{ ref: 'AD-01', finding: 'The wet hands problem', detail: 'You’re mid-cut-correction with compound on your hands and the phone rings. You can’t answer. That caller books the next shop on Google — and it’s probably a $1,500 ceramic coating job.', measured: '$1,500', label: 'per unanswered ceramic call' },
	{ ref: 'AD-02', finding: 'The quote-shopper time drain', detail: '"How much for a basic wash?" calls burn an hour of your day for a job that earns you $100. Without AI filtering, you spend your best working hours on your lowest-value enquiries.', measured: '1 hr/day', label: 'lost to quote shoppers' },
	{ ref: 'AD-03', finding: 'No-deposit no-shows', detail: 'Premium time slots filled without deposits mean no-shows that destroy your most profitable days. No automated deposit system means your calendar is a gamble.', measured: '0%', label: 'deposits collected today' },
	{ ref: 'AD-04', finding: 'Ceramic clients shop around', detail: 'Ceramic coating clients research 4+ detailers before booking. If you don’t answer or respond within minutes, they’ve booked someone else — along with the $1,500–$3,000 job.', measured: '4+', label: 'shops researched per client' },
	{ ref: 'AD-05', finding: 'No retention, no repeat revenue', detail: 'Most detailing shops have no automated way to bring clients back. First-time customers don’t return without a nudge. You’re starting from zero acquisition every single month.', measured: '0', label: 'automated return bookings' },
	{ ref: 'AD-06', finding: 'Upsell margin lost on every job', detail: 'Package upsells — paint protection film, ceramic, tint — happen in the conversation before booking, not at drop-off. If AI doesn’t pitch the upgrade, that margin disappears on every job.', measured: '40%', label: 'more ceramic bookings with AI pitch' },
];

const timeline = [
	{ t: 'THIS WEEK', body: 'Every missed ceramic coating inquiry is $1,500+ walking to a competitor who answered. Without a booking system, your premium slots fill with low-margin jobs or stay empty.' },
	{ t: 'NEXT 6 MONTHS', body: 'No retention system means you’re rebuilding your client base from scratch every quarter. There’s a revenue ceiling you can’t break without compounding repeat business.' },
	{ t: 'YEAR 2+', body: 'Detailers with AI-managed bookings, deposits, and retention have 3× the recurring revenue of same-size shops running manually. The gap compounds every month.' },
];

const systems = [
	{
		ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai',
		head: 'Answer every booking call. Even mid-detail.',
		body: 'Your AI voice agent handles all incoming calls while you’re buffing, polishing, or coating — qualifying job type, upselling premium packages, and booking with deposit collection so you never lose a ceramic job to voicemail.',
		points: [
			'Handles all incoming calls while you’re buffing, polishing, or coating',
			'Qualifies the job type and upsells to ceramic or paint protection film automatically',
			'Books with deposit collection — confirmed slots, zero no-shows',
			'Follows up completed jobs for reviews, referrals, and return booking',
		],
	},
	{
		ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites',
		head: 'A booking website that fills your calendar overnight.',
		body: 'Your current site is a brochure. We build a booking machine — with deposit capture, premium package upsells, and landing pages that rank for high-intent ceramic coating searches while you sleep.',
		points: [
			'Online booking with deposit capture — no back-and-forth to confirm',
			'"Best ceramic coating near me" landing pages rank and convert premium traffic',
			'Package upsell prompts built into the booking flow',
			'Automated review requests sent after every completed job',
		],
	},
	{
		ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor',
		head: 'Call every new lead before they book your competitor.',
		body: 'Web inquiry and Instagram DM leads go cold in minutes. The Lead Reactor calls them in under 10 seconds — pitching the right package, collecting the booking, and starting your upsell conversation before anyone else gets there.',
		points: [
			'Web inquiry and Instagram DM leads called in under 10 seconds',
			'Multi-channel follow-up via voice, SMS, and WhatsApp simultaneously',
			'Upsell pitch delivered on first contact — not just basic wash pricing',
			'Automated follow-up continues until the prospect books or opts out',
		],
	},
	{
		ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant',
		head: 'Your shop knowledge. One WhatsApp message away.',
		body: 'A private AI that knows your shop — client vehicles, past services, supplier pricing, and bay schedule. Accessible via WhatsApp, so your whole operation is always one message away, no matter what you’re working on.',
		points: [
			'Client vehicle history and past services pulled instantly for any booking',
			'Supplier pricing and product inventory queried without stopping work',
			'Job schedule and bay assignments managed via WhatsApp conversation',
			'End-of-day revenue summaries and upcoming slot reports delivered automatically',
		],
	},
	{
		ref: 'SP-05', name: 'Consultation', href: '/consulting',
		head: 'A revenue blueprint built for your detailing business.',
		body: 'Before we build, we audit. Our consultation identifies every gap in your booking, pricing, and retention workflow — then architects the exact AI system stack for your bay count and service menu.',
		points: [
			'Audit of your current booking, pricing, and retention workflow',
			'Upsell gap analysis — where ceramic and PPF revenue is being left uncaptured',
			'Custom AI stack designed for your bay count and service menu',
			'Pricing strategy review to position you as the premium shop in your market',
		],
	},
	{
		ref: 'SP-06', name: 'Training', href: '/training',
		head: 'Build an AI-powered detailing business, not just a shop.',
		body: 'The systems are only as good as the operator running them. We train you and your team on AI tools for quoting, client communication, and business systems — so you can hand off admin and focus entirely on the work.',
		points: [
			'Training on AI tools for quoting, client communication, and business systems',
			'Custom AI workflows for booking management and customer follow-up',
			'SOPs that let you hand off admin to AI so you focus entirely on the work',
			'Business growth curriculum built for solo operators scaling to multi-bay',
		],
	},
];

const asFound = [
	'Missed calls during detail sessions — premium jobs book elsewhere',
	'Quote-shoppers waste hours of your most productive time',
	'No-deposit no-shows ruin your premium slot calendar',
	'No retention system — zero repeat revenue automation',
	'Upsell margin lost because the pitch happens at drop-off, too late',
	'Manual booking and deposit chasing burns evenings',
];

const asCommissioned = [
	'Every call answered and booked while you’re working',
	'AI filters enquiries and qualifies job type before booking',
	'Deposit required at booking — no-shows eliminated',
	'Automated return booking outreach brings clients back',
	'Upsell pitch delivered on first AI contact — before booking is confirmed',
	'Full booking, deposit, and reminder system runs automatically',
];

// The booking ticket — every call is processed through this sequence.
const ticket = [
	{ step: '01', label: 'CALL ANSWERED', note: 'mid-detail, hands stay on the buffer' },
	{ step: '02', label: 'JOB QUALIFIED', note: 'wash vs. correction vs. ceramic' },
	{ step: '03', label: 'UPSELL PITCHED', note: 'ceramic / PPF / tint, on first contact' },
	{ step: '04', label: 'DEPOSIT COLLECTED', note: 'card on file before the slot is held' },
	{ step: '05', label: 'SLOT CONFIRMED', note: 'reminder sequence armed automatically' },
];
---

<Layout
	title="AI Systems for Auto Detailing Shops | System Pros AI"
	description="Keep your hands on the buffer. Full-stack AI for auto detailers: Voice AI, Lead Gen, Lead Reactor, Private Assistant, Consultation & Training."
>
	<ServiceSchema
		name="AI Booking Automation & Retention for Auto Detailing"
		description="Full-stack AI deployment for auto detailing shops covering voice response, online booking, lead follow-up, and shop operations."
		serviceType="Auto Detailing AI Automation"
	/>
	<Breadcrumbs currentTitle="Auto Detailing" parent={{ name: 'Industries', url: '/industries' }} />

	<!-- 1. HERO -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>SECTOR DOSSIER — AUTO DETAILING</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> BOOKINGS RUNNING WHILE YOU BUFF</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.8rem)] leading-[1.04] text-ink" data-reveal>
						Keep your hands on the buffer. <span class="text-green">AI fills the bay.</span>
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[35rem]" data-reveal style="--reveal-delay: 120ms;">
						You can't answer the phone mid-detail with compound on your hands. Every unanswered
						call during your busiest hours is a $1,500+ ceramic coating job that just booked with
						someone else. We install six AI systems that run your bookings, deposits, and
						retention so you stay focused on the work.
					</p>
					<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<AudioDemoModal videoSrc="/assets/industry-videos/detailing.mp4" industryName="Auto Detailing" client:visible />
					</div>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 180ms;">
					<MediaFrame fig="FIG. 01" caption="DETAILING — CERAMIC ENQUIRY, LIVE CALL">
						<video
							src="/assets/industry-videos/detailing.mp4"
							poster="/assets/industry-videos/detailing.webp"
							muted
							loop
							playsinline
							preload="none"
							class="w-full aspect-[4/5] object-cover"
							data-hover-play
						></video>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. THE BOOKING TICKET — distinctive device (true sequence) -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					Every call becomes a ticket.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>PROC. AD-01 — INBOUND CALL, PROCESS SEQUENCE</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-5">
				{ticket.map((t, i) => (
					<div class={`relative border-t-2 ${i === 4 ? 'border-copper' : 'border-green'} pt-5 pb-2 md:pr-8`} data-reveal style={`--reveal-delay: ${i * 110}ms;`}>
						<span class={`face-data ${i === 4 ? 'text-copper' : 'text-green'}`}>{t.step}</span>
						<h3 class="font-bold text-ink text-[15px] mt-2 tracking-tight">{t.label}</h3>
						<p class="text-[13px] text-muted mt-1.5 max-w-[13rem]">{t.note}</p>
					</div>
				))}
			</div>
			<p class="face-data text-muted mt-8" data-reveal>ELAPSED TIME: UNDER 3 MINUTES · OPERATOR INVOLVEMENT: NONE</p>

			<dl class="grid grid-cols-2 md:grid-cols-3 mt-10 border-t border-line">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">MISSED BOOKING CALLS</dt>
					<dd class="mt-1 text-2xl font-bold text-green">0</dd>
					<dd class="text-[13px] text-muted">once the system is live</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">CERAMIC BOOKINGS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">+<span data-count="40" data-count-suffix="%">40%</span></dd>
					<dd class="text-[13px] text-muted">with the upsell pitched on call one</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">CLIENT RETENTION</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="3" data-count-suffix="&times;">3&times;</span></dd>
					<dd class="text-[13px] text-muted">with automated return outreach</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- 3. LEAK AUDIT -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.4rem)] leading-tight text-ink" data-reveal>
					The leak audit.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SIX FINDINGS · BAY DOOR TO BOOKS</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{leakAudit.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[4.5rem_1fr_12rem] gap-x-6 gap-y-2 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1">{f.ref}</span>
					<div>
						<h3 class="font-bold text-ink text-lg">{f.finding}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[44rem]">{f.detail}</p>
					</div>
					<div class="md:text-right">
						<div class="face-data !text-[17px] text-green font-bold">{f.measured}</div>
						<div class="face-data !text-[11px] text-muted mt-0.5">{f.label.toUpperCase()}</div>
					</div>
				</div>
			))}

			<!-- Cost of inaction -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-16">
				<div class="lg:col-span-5">
					<p class="face-data text-muted" data-reveal>ESTIMATED ANNUAL COST OF INACTION</p>
					<div class="mt-4 face-display font-extrabold text-[clamp(3rem,7vw,5rem)] leading-none text-ink" data-reveal style="--reveal-delay: 100ms;">
						$<span data-count="78" data-count-suffix=",000+">78,000+</span>
					</div>
					<p class="text-[14px] text-muted mt-4 max-w-[24rem]" data-reveal style="--reveal-delay: 180ms;">
						Based on missed premium bookings &times; $1,500 average ceramic coating value per week.
					</p>
				</div>
				<div class="lg:col-span-7">
					<div class="rule-ticked" data-draw-rule></div>
					{timeline.map((t, i) => (
						<div class="spec-row grid sm:grid-cols-[11rem_1fr] gap-x-6 gap-y-1 py-6 px-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
							<span class="face-data text-copper pt-0.5">{t.t}</span>
							<p class="text-[15px] text-ink leading-relaxed">{t.body}</p>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 4. SIX SYSTEMS -->
	<section id="systems" class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems. Built for auto detailing.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>EVERY CLIENT RECEIVES ALL SIX · SP-01 — SP-06</p>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<div class="spec-row grid lg:grid-cols-[4.5rem_minmax(0,26rem)_1fr] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
					<span class="face-data text-copper pt-1">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink">{s.head}</h3>
						<p class="text-[15px] text-muted mt-2.5">{s.body}</p>
						<a href={s.href} class="link-ink inline-block mt-4 text-[14.5px] font-semibold">Explore {s.name}</a>
					</div>
					<ul class="self-center">
						{s.points.map((p) => (
							<li class="flex items-start gap-3 py-1.5 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- 5. ROI CALCULATOR -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.8vw,3rem)] leading-tight text-ink" data-reveal>
					What full deployment is worth to your shop.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 100ms;">Adjust the inputs to match your business — the figures update instantly.</p>
			</div>
			<ROICalculator client:visible />
		</div>
	</section>

	<!-- 6. AS FOUND / AS COMMISSIONED -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-12" data-reveal>
				Condition report: before and after install.
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-14">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>AS FOUND — TODAY, WITHOUT SYSTEMS</p>
					<div class="rule-ticked" data-draw-rule></div>
					{asFound.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<span class="face-data text-muted shrink-0 pt-0.5">&#10005;</span>
							{item}
						</div>
					))}
				</div>
				<div class="mt-10 md:mt-0">
					<p class="face-data text-green pb-3" data-reveal>AS COMMISSIONED — WITH SYSTEM PROS AI DEPLOYED</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{asCommissioned.map((item, i) => (
						<div class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
							{item}
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- 7. FINAL CTA — drench -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-paper-dim" data-reveal>SIGN-OFF — AUTO DETAILING DOSSIER</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[24ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your best clients want to come back. You just need a system.
			</h2>
			<p class="text-paper-dim text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free 30-minute consultation. We'll map exactly which AI systems will fill your calendar
				with premium jobs and keep clients returning — before you spend a dollar.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>

<script>
	document.querySelectorAll<HTMLVideoElement>('[data-hover-play]').forEach((v) => {
		const frame = v.closest('figure') ?? v;
		frame.addEventListener('mouseenter', () => v.play().catch(() => {}));
		frame.addEventListener('mouseleave', () => v.pause());
	});
</script>
