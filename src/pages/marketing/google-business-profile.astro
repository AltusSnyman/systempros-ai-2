---
import Layout from '../../layouts/Layout.astro';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import FAQ from '../../components/seo/FAQ.astro';
import { MARKETING_SERVICES } from '../../data/marketing';

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "Marketing", "item": "https://systempros.ai/marketing/" },
		{ "@type": "ListItem", "position": 3, "name": "Google Business Profile Management", "item": "https://systempros.ai/marketing/google-business-profile/" },
	],
};

const faqs = [
	{
		question: 'What does Google Business Profile Optimization do?',
		answer: "It makes sure your profile — the panel that shows up on Google Search and Maps when someone looks for what you do — is complete, accurate and working for you: the right categories, services, hours, photos and posts, all kept current. A well-run profile is often the first thing a prospective customer sees before they ever reach your website, so gaps in it cost you before the click.",
	},
	{
		question: 'How much does it cost to optimize a Google My Business profile?',
		answer: "There's no flat number — it's a fixed monthly fee, agreed after a free consultation. What drives the price is how many locations you're managing, whether you also want posting and review management bundled in, and how much ongoing activity your profile needs.",
	},
	{
		question: 'How can I optimize my Google My Business page?',
		answer: "Complete every field the platform allows, pick the categories that actually match what you do, keep hours and service areas accurate, add real photos regularly, post updates instead of letting the profile go quiet, and answer questions and reviews as they come in. That's a standing job, not a one-off setup — which is why we run it as a managed service rather than a one-time fix.",
	},
];
---

<Layout
	title="Google Business Profile Management | System Pros AI"
	description="Google Business Profile management and optimisation for local businesses in NZ and Australia: profile setup, ongoing posting, and monitoring, run for you."
>
	<ServiceSchema
		name="Google Business Profile Management"
		description="Google Business Profile management and optimisation: profile build-out and correction, category and service accuracy, and automated content posting, run as a managed service."
		serviceType="Google Business Profile Management"
		areaServed={['NZ', 'AU']}
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet MKT-01                  -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<a href="/marketing/" class="hover:text-green transition-colors">MARKETING</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">MKT-01 · GBP MANAGEMENT</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> PROFILE ONLINE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-8">
					<h1 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink" data-reveal>
						Google Business Profile management <span class="text-green">& optimisation</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[40rem]" data-reveal style="--reveal-delay: 120ms;">
						Your Google Business Profile is the panel that shows up before your website
						does. We build it out properly, correct what's wrong, and keep it posted to
						and current through an AI-assisted system — so the profile is working for
						you every day, not sitting there half-finished since the day it was claimed.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact/" class="btn-primary">Book a Free Consultation</a>
						<a href="#how-it-runs" class="btn-secondary">
							See how it runs
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE PROBLEM WITH A CLAIMED-AND-FORGOTTEN PROFILE -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-start">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						Most profiles are claimed, then abandoned.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						Someone on your team claimed the listing years ago, filled in the basics,
						and never touched it again. Hours drift out of date. Categories don't
						match what the business actually does today. Photos are old, or missing
						entirely. There are no posts, so the profile has nothing current to show
						a searcher deciding between you and the business next door.
					</p>
				</div>
				<ul>
					<li class="spec-row flex gap-5 py-5 px-2" data-reveal style="--reveal-delay: 160ms;">
						<span class="face-data text-copper pt-0.5 shrink-0 w-16">FAULT A</span>
						<div>
							<h3 class="font-bold text-ink">Stale details</h3>
							<p class="text-[14.5px] text-muted mt-1">Wrong hours, missing services, outdated photos — small gaps that quietly cost trust before a prospect even opens your site.</p>
						</div>
					</li>
					<li class="spec-row flex gap-5 py-5 px-2" data-reveal style="--reveal-delay: 240ms;">
						<span class="face-data text-copper pt-0.5 shrink-0 w-16">FAULT B</span>
						<div>
							<h3 class="font-bold text-ink">No posting cadence</h3>
							<p class="text-[14.5px] text-muted mt-1">A profile that never posts reads as inactive. Google and searchers both notice a listing that hasn't moved in months.</p>
						</div>
					</li>
					<li class="spec-row flex gap-5 py-5 px-2" data-reveal style="--reveal-delay: 320ms;">
						<span class="face-data text-copper pt-0.5 shrink-0 w-16">FAULT C</span>
						<div>
							<h3 class="font-bold text-ink">Nobody owns it</h3>
							<p class="text-[14.5px] text-muted mt-1">It's not anyone's job, so it's nobody's job — until a competitor's better-kept profile starts outranking yours locally.</p>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- HOW IT RUNS — spec table                     -->
	<!-- ============================================ -->
	<section id="how-it-runs" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					What we do. What you do.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>MKT-01 · SCOPE OF WORK</p>
			</div>

			<div class="border border-line overflow-x-auto" data-reveal>
				<table class="w-full text-left min-w-[560px]">
					<thead>
						<tr class="border-b border-line">
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 w-44">WORK ITEM</th>
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 border-l border-line">RUNS ON THE SYSTEM</th>
							<th scope="col" class="face-data text-green font-normal py-3.5 px-4 border-l border-line bg-green-faint">YOUR PART</th>
						</tr>
					</thead>
					<tbody>
						<tr class="border-t border-line">
							<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">PROFILE BUILD-OUT</th>
							<td class="py-4 px-4 text-[15px] text-ink border-l border-line">Categories, services, attributes and hours corrected and completed.</td>
							<td class="py-4 px-4 text-[15px] text-muted border-l border-line bg-green-faint">Confirm the details are right for your business.</td>
						</tr>
						<tr class="border-t border-line">
							<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">ONGOING POSTING</th>
							<td class="py-4 px-4 text-[15px] text-ink border-l border-line">Content scheduled and published to the profile automatically.</td>
							<td class="py-4 px-4 text-[15px] text-muted border-l border-line bg-green-faint">Flag anything worth featuring — a new job, a new service.</td>
						</tr>
						<tr class="border-t border-line">
							<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">MONITORING</th>
							<td class="py-4 px-4 text-[15px] text-ink border-l border-line">Changes and suggested edits from Google are tracked and actioned.</td>
							<td class="py-4 px-4 text-[15px] text-muted border-l border-line bg-green-faint">Nothing — this runs in the background.</td>
						</tr>
						<tr class="border-t border-line">
							<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">REVIEWS</th>
							<td class="py-4 px-4 text-[15px] text-ink border-l border-line">Handled as a dedicated service — see review and reputation management.</td>
							<td class="py-4 px-4 text-[15px] text-muted border-l border-line bg-green-faint">Tell us if a review needs a personal reply.</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-muted leading-relaxed mt-6 max-w-[42rem]" data-reveal>
				Reviews live on your Google Business Profile, so the two services connect
				directly: <a href="/marketing/reviews-reputation/" class="link-ink">see review and reputation management</a>.
			</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — why the profile matters             -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-7">
					<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit" data-reveal>
						It's free real estate. Most businesses leave it empty.
					</h2>
					<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						There's no ad spend required to have a complete, accurate, active Google
						Business Profile. It's the one piece of local marketing every business
						already has access to, and the one most consistently left half-built.
						Fixing it is foundational work — the kind of thing a 30-year systems
						engineer notices is missing before anything flashier gets built on top.
					</p>
					<a href="/contact/" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 240ms;">Book a Free Consultation</a>
				</div>
				<div class="lg:col-span-5">
					<div class="rule-ticked" data-draw-rule></div>
					<dl>
						<div class="grid grid-cols-[8rem_1fr] gap-x-6 items-baseline py-4 border-b border-line-drench" data-reveal style="--reveal-delay: 120ms;">
							<dt class="face-data text-paper-dim">PLATFORM</dt>
							<dd class="text-[15px] text-paper-lit">Google Business Profile (Search + Maps)</dd>
						</div>
						<div class="grid grid-cols-[8rem_1fr] gap-x-6 items-baseline py-4 border-b border-line-drench" data-reveal style="--reveal-delay: 200ms;">
							<dt class="face-data text-paper-dim">CADENCE</dt>
							<dd class="text-[15px] text-paper-lit">Ongoing, scheduled, not a one-off fix</dd>
						</div>
						<div class="grid grid-cols-[8rem_1fr] gap-x-6 items-baseline py-4" data-reveal style="--reveal-delay: 280ms;">
							<dt class="face-data text-paper-dim">COVERAGE</dt>
							<dd class="text-[15px] text-paper-lit">NZ and Australia, single or multi-location</dd>
						</div>
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- CROSS-LINKS                                  -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
				<h2 class="face-display font-extrabold text-[clamp(1.8rem,3.4vw,2.6rem)] leading-tight text-ink" data-reveal>
					The rest of the marketing system.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SEE THE OTHER SERVICES</p>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
			{MARKETING_SERVICES.filter((s) => s.href !== '/marketing/google-business-profile/').map((s, i) => (
				<a href={s.href} class="spec-row group grid md:grid-cols-[9rem_1fr_2rem] gap-x-8 gap-y-1 items-center py-5 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
					<span class="face-data text-copper">{s.ref}</span>
					<h3 class="text-[15px] font-semibold text-ink group-hover:text-green transition-colors">{s.name}</h3>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			))}
			<a href="/marketing/" class="link-ink font-semibold text-[15px] mt-6 inline-block" data-reveal>← Back to the marketing overview</a>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAQ                                          -->
	<!-- ============================================ -->
	<FAQ faqs={faqs} heading="Google Business Profile questions, answered." label="MKT-01 · FAQ" />

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>MKT-01 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Let's see what your profile is missing.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free consultation takes thirty minutes. We'll look at your current profile
				and tell you exactly what's costing you before we quote anything.
			</p>
			<a href="/contact/" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
