---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';
import ServiceSchema from '../components/seo/ServiceSchema.astro';

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "Consultation", "item": "https://systempros.ai/consulting/" },
	],
};

const gaps = [
	{
		label: 'GAP A',
		name: 'Disconnected tools',
		desc: "Most businesses have 6+ AI tools that don't talk to each other. Leads fall through every gap between them.",
	},
	{
		label: 'GAP B',
		name: 'No business logic',
		desc: "Off-the-shelf AI doesn't know your sales process, your objections, or your customer lifecycle. It guesses.",
	},
	{
		label: 'GAP C',
		name: 'Security blind spots',
		desc: 'Rushed AI installs create API vulnerabilities and data leakage risks that most vendors never mention.',
	},
];

const phases = [
	{
		no: '1',
		title: 'The forensic audit',
		desc: 'We analyze your call logs, listen to your sales calls, and map your current failure points to find the highest-ROI opportunities. No assumptions.',
		deliverable: 'Detailed audit report + failure map included',
	},
	{
		no: '2',
		title: 'The blueprint',
		desc: 'We verify the logic before writing a single line of code: a custom workflow map handling every objection, integration, and edge case.',
		deliverable: 'Visual workflow diagram delivered for sign-off',
	},
	{
		no: '3',
		title: 'The integration build',
		desc: 'We build the secure API pipes, configure the database schemas, and stress-test voice latency for sub-500ms response times. Thirty years of IT experience live here.',
		deliverable: 'Full build + QA + security testing',
	},
	{
		no: '4',
		title: 'Go live and scale',
		desc: "We launch — but we don't leave. Real-time conversation analytics, prompt fine-tuning from live data, and white-glove support as you scale.",
		deliverable: '30-day post-launch monitoring included',
	},
];

const standards = [
	{ label: 'SECURITY', value: 'SOC-2 compliant security practices' },
	{ label: 'UPTIME', value: '99.99% uptime architecture standard' },
	{ label: 'REGIONS', value: 'Architected for NZ, Australia and USA compliance' },
	{ label: 'PRIVACY', value: 'GDPR and CCPA-aware data residency planning' },
];
---

<Layout
	title="Digital Architecture Consulting | AI Strategy & Forensic Audit | System Pros AI"
	description="Forensic audit of your operations followed by a strategic AI roadmap. 30 years of enterprise IT architecture experience applied to your business. Not just tools — a system."
>
	<ServiceSchema
		name="AI Consultation"
		description="Forensic operational audit and strategic AI roadmap service with 30 years of enterprise IT architecture experience."
		serviceType="ConsultingService"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet SP-05                   -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">SP-05 · STRATEGY AND AUDIT</span>
				</nav>
				<span class="hidden md:inline">NZ · AU · USA</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> ACCEPTING AUDITS</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Software is cheap. <span class="text-green">Strategy is priceless.</span>
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Any agency can give you a login. We build the infrastructure, train the
						models, and integrate AI securely into your existing systems —
						<strong class="text-ink font-semibold">30 years of enterprise IT experience</strong>
						applied to modern automation.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book Your Forensic Audit</a>
						<a href="#methodology" class="btn-secondary">
							See the methodology
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="SP-05 — CONSULTATION, AUDIT TO ROADMAP">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="consultation" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>

			<!-- Commissioning figures -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-3">
				<div class="py-6 pr-6 border-r border-line" data-reveal>
					<dt class="face-data text-muted">EXPERIENCE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="30" data-count-suffix="+">30+</span> yrs</dd>
					<dd class="text-[13px] text-muted">enterprise IT architecture</dd>
				</div>
				<div class="py-6 px-6 border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">UPTIME STANDARD</dt>
					<dd class="mt-1 text-2xl font-bold text-copper">99.99%</dd>
					<dd class="text-[13px] text-muted">mission-critical builds</dd>
				</div>
				<div class="py-6 pl-6" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">METHOD</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">4 phases</dd>
					<dd class="text-[13px] text-muted">audit to scale, engineered</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE ARCHITECTURE GAP                         -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 02" caption="SP-05 — THE ARCHITECTURE GAP">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="consultation-gap" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						The tool is not the solution.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						Buying a stethoscope doesn't make you a doctor. Buying an AI voice agent
						doesn't make you automated. Without the right architecture, AI is just
						noise — it disconnects from your CRM, hallucinates answers, and
						frustrates your customers.
					</p>
					<ul class="mt-8">
						{gaps.map((g, i) => (
							<li class="spec-row flex gap-5 py-5 px-2" data-reveal style={`--reveal-delay: ${160 + i * 80}ms;`}>
								<span class="face-data text-copper pt-0.5 shrink-0 w-14">{g.label}</span>
								<div>
									<h3 class="font-bold text-ink">{g.name}</h3>
									<p class="text-[14.5px] text-muted mt-1">{g.desc}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE 4-PHASE PROTOCOL — sequential roadmap    -->
	<!-- ============================================ -->
	<section id="methodology" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-12">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						The 4-phase integration protocol.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[36rem]" data-reveal style="--reveal-delay: 80ms;">
						Our methodology for secure, high-impact AI deployment.
						We don't guess. We engineer.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>SP-05 · COMMISSIONING SEQUENCE</p>
			</div>

			<ol class="border-l-2 border-green ml-3 md:ml-6">
				{phases.map((p, i) => (
					<li class="relative pl-8 md:pl-12 pb-12 last:pb-2" data-reveal style={`--reveal-delay: ${i * 90}ms;`}>
						<span class="absolute -left-[19px] top-0 w-9 h-9 bg-green text-paper-lit font-bold flex items-center justify-center" aria-hidden="true">{p.no}</span>
						<p class="face-data text-muted pt-1.5">PHASE {p.no} OF 4</p>
						<h3 class="face-display font-extrabold text-2xl md:text-3xl text-ink mt-2">{p.title}</h3>
						<p class="text-muted leading-relaxed mt-3 max-w-[42rem]">{p.desc}</p>
						<p class="face-data text-copper mt-4">⊢ DELIVERABLE — {p.deliverable.toUpperCase()}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — built by engineers                  -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-7">
					<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit" data-reveal>
						Built by engineers, not marketers.
					</h2>
					<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Most AI agencies were started six months ago by marketers chasing a trend.
						System Pros AI is led by 30-year IT veterans who understand data sovereignty,
						API security, and uptime reliability.
					</p>
					<p class="mt-5 text-lg text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 200ms;">
						We don't "move fast and break things." We build critical infrastructure
						that lasts. When you hire us, you aren't getting a prompt engineer —
						you're getting an enterprise solutions architect.
					</p>
					<a href="/contact" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 280ms;">Book a Free Consultation</a>
				</div>
				<div class="lg:col-span-5">
					<div class="rule-ticked" data-draw-rule></div>
					<dl>
						{standards.map((s, i) => (
							<div class="grid grid-cols-[6.5rem_1fr] gap-x-6 items-baseline py-4 border-b border-line-drench" data-reveal style={`--reveal-delay: ${120 + i * 80}ms;`}>
								<dt class="face-data text-paper-dim">{s.label}</dt>
								<dd class="text-[15px] text-paper-lit">{s.value}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- PACKAGES — investment                        -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="text-center mb-12">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Choose your level of support.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 80ms;">From strategic maps to full-service execution.</p>
			</div>

			<div class="grid md:grid-cols-2 gap-6 max-w-[62rem] mx-auto">
				<!-- The Blueprint -->
				<div class="border border-line p-8 md:p-10 flex flex-col" data-reveal>
					<p class="face-data text-muted">PACKAGE A · STRATEGY ONLY</p>
					<h3 class="face-display font-extrabold text-2xl md:text-3xl text-ink mt-3">The Blueprint</h3>
					<p class="text-muted leading-relaxed mt-3">
						Ideal for internal IT teams who need a plan but want to build it themselves.
					</p>
					<div class="rule-ticked mt-6" data-draw-rule></div>
					<ul class="mt-2 mb-8">
						{['Forensic audit PDF report', 'Custom workflow map', 'API specification sheet'].map((item) => (
							<li class="spec-row flex items-center gap-3.5 py-3 px-1 text-[14.5px] text-ink">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
								{item}
							</li>
						))}
					</ul>
					<div class="mt-auto">
						<p class="face-data text-ink mb-4">ONE-TIME FEE</p>
						<a href="/contact" class="btn-secondary w-full">Book a strategy call</a>
					</div>
				</div>

				<!-- The Turnkey Integration -->
				<div class="border-2 border-green p-8 md:p-10 flex flex-col relative" data-reveal style="--reveal-delay: 100ms;">
					<span class="face-data absolute -top-[11px] left-6 bg-paper px-2 text-copper">MOST POPULAR</span>
					<p class="face-data text-muted">PACKAGE B · DONE-FOR-YOU</p>
					<h3 class="face-display font-extrabold text-2xl md:text-3xl text-ink mt-3">The Turnkey Integration</h3>
					<p class="text-muted leading-relaxed mt-3">
						Ideal for business owners who want results installed perfectly without the headache.
					</p>
					<div class="rule-ticked rule-ticked-green mt-6" data-draw-rule></div>
					<ul class="mt-2 mb-8">
						{['Full build and configuration', 'The Revenue Triad setup', 'Staff training workshop', '30-day white-glove support'].map((item) => (
							<li class="spec-row flex items-center gap-3.5 py-3 px-1 text-[14.5px] text-ink font-medium">
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
								{item}
							</li>
						))}
					</ul>
					<div class="mt-auto">
						<p class="face-data text-green mb-4">CUSTOM QUOTE</p>
						<a href="/contact" class="btn-primary w-full">Apply for access</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- REGIONAL DESKS                               -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
				<h2 class="face-display font-extrabold text-[clamp(1.8rem,3.4vw,2.6rem)] leading-tight text-ink" data-reveal>
					Consulting, localized.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>REGIONAL DESKS · AU / NZ</p>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
			<a href="/consulting/australia" class="spec-row group grid md:grid-cols-[10rem_1fr_2rem] gap-x-8 gap-y-1 items-center py-6 px-2" data-reveal>
				<span class="face-data text-copper">AUSTRALIA</span>
				<div>
					<h3 class="text-lg font-bold text-ink group-hover:text-green transition-colors">AI consulting for Australian business</h3>
					<p class="text-[14px] text-muted mt-1">Award wages, Fair Work compliance, Privacy Act 1988 — Sydney to Perth.</p>
				</div>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</a>
			<a href="/consulting/new-zealand" class="spec-row group grid md:grid-cols-[10rem_1fr_2rem] gap-x-8 gap-y-1 items-center py-6 px-2" data-reveal style="--reveal-delay: 80ms;">
				<span class="face-data text-copper">NEW ZEALAND</span>
				<div>
					<h3 class="text-lg font-bold text-ink group-hover:text-green transition-colors">AI consulting for Kiwi business</h3>
					<p class="text-[14px] text-muted mt-1">Privacy Act 2020, Xero integration, nationwide coverage — Auckland to Dunedin.</p>
				</div>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
			</a>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>SP-05 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Stop playing with tools. Start building a system.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[38rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				After your audit, we can deploy
				<a href="/voice-ai" class="link-ink">The Revenue Triad</a>, build a
				<a href="/lead-gen-websites" class="link-ink">Lead Gen Website</a>, set up
				<a href="/lead-reactor" class="link-ink">The Lead Reactor</a>, or configure
				<a href="/private-assistant" class="link-ink">The Private Assistant</a>.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
