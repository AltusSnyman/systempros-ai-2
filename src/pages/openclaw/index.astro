---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ServiceSchema from '../../components/seo/ServiceSchema.astro';
import FAQ from '../../components/seo/FAQ.astro';
import ProductVideoPlayer from '../../components/ProductVideoPlayer';

const faqs = [
	{
		question: 'What is OpenClaw?',
		answer: "OpenClaw is an open-source AI assistant that runs on your own hardware instead of someone else's cloud. It connects to messaging apps you already use — WhatsApp, iMessage, Slack, Discord, Telegram and more — so you talk to it like a contact in your phone, and it keeps memory and context between conversations.",
	},
	{
		question: 'How much does OpenClaw cost?',
		answer: "The OpenClaw software itself is free and open source. Running it costs whatever you spend on the AI model's API usage and on hosting or hardware to keep it running. A done-for-you setup by System Pros AI is a fixed price agreed after a free consultation, based on the channels, skills, integrations and hosting your deployment needs.",
	},
	{
		question: 'How do I install OpenClaw?',
		answer: "You can install it yourself by following the OpenClaw setup guide, which walks through prerequisites, the messaging bridges and the SOUL.md personality file. Most business owners choose the done-for-you route instead, where System Pros AI handles installation, configuration and testing.",
	},
	{
		question: 'Is OpenClaw safe for business data?',
		answer: "OpenClaw runs on infrastructure you control, so your conversations and data stay on your own hardware rather than a third-party server. Safety still depends on what skills you install — review what each skill can access before enabling it, the same as you would with any integration.",
	},
	{
		question: 'What can OpenClaw do for a business?',
		answer: "Deployed for business use, OpenClaw acts as an always-available assistant across your messaging apps — handling scheduling, research, CRM updates, content drafts and daily briefings. Which tasks it takes on depends on the skills and integrations you choose to install.",
	},
];

const capabilities = [
	{
		label: 'PRIVACY',
		title: 'Fully private, by architecture',
		desc: 'Runs on your hardware. Conversation history, memory and client data never leave your device — no cloud logging, no model training on your business.',
	},
	{
		label: 'CHANNELS',
		title: '20+ messaging platforms',
		desc: 'WhatsApp, iMessage, Slack, Discord, Telegram, Teams, Signal and more. One assistant, reachable on every channel you already use.',
	},
	{
		label: 'MEMORY',
		title: 'Persistent, long-horizon memory',
		desc: 'Remembers context across weeks and months. Ask "what did I say about that client last Tuesday?" — it knows, because it was there.',
	},
	{
		label: 'SKILLS',
		title: '3,000+ installable skills',
		desc: 'Extend capability from ClawHub: web search, CRM updates, note querying, meeting summaries, image generation and more.',
	},
	{
		label: 'PERSONALITY',
		title: 'Custom SOUL.md personality',
		desc: 'A personality file that defines how your AI thinks, communicates and behaves. Trained on your tone, it genuinely sounds like you.',
	},
	{
		label: 'AUTOMATION',
		title: 'Proactive triggers',
		desc: 'Cron-style schedules make your assistant act unprompted: morning briefings, reminders, summaries and status updates arrive before you ask.',
	},
];

const dossierIndex = [
	{
		ref: 'OC-01',
		title: 'OpenClaw use cases',
		desc: '10 real-world ways businesses are using OpenClaw right now — from executive assistant to sales intelligence.',
		href: '/openclaw/use-cases',
	},
	{
		ref: 'OC-02',
		title: 'OpenClaw for business',
		desc: 'How OpenClaw becomes your always-on AI employee, and where the hours actually come back from.',
		href: '/openclaw/for-business',
	},
	{
		ref: 'OC-03',
		title: 'OpenClaw vs ChatGPT',
		desc: 'A nine-criteria comparison record: privacy, platforms, memory, cost, extensibility. Why privacy-first businesses switch.',
		href: '/openclaw/vs-chatgpt',
	},
	{
		ref: 'OC-04',
		title: 'OpenClaw skills guide',
		desc: '3,000+ skills on ClawHub — what they are, how they are categorised, and which ones are worth installing.',
		href: '/openclaw/skills',
	},
	{
		ref: 'OC-05',
		title: 'OpenClaw setup guide',
		desc: 'The honest installation procedure: every step, every failure mode, and the done-for-you alternative.',
		href: '/openclaw/setup-guide',
	},
];
---

<Layout
	title="What Is OpenClaw? Setup, Skills & Use Cases"
	description="What is OpenClaw? The open-source AI assistant on your own hardware, reachable on 20+ messaging apps, with persistent memory and installable skills."
>
	<ServiceSchema
		name="OpenClaw Setup & Deployment"
		description="Done-for-you OpenClaw AI assistant deployment across WhatsApp, iMessage, Slack and 17 more platforms."
		serviceType="AIConsulting"
	/>
	<Breadcrumbs currentTitle="What is OpenClaw?" parent={{ name: 'Private Assistant', url: '/private-assistant' }} />

	<!-- ============================================ -->
	<!-- 1. HERO                                      -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>OPENCLAW DOSSIER — OC-00 / OVERVIEW</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> OPEN SOURCE · ACTIVELY MAINTAINED</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.02] text-ink" data-reveal>
						What is <span class="text-green">OpenClaw?</span>
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						The world's fastest-growing open-source AI assistant — a personal AI that lives on
						<strong class="text-ink font-semibold">your hardware</strong>, works on
						<strong class="text-ink font-semibold">20+ messaging platforms</strong>,
						and never sends your data to someone else's servers.
					</p>
					<p class="mt-4 text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 180ms;">
						Unlike ChatGPT or Claude's web interface, OpenClaw is installed privately on your Mac,
						Linux server or cloud VM. You message it on WhatsApp, iMessage, Slack or Discord — and it
						responds instantly, remembers everything, and acts as your executive assistant, researcher
						and automation engine.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 260ms;">
						<a href="/private-assistant" class="btn-primary">Get It Deployed For Me</a>
						<a href="/openclaw/setup-guide" class="btn-secondary">
							DIY setup guide
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					</div>
					<p class="mt-5 text-[14px] text-muted" data-reveal style="--reveal-delay: 300ms;">
						Ready for the full walkthrough? Read the <a href="/openclaw/setup-guide/" class="link-ink">OpenClaw setup guide</a>,
						or <a href="/pricing/" class="link-ink">view pricing</a> for the done-for-you service.
					</p>
				</div>

				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="OPENCLAW — PRIVATE AI, INSTALLED ON YOUR HARDWARE">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="openclaw-hub" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>

			<!-- Commissioning figures -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-4">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">ADOPTION</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="247" data-count-suffix="k+">247k+</span></dd>
					<dd class="text-[13px] text-muted">GitHub stars</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">CHANNELS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="20" data-count-suffix="+">20+</span></dd>
					<dd class="text-[13px] text-muted">messaging platforms</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">EXTENSIONS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">3,000+</dd>
					<dd class="text-[13px] text-muted">skills on ClawHub</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">DATA LOCATION</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">Yours</dd>
					<dd class="text-[13px] text-muted">your hardware, your four walls</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. WHY IT'S DIFFERENT — prose brief          -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line mt-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
				<div class="lg:col-span-4">
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink lg:sticky lg:top-28" data-reveal>
						Why OpenClaw is different.
					</h2>
				</div>
				<div class="lg:col-span-7 lg:col-start-6 space-y-5 text-muted text-lg leading-relaxed max-w-[70ch]">
					<p data-reveal>
						Most AI tools follow the same model: you go to a website, type a question, get an answer,
						and the conversation resets. Every query is logged, analysed, and potentially used to train
						future models. Your business strategies, your client names, your revenue figures — all of it
						flows through someone else's cloud.
					</p>
					<p data-reveal style="--reveal-delay: 80ms;">
						OpenClaw breaks this model entirely. It's an <strong class="text-ink font-semibold">open-source
						framework</strong> that you (or we) install on your own hardware. Once running, it connects to
						the messaging apps you already use — WhatsApp, iMessage, Slack, Discord, Telegram — so your AI
						is literally a contact in your phone. You text it. It responds. And everything stays within
						your four walls.
					</p>
					<p data-reveal style="--reveal-delay: 160ms;">
						The "<strong class="text-ink font-semibold">Claw</strong>" in OpenClaw refers to the system's
						core philosophy: an AI that grabs onto your existing workflows and holds on. It doesn't replace
						your tools — it becomes the intelligent layer that connects them all.
					</p>
					<p data-reveal style="--reveal-delay: 240ms;">
						With <strong class="text-ink font-semibold">3,000+ community skills on ClawHub</strong> —
						think of it as an app store for AI capabilities — you can extend OpenClaw to handle anything
						from summarising Zoom calls to updating your CRM, querying your Obsidian notes, or running
						competitive research in real time.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. CAPABILITY SPEC SHEET                     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Core capabilities.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>SPECIFICATION — AS INSTALLED</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{capabilities.map((c, i) => (
				<div
					class="spec-row grid md:grid-cols-[10rem_18rem_1fr] gap-x-8 gap-y-1.5 py-6 px-2"
					data-reveal
					style={`--reveal-delay: ${i * 60}ms;`}
				>
					<span class="face-data text-copper pt-1">{c.label}</span>
					<h3 class="text-lg font-bold text-ink">{c.title}</h3>
					<p class="text-[15px] text-muted leading-relaxed max-w-[46rem]">{c.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. THE DOSSIER INDEX — subpages              -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						The OpenClaw dossier.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[38rem]" data-reveal style="--reveal-delay: 80ms;">
						Everything you need to understand, evaluate and deploy OpenClaw for your business — filed in order.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>INDEX · OC-01 — OC-05</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{dossierIndex.map((page, i) => (
				<a
					href={page.href}
					class="spec-row group grid grid-cols-[3.5rem_1fr] md:grid-cols-[4.5rem_1fr_2rem] gap-x-6 gap-y-1.5 items-center py-6 px-2"
					data-reveal
					style={`--reveal-delay: ${i * 60}ms;`}
				>
					<span class="face-data text-copper">{page.ref}</span>
					<div>
						<h3 class="text-xl font-bold text-ink group-hover:text-green transition-colors">{page.title}</h3>
						<p class="text-[15px] text-muted mt-1 max-w-[46rem]">{page.desc}</p>
					</div>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. FAQ                                       -->
	<!-- ============================================ -->
	<FAQ faqs={faqs} heading="What is OpenClaw? Questions, answered." label="OC-00 / FAQ" />

	<!-- ============================================ -->
	<!-- 6. DRENCH CTA                                -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="max-w-[46rem]">
				<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit" data-reveal>
					OpenClaw running on your devices in 48 hours.
				</h2>
				<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
					We handle installation, channel connections, the SOUL.md personality, and skill setup.
					You get a production-ready private AI assistant without touching a terminal.
				</p>
				<a href="/private-assistant" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 240ms;">
					See The Private Assistant Service
					<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>
		</div>
	</section>
</Layout>
