---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ProductVideoPlayer from '../../components/ProductVideoPlayer';

const timeLedger = [
	{
		area: 'ADMIN & SCHEDULING',
		before: '3–4 hrs/week juggling calendars, emails and follow-ups manually',
		after: '15 min/week — AI handles scheduling, drafts emails, sets reminders',
		saving: '~3 hrs',
	},
	{
		area: 'CRM DATA ENTRY',
		before: 'Manual logging after every call and meeting — often skipped entirely',
		after: 'Voice-to-CRM: text your AI what happened, record created instantly',
		saving: '~5 hrs',
	},
	{
		area: 'RESEARCH & INTEL',
		before: 'Ad-hoc Google searches, browser tabs everywhere, outdated data',
		after: 'Real-time research queries via WhatsApp with structured output',
		saving: '~2 hrs',
	},
	{
		area: 'CONTENT PRODUCTION',
		before: 'Staring at blank pages, rewriting drafts, inconsistent brand voice',
		after: 'First draft in your voice in 30 seconds, ready to refine',
		saving: '~4 hrs',
	},
];

const operators = [
	{
		role: 'Founders & CEOs',
		desc: "You're the bottleneck in your own business. OpenClaw handles the 80% of cognitive admin that doesn't need your direct involvement — so you stay in the zone that actually moves the needle.",
	},
	{
		role: 'Sales professionals',
		desc: 'Pre-call research, post-call CRM logging, follow-up message drafts, objection scripts and competitor comparisons. Your AI manages the before and after so you focus on the conversation itself.',
	},
	{
		role: 'Operations teams',
		desc: 'Standard operating procedures queried in natural language. Workflows triggered by a message. Status updates from multiple systems consolidated into one morning brief. Operations at 10x the throughput.',
	},
	{
		role: 'Marketing teams',
		desc: 'Brand voice is consistent when your AI is trained on your tone. Campaign brief generation, content repurposing, SEO keyword queries and competitor content analysis — all via Slack.',
	},
	{
		role: 'Consultants',
		desc: 'Client notes, research synthesis, proposal drafts and meeting summaries — all available on demand from your phone. You show up to every client interaction more prepared than anyone else in the room.',
	},
	{
		role: 'Agency owners',
		desc: 'Multiple clients, multiple contexts, multiple deliverables. OpenClaw becomes your knowledge management layer — instantly surfacing what matters for the client you are currently serving.',
	},
];
---

<Layout
	title="OpenClaw for Business | System Pros AI"
	description="OpenClaw for business turns a private AI assistant into an always-on employee on WhatsApp, Slack and iMessage — handling admin, research and CRM updates."
>
	<Breadcrumbs currentTitle="For Business" parent={{ name: 'OpenClaw', url: '/openclaw' }} />

	<!-- ============================================ -->
	<!-- 1. HERO — figure left, brief right           -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>OPENCLAW DOSSIER — OC-02 / BUSINESS DEPLOYMENT</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> ON DUTY 24/7</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-5 order-2 lg:order-1" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="THE PRIVATE ASSISTANT — REPORTING FOR DUTY">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="private-assistant" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div class="lg:col-span-7 order-1 lg:order-2">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Your always-on <span class="text-green">AI employee.</span>
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Imagine hiring an executive assistant who never sleeps, never forgets a conversation,
						works on WhatsApp, Slack and iMessage simultaneously, and costs a fraction of a junior
						hire. That's OpenClaw for business, deployed correctly.
					</p>
					<div class="mt-9" data-reveal style="--reveal-delay: 240ms;">
						<a href="/private-assistant" class="btn-primary">Get My Business AI Deployed</a>
					</div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. THE BUSINESS CASE — prose brief           -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
				<div class="lg:col-span-4">
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink lg:sticky lg:top-28" data-reveal>
						The business case for private AI.
					</h2>
				</div>
				<div class="lg:col-span-7 lg:col-start-6 space-y-5 text-muted text-lg leading-relaxed max-w-[70ch]">
					<p data-reveal>
						Most business owners interact with AI by opening a browser tab, typing a question, and
						hoping the answer is useful. This approach has three fatal flaws for serious businesses:
						the AI doesn't know your business context, the data you share trains a competitor's model,
						and you get zero continuity between sessions.
					</p>
					<p data-reveal style="--reveal-delay: 80ms;">
						OpenClaw for business is a fundamentally different architecture. It runs on
						<strong class="text-ink font-semibold">your server or hardware</strong>, so it accumulates
						institutional knowledge over time. It knows your clients by name, your products and pricing,
						your communication style, and your recurring workflows. Every interaction builds on the last.
					</p>
					<p data-reveal style="--reveal-delay: 160ms;">
						The financial case is compelling: the average knowledge worker switches between applications
						1,200 times per day and loses roughly 20 minutes of deep focus per context switch. OpenClaw
						collapses these context switches into a single WhatsApp thread. Instead of opening seven
						apps, you send one message.
					</p>
					<p data-reveal style="--reveal-delay: 240ms;">
						For SMEs operating across time zones — common for NZ and Australian businesses with US
						clients — OpenClaw operates 24/7 without a salary. It can handle inbound enquiries, update
						the CRM, send follow-up messages, and brief you on overnight activity before your morning
						coffee.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. TIME LEDGER — before/after spec table     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Where the hours come back from.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>TIME LEDGER · PER PERSON, PER WEEK</p>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full min-w-[720px] border-collapse text-left">
					<thead>
						<tr class="border-y border-line">
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-3.5 pr-4 w-[11.5rem]">Workload</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-3.5 px-4">Before</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-3.5 px-4 border-l border-line bg-paper">After OpenClaw</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-3.5 pl-4 text-right w-[7.5rem]">Reclaimed</th>
						</tr>
					</thead>
					<tbody>
						{timeLedger.map((row, i) => (
							<tr class="border-b border-line align-top" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
								<th scope="row" class="face-data !text-[12px] text-green font-normal py-5 pr-4">{row.area}</th>
								<td class="text-[14.5px] text-muted leading-relaxed py-5 px-4 max-w-[22rem]">{row.before}</td>
								<td class="text-[14.5px] text-ink leading-relaxed py-5 px-4 max-w-[22rem] border-l border-line bg-paper">{row.after}</td>
								<td class="face-data !text-[13px] text-copper-deep py-5 pl-4 text-right whitespace-nowrap">{row.saving}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 max-w-[40rem] mx-auto mt-12 text-center sm:text-left">
				<div class="py-5 sm:pr-8 sm:border-r border-line" data-reveal>
					<div class="text-4xl font-extrabold text-green face-display"><span data-count="14" data-count-suffix="+">14+</span> hrs</div>
					<div class="text-[14px] text-muted mt-1.5">saved per week, per person</div>
				</div>
				<div class="py-5 sm:pl-8" data-reveal style="--reveal-delay: 100ms;">
					<div class="text-4xl font-extrabold text-ink face-display">$140,000</div>
					<div class="text-[14px] text-muted mt-1.5">per year in reclaimed capacity, at $100/hr</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. WHO IT'S BUILT FOR — operator register    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Who gets the most out of OpenClaw.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>OPERATOR PROFILES</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{operators.map((o, i) => (
				<div
					class="spec-row grid md:grid-cols-[16rem_1fr] gap-x-8 gap-y-1.5 py-6 px-2"
					data-reveal
					style={`--reveal-delay: ${i * 60}ms;`}
				>
					<h3 class="text-lg font-bold text-ink">{o.role}</h3>
					<p class="text-[15px] text-muted leading-relaxed max-w-[52rem]">{o.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit max-w-[20ch] mx-auto" data-reveal>
				Ready to put an AI employee on the payroll?
			</h2>
			<p class="mt-6 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 120ms;">
				We deploy, configure and personalise your OpenClaw assistant in 48–72 hours.
				You message it on WhatsApp from day one.
			</p>
			<a href="/private-assistant" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 240ms;">
				See The Private Assistant Service
			</a>
			<p class="mt-8 text-[14px] text-paper-dim" data-reveal style="--reveal-delay: 300ms;">
				<a href="/openclaw" class="text-paper-lit underline underline-offset-3 hover:text-copper transition-colors">Back to the OpenClaw dossier</a>
				<span class="mx-2" aria-hidden="true">·</span>
				<a href="/openclaw/use-cases" class="text-paper-lit underline underline-offset-3 hover:text-copper transition-colors">View all use cases</a>
			</p>
		</div>
	</section>
</Layout>
