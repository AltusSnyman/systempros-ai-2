---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ProductVideoPlayer from '../../components/ProductVideoPlayer';

const skillCategories = [
	{
		name: 'Productivity & admin',
		count: '400+',
		skills: ['Calendar management', 'Email drafting & triage', 'Task list management', 'Meeting summaries', 'Travel booking research'],
	},
	{
		name: 'Research & intelligence',
		count: '350+',
		skills: ['Real-time web search', 'Competitor analysis', 'Market research reports', 'News monitoring', 'Academic paper summaries'],
	},
	{
		name: 'Knowledge management',
		count: '280+',
		skills: ['Obsidian vault queries', 'Notion database search', 'Document Q&A', 'Personal knowledge graphs', 'Meeting notes indexing'],
	},
	{
		name: 'Creative & content',
		count: '320+',
		skills: ['LinkedIn posts', 'Email newsletters', 'Blog outlines', 'Script writing', 'Brand voice matching'],
	},
	{
		name: 'Developer tools',
		count: '500+',
		skills: ['GitHub integration', 'Code review summaries', 'PR descriptions', 'Deploy status checks', 'Stack Overflow queries'],
	},
	{
		name: 'Business automation',
		count: '450+',
		skills: ['CRM updates via text', 'Invoice generation', 'Slack channel summaries', 'Sales pipeline tracking', 'Client onboarding flows'],
	},
];

const topSkills = [
	{ name: 'DailyBriefing', desc: 'Morning digest of calendar, tasks and news', stars: '15.3k' },
	{ name: 'WebSearch', desc: 'Real-time web search with cited sources', stars: '12.4k' },
	{ name: 'ZoomSummary', desc: 'Transcribe and summarise meeting recordings', stars: '11.2k' },
	{ name: 'ObsidianVault', desc: 'Query your personal notes database', stars: '9.1k' },
	{ name: 'VoiceClone', desc: 'Write content that sounds like you', stars: '8.6k' },
	{ name: 'CRMWhisperer', desc: 'Voice-to-CRM data entry via message', stars: '7.8k' },
];
---

<Layout
	title="OpenClaw Skills Guide: 3,000+ Powers on ClawHub | System Pros AI"
	description="Everything you need to know about OpenClaw skills and ClawHub — the community marketplace with 3,000+ AI powers. Find the best skills for business productivity, research, CRM, and more."
>
	<Breadcrumbs currentTitle="Skills Guide" parent={{ name: 'OpenClaw', url: '/openclaw' }} />

	<!-- ============================================ -->
	<!-- 1. HERO                                      -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>OPENCLAW DOSSIER — OC-04 / SKILL REGISTER</span>
				<span class="hidden md:inline">SOURCE: CLAWHUB COMMUNITY MARKETPLACE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						OpenClaw skills: <span class="text-green">3,000+ powers</span> for your AI.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Skills are the superpower system inside OpenClaw — think of them as apps for your AI.
						Each one adds a new capability, from querying your Obsidian notes to updating your CRM
						via text. The ClawHub community has built over 3,000 of them, and we install the right
						50 for your specific workflow.
					</p>
					<div class="mt-9" data-reveal style="--reveal-delay: 240ms;">
						<a href="/private-assistant" class="btn-primary">Get My Skills Installed</a>
					</div>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="SKILLS — MODULAR CAPABILITIES, INSTALLED TO ORDER">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="private-assistant-skills" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. WHAT ARE SKILLS — prose brief             -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-10">
				<div class="lg:col-span-4">
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink lg:sticky lg:top-28" data-reveal>
						What are OpenClaw skills?
					</h2>
				</div>
				<div class="lg:col-span-7 lg:col-start-6 space-y-5 text-muted text-lg leading-relaxed max-w-[70ch]">
					<p data-reveal>
						Out of the box, OpenClaw is a capable AI assistant — it can answer questions, draft
						content, and hold a conversation. But its real power comes from
						<strong class="text-ink font-semibold">skills</strong>: modular extensions that give it
						specific capabilities connected to real-world tools and data sources.
					</p>
					<p data-reveal style="--reveal-delay: 80ms;">
						A skill is essentially a pre-built integration. The <em>WebSearch</em> skill connects
						OpenClaw to live internet data so it can answer questions about current events. The
						<em>ObsidianVault</em> skill indexes your personal notes so you can ask your AI what you
						wrote in a meeting three months ago. The <em>CRMWhisperer</em> skill connects to your CRM
						so a single text message creates a logged contact.
					</p>
					<p data-reveal style="--reveal-delay: 160ms;">
						Skills are discovered and downloaded from <strong class="text-ink font-semibold">ClawHub</strong>
						— the community-run marketplace analogous to npm for Node or the App Store for iOS. Each
						skill has a star rating, installation instructions and community reviews. The
						247,000-strong OpenClaw developer community adds new skills weekly.
					</p>
					<p data-reveal style="--reveal-delay: 240ms;">
						The challenge for most businesses isn't finding skills — it's knowing which 50 of the
						3,000+ available are actually worth installing for their use case. That curation process
						is a core part of what we do when we deploy your private assistant.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. THE CATEGORY REGISTER                     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					The register, by category.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>CLAWHUB HOLDINGS · 6 CATEGORIES</p>
			</div>

			<div class="face-data text-muted grid grid-cols-[1fr_5rem] md:grid-cols-[16rem_1fr_6rem] gap-x-8 pb-3">
				<span>CATEGORY</span>
				<span class="hidden md:block">REPRESENTATIVE SKILLS</span>
				<span class="text-right">HOLDINGS</span>
			</div>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{skillCategories.map((cat, i) => (
				<div
					class="spec-row grid grid-cols-[1fr_5rem] md:grid-cols-[16rem_1fr_6rem] gap-x-8 gap-y-2 py-6 px-2 items-baseline"
					data-reveal
					style={`--reveal-delay: ${i * 60}ms;`}
				>
					<h3 class="text-lg font-bold text-ink">{cat.name}</h3>
					<p class="col-span-2 md:col-span-1 md:col-start-2 text-[14.5px] text-muted leading-relaxed max-w-[46rem]">
						{cat.skills.join(' · ')}
					</p>
					<span class="face-data text-copper-deep text-right col-start-2 row-start-1 md:col-start-3">{cat.count}</span>
				</div>
			))}
			<p class="face-data !text-[11px] text-muted mt-4">COUNTS APPROXIMATE — THE REGISTER GROWS WEEKLY.</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. MOST-INSTALLED SKILLS                     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-4">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Most-installed community skills.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>RANKED BY CLAWHUB STARS</p>
			</div>
			<p class="text-muted text-lg mb-10 max-w-[38rem]" data-reveal style="--reveal-delay: 80ms;">
				The skills most commonly installed in our done-for-you deployments.
			</p>

			<div class="overflow-x-auto" data-reveal>
				<table class="w-full min-w-[640px] border-collapse text-left">
					<thead>
						<tr class="border-y-2 border-ink">
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-4 pr-4 w-[13rem]">Skill</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-4 px-4">Function</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-4 pl-4 text-right w-[9rem]">ClawHub stars</th>
						</tr>
					</thead>
					<tbody>
						{topSkills.map((skill, i) => (
							<tr class="border-b border-line hover:bg-green-faint transition-colors" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
								<th scope="row" class="face-data !text-[13px] text-green font-normal py-5 pr-4">{skill.name}</th>
								<td class="text-[15px] text-ink py-5 px-4">{skill.desc}</td>
								<td class="face-data !text-[13px] text-copper-deep py-5 pl-4 text-right whitespace-nowrap">★ {skill.stars}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="max-w-[46rem]">
				<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit" data-reveal>
					Stop browsing ClawHub. We'll pick the right 50.
				</h2>
				<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
					We analyse your role and workflow, select the optimal skill stack, install and test
					everything, then hand you a production-ready assistant.
				</p>
				<a href="/private-assistant" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 240ms;">
					Get My Skills Installed
				</a>
				<p class="mt-8 text-[14px] text-paper-dim" data-reveal style="--reveal-delay: 300ms;">
					<a href="/openclaw" class="text-paper-lit underline underline-offset-3 hover:text-copper transition-colors">Back to the OpenClaw dossier</a>
				</p>
			</div>
		</div>
	</section>
</Layout>
