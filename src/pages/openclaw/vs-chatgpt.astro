---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FAQ from '../../components/seo/FAQ.astro';
import ProductVideoPlayer from '../../components/ProductVideoPlayer';

const faqs = [
	{
		question: 'Is OpenClaw better than ChatGPT?',
		answer: "It depends what you optimise for. ChatGPT has a more capable base model for general tasks. OpenClaw wins on privacy (data stays on your hardware), platform coverage (20+ messaging apps), persistent memory, and extensibility via skills. For business use, OpenClaw is usually the better choice.",
	},
	{
		question: 'Can OpenClaw use GPT-4 or Claude?',
		answer: "Yes. OpenClaw is model-agnostic. You can connect it to OpenAI's API, Anthropic's Claude API, Ollama local models, or any other LLM provider. You get the power of any AI model combined with OpenClaw's platform integrations and privacy architecture.",
	},
	{
		question: 'Does OpenClaw work offline?',
		answer: "If you connect it to a local Ollama model, yes. If it uses a cloud API (OpenAI, Anthropic), it requires internet to process queries — but your conversation data still stays within your server rather than being stored by OpenClaw itself.",
	},
	{
		question: 'Is OpenClaw free?',
		answer: "The OpenClaw framework itself is free and open-source. You'll need to pay for the LLM API you connect it to (e.g., OpenAI or Anthropic API costs), and your own server or hardware. System Pros AI charges a setup and configuration fee — contact us for pricing.",
	},
];

type Winner = 'openclaw' | 'chatgpt';

const comparison: { criterion: string; chatgpt: string; openclaw: string; winner: Winner }[] = [
	{ criterion: 'Data privacy', chatgpt: 'Stored on OpenAI servers. Used for training.', openclaw: 'On your hardware. Zero data sharing.', winner: 'openclaw' },
	{ criterion: 'Available platforms', chatgpt: 'Web browser and mobile app only', openclaw: 'WhatsApp, iMessage, Slack, Discord + 17 more', winner: 'openclaw' },
	{ criterion: 'Persistent memory', chatgpt: 'Limited. Resets or requires paid tier.', openclaw: 'Full persistent memory across all sessions', winner: 'openclaw' },
	{ criterion: 'Monthly cost', chatgpt: '$20–$100/mo subscription', openclaw: 'One-time setup + your own API costs (~$5–20/mo)', winner: 'openclaw' },
	{ criterion: 'Custom personality', chatgpt: 'Custom instructions only (limited)', openclaw: 'Full SOUL.md personality file — sounds like you', winner: 'openclaw' },
	{ criterion: 'Extensibility', chatgpt: 'Plugins (paid) and GPTs', openclaw: '3,000+ skills on ClawHub, community-built', winner: 'openclaw' },
	{ criterion: 'Proactive triggers', chatgpt: 'None — you must initiate every query', openclaw: 'Cron-style triggers, scheduled briefings', winner: 'openclaw' },
	{ criterion: 'Base model quality', chatgpt: 'GPT-4o — industry-leading general capability', openclaw: 'Depends on connected model (can use GPT-4)', winner: 'chatgpt' },
	{ criterion: 'Setup complexity', chatgpt: 'Sign up and go — zero technical barrier', openclaw: 'Requires technical setup (we do this for you)', winner: 'chatgpt' },
];

const chooseChatGPT = [
	'You just need quick one-off queries with no business context',
	"You're an individual with no sensitive data to protect",
	'You want the best possible raw language model performance right now',
	"You're not technical and can't get technical help setting up alternatives",
];

const chooseOpenClaw = [
	'You handle sensitive business or client data',
	'You want your AI on WhatsApp, iMessage or Slack — not a browser',
	'You need an AI that remembers context across weeks and months',
	'You want to automate workflows and connect AI to your existing tools',
];
---

<Layout
	title="OpenClaw vs ChatGPT for Business | System Pros AI"
	description="OpenClaw vs ChatGPT for business: compare privacy, platforms, memory, cost and extensibility to see which private AI assistant fits your company."
>
	<Breadcrumbs currentTitle="vs ChatGPT" parent={{ name: 'OpenClaw', url: '/openclaw' }} />

	<!-- ============================================ -->
	<!-- 1. HERO                                      -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-6 pb-4">
				<span>OPENCLAW DOSSIER — OC-03 / COMPARISON RECORD</span>
				<span class="hidden md:inline">9 CRITERIA ASSESSED</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center py-12 lg:py-16">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						OpenClaw vs ChatGPT: <span class="text-green">why privacy wins.</span>
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						ChatGPT is a brilliant tool. But for businesses handling sensitive data, operating
						across multiple communication channels, or wanting an AI that truly knows their
						context — OpenClaw wins in almost every dimension that matters.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/private-assistant" class="btn-primary">Get OpenClaw Deployed</a>
						<a href="#comparison" class="btn-secondary">
							Read the comparison
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="OPENCLAW VS CHATGPT — SIDE-BY-SIDE ASSESSMENT">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="openclaw-vs-chatgpt" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. THE PRIVACY ARGUMENT                      -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-7 space-y-5 text-muted text-lg leading-relaxed max-w-[70ch]">
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink !mb-8" data-reveal>
						The case for private AI.
					</h2>
					<p data-reveal>
						When you type into ChatGPT, you're interacting with a service that logs your conversation,
						associates it with your account, and may use it to improve future models. For personal
						queries about pasta recipes, this is fine. For business queries involving client names,
						contract terms, pricing strategies or competitive intelligence — this is a significant
						data risk.
					</p>
					<p data-reveal style="--reveal-delay: 80ms;">
						OpenClaw runs entirely on infrastructure you control. There is no third-party server
						receiving your inputs. The LLM processes your query via an API call (which is ephemeral
						and not stored by the API provider under standard enterprise agreements), but your
						<strong class="text-ink font-semibold">conversation history, your memory, your notes,
						your client data</strong> — all of it stays on your machine.
					</p>
					<p data-reveal style="--reveal-delay: 160ms;">
						For NZ and Australian businesses subject to the Privacy Act 2020 and the Australian
						Privacy Principles respectively, this distinction matters for compliance as well as
						competitive security. Using public AI to process customer data without appropriate
						controls is an increasingly flagged risk by privacy commissioners.
					</p>
					<p data-reveal style="--reveal-delay: 240ms;">
						Privacy aside, OpenClaw's biggest practical advantage over ChatGPT is
						<strong class="text-ink font-semibold">where it lives</strong>. ChatGPT requires you to
						open a browser. OpenClaw is a contact on your phone. The friction difference is
						enormous — and friction is the enemy of habit.
					</p>
				</div>
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 02" caption="DATA SILO — YOUR RECORDS STAY INSIDE YOUR WALLS">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="private-assistant-silo" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. THE COMPARISON RECORD — spec table        -->
	<!-- ============================================ -->
	<section id="comparison" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Criterion by criterion.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>COMPARISON RECORD · ▲ = ADVANTAGE</p>
			</div>

			<div class="overflow-x-auto" data-reveal>
				<table class="w-full min-w-[760px] border-collapse text-left">
					<thead>
						<tr class="border-y-2 border-ink">
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-4 pr-4 w-[13rem]">Criterion</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-muted font-normal py-4 px-5 border-l border-line">ChatGPT</th>
							<th scope="col" class="face-data !text-[11px] uppercase text-green font-normal py-4 px-5 border-l border-line bg-green-faint">OpenClaw</th>
						</tr>
					</thead>
					<tbody>
						{comparison.map((row, i) => (
							<tr class="border-b border-line align-top hover:bg-green-faint/60 transition-colors" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
								<th scope="row" class="text-[15px] font-bold text-ink py-5 pr-4">{row.criterion}</th>
								<td class={`text-[14.5px] leading-relaxed py-5 px-5 border-l border-line ${row.winner === 'chatgpt' ? 'text-ink font-medium' : 'text-muted'}`}>
									{row.winner === 'chatgpt' && <span class="text-green mr-2" aria-label="advantage: ChatGPT">▲</span>}
									{row.chatgpt}
								</td>
								<td class={`text-[14.5px] leading-relaxed py-5 px-5 border-l border-line bg-green-faint ${row.winner === 'openclaw' ? 'text-ink font-medium' : 'text-muted'}`}>
									{row.winner === 'openclaw' && <span class="text-green mr-2" aria-label="advantage: OpenClaw">▲</span>}
									{row.openclaw}
								</td>
							</tr>
						))}
					</tbody>
					<tfoot>
						<tr class="border-b border-line">
							<td class="face-data !text-[11px] uppercase text-muted py-3.5 pr-4">Assessment</td>
							<td class="face-data !text-[12px] text-muted py-3.5 px-5 border-l border-line">2 of 9 criteria</td>
							<td class="face-data !text-[12px] text-copper-deep py-3.5 px-5 border-l border-line bg-green-faint">7 of 9 criteria — recommended for business use</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. WHEN TO CHOOSE WHICH                      -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink mb-10" data-reveal>
				When to choose which.
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-10">
				<div>
					<p class="face-data text-muted pb-3" data-reveal>CHOOSE CHATGPT IF —</p>
					<div class="rule-ticked" data-draw-rule></div>
					<ul>
						{chooseChatGPT.map((item, i) => (
							<li class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-muted leading-relaxed" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linecap="square" class="shrink-0 mt-1.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
								{item}
							</li>
						))}
					</ul>
				</div>
				<div>
					<p class="face-data text-green pb-3" data-reveal>CHOOSE OPENCLAW IF —</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					<ul>
						{chooseOpenClaw.map((item, i) => (
							<li class="spec-row flex items-start gap-4 py-4 px-1 text-[15px] text-ink leading-relaxed" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
								{item}
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. FAQ                                       -->
	<!-- ============================================ -->
	<FAQ faqs={faqs} heading="Frequently asked questions." label="OC-03 / FAQ" />

	<!-- ============================================ -->
	<!-- 6. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>COMPARISON CLOSED</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[18ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Ready to switch to private AI?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				We handle the entire OpenClaw setup — server, channels, personality, skills.
				Running in 48–72 hours.
			</p>
			<a href="/private-assistant" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Get My Private AI Assistant
			</a>
			<p class="mt-8 text-[14px]" data-reveal style="--reveal-delay: 300ms;">
				<a href="/openclaw" class="link-ink">Back to the OpenClaw dossier</a>
			</p>
		</div>
	</section>
</Layout>
