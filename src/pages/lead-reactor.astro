---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';
import LeadReactorTimeline from '../components/LeadReactorTimeline';
import ServiceSchema from '../components/seo/ServiceSchema.astro';
import FAQ from '../components/seo/FAQ.astro';

const faqs = [
	{
		question: 'What is speed to lead?',
		answer: "Speed to lead is how fast a business contacts a new lead after it comes in — from a Meta ad, a form fill or a call. The faster the contact, the more likely that lead books, because most people move on to the next option the longer they wait to hear back.",
	},
	{
		question: 'How much does the Lead Reactor cost?',
		answer: "It's a fixed price agreed after a free consultation, not a flat number for every business. What drives the price is your ad account setup, which channels you want covered, your CRM, and your expected lead volume.",
	},
	{
		question: 'Which channels does it use?',
		answer: "Voice AI for an instant outbound call, iMessage and SMS, and WhatsApp — plus automated email and text nurture sequences that handle objections before the meeting.",
	},
	{
		question: 'Do I need to be running Meta ads?',
		answer: "The Lead Reactor is built for leads coming in through Meta (Facebook and Instagram) ads. If you're not running Meta ads yet, we can build and run that campaign as part of the engagement — talk to us in a free consultation about what your setup needs.",
	},
];

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "The Lead Reactor", "item": "https://systempros.ai/lead-reactor/" },
	],
};

const deathZone = [
	{
		label: 'FAULT A',
		name: 'The speed gap',
		desc: "If you don't contact a Meta lead in under 5 minutes, your conversion probability drops by 400%. Manual follow-up is a suicide mission for your ROI.",
	},
	{
		label: 'FAULT B',
		name: 'The single-channel trap',
		desc: "If you only call, you're ignored. If you only email, you're spam. People live on WhatsApp, iMessage, and SMS. If you aren't there, you don't exist.",
	},
	{
		label: 'FAULT C',
		name: 'The scalability wall',
		desc: "Your team can't call 50 leads a day at 2:00 AM. Our Reactor can. While you sleep, the system is pre-qualifying and booking — at any volume.",
	},
];

const channels = [
	{ channel: 'VOICE AI', desc: 'An instant, human-sounding outbound call within 10 seconds of the form fill.' },
	{ channel: 'IMESSAGE + SMS', desc: 'Native Apple iMessage delivery for 98% open rates. No app required.' },
	{ channel: 'WHATSAPP', desc: "Direct engagement on the world's most used messaging app, via WhatsApp Business." },
	{ channel: 'SMART NURTURE', desc: 'Automated email and text sequences that handle objections before the meeting.' },
];

const profitGap = [
	{ label: 'Response time', old: '"When we get to it"', new: 'Under 10 seconds' },
	{ label: 'Outreach', old: 'One phone call (maybe)', new: '6 channels simultaneously' },
	{ label: 'Prequalification', old: 'Manual / none', new: 'Automated AI screening' },
	{ label: 'Ad creative', old: 'Generic stock templates', new: 'Engineered, tested creatives' },
	{ label: 'Result', old: '70% lead ghosting', new: '100% contact rate', highlight: true },
];

const factoryStats = [
	{ label: 'CONTACT RATE', value: '100%', sub: 'vs industry average 30%' },
	{ label: 'RESPONSE TIME', value: '<10s', sub: 'vs industry average 4 hours' },
	{ label: 'CHANNELS', value: '6', sub: 'simultaneous outreach' },
	{ label: 'HOURS ACTIVE', value: '24/7', sub: 'including 2 AM and weekends' },
];
---

<Layout
	title="Speed to Lead: Meta Ads to Booked Calls | System Pros AI"
	description="Speed to lead, engineered: the Lead Reactor turns Meta ad clicks into booked calls with instant multi-channel outreach across voice AI, WhatsApp and SMS."
>
	<ServiceSchema
		name="The Lead Reactor"
		description="Complete Meta ads to booked-appointment automation system. Multi-channel AI outreach via Voice AI, iMessage, WhatsApp, and SMS. Under 10-second response time."
		serviceType="MarketingAutomation"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet SP-03                   -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">SP-03 · PAID ADS AUTOMATION</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> REACTOR ONLINE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Stop lighting your ad budget <span class="text-green">on fire</span>.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Most agencies stop at the click. We don't stop until there's a qualified
						meeting on your calendar. We build the ads, run the traffic, and deploy a
						multi-channel Lead Reactor engineered for speed to lead — reaching your
						leads on iMessage, WhatsApp, SMS and voice, until they book.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="/pricing" class="btn-secondary">See the math / pricing</a>
					</div>
				</div>

				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="SP-03 — LEAD REACTOR, PROCESS OVERVIEW">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="lead-reactor" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- RESPONSE-TIME CHART — the signature figure   -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink max-w-[20ch]" data-reveal>
					Speed to lead is the only metric that matters.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>FIG. 02 · TIME TO FIRST CONTACT</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<div class="py-8 space-y-7">
				<div data-reveal>
					<div class="flex flex-wrap justify-between gap-2 mb-2">
						<span class="face-data text-muted">MANUAL FOLLOW-UP ("WHEN WE GET TO IT")</span>
						<span class="face-data text-ink">UP TO 24 HRS</span>
					</div>
					<div class="h-5 bg-line w-full" data-draw-rule></div>
				</div>
				<div data-reveal style="--reveal-delay: 120ms;">
					<div class="flex flex-wrap justify-between gap-2 mb-2">
						<span class="face-data text-muted">INDUSTRY AVERAGE</span>
						<span class="face-data text-ink">≈ 4 HRS</span>
					</div>
					<div class="h-5 bg-muted w-[46%]" data-draw-rule style="--reveal-delay: 120ms;"></div>
				</div>
				<div data-reveal style="--reveal-delay: 240ms;">
					<div class="flex flex-wrap justify-between gap-2 mb-2">
						<span class="face-data text-green">THE LEAD REACTOR</span>
						<span class="face-data text-copper font-bold">&lt; 10 SEC</span>
					</div>
					<div class="h-5 bg-green w-[3%] min-w-[14px]" data-draw-rule style="--reveal-delay: 240ms;"></div>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
			<p class="face-data text-muted mt-3">NOTE — DRAWN INDICATIVELY. TO TRUE SCALE, THE REACTOR BAR WOULD BE 0.01% WIDE.</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAULT REPORT — the 5-minute death zone       -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						Your leads are dying in the 5-minute death zone.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						The brutal reality of manual follow-up and single-channel thinking.
					</p>
					<ul class="mt-8">
						{deathZone.map((f, i) => (
							<li class="spec-row flex gap-5 py-5 px-2" data-reveal style={`--reveal-delay: ${160 + i * 80}ms;`}>
								<span class="face-data text-copper pt-0.5 shrink-0 w-16">{f.label}</span>
								<div>
									<h3 class="font-bold text-ink">{f.name}</h3>
									<p class="text-[14.5px] text-muted mt-1">{f.desc}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
				<div data-reveal style="--reveal-delay: 140ms;">
					<MediaFrame fig="FIG. 03" caption="SP-03 — THE 5-MINUTE DEATH ZONE, VISUALIZED">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="lead-reactor-speed" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FULL-SERVICE ENGINE — timeline               -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="text-center mb-14">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					We build. We run. We convert.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[36rem] mx-auto" data-reveal style="--reveal-delay: 80ms;">
					You aren't buying software. You're buying a finished result —
					a calendar full of confirmed appointments.
				</p>
			</div>
			<LeadReactorTimeline client:visible />
		</div>
	</section>

	<!-- ============================================ -->
	<!-- CHAIN REACTION — six channels                -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 04" caption="SP-03 — CHAIN REACTION, CHANNEL DETONATION">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="lead-reactor-channels" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						One ad click. Six channels. Under ten seconds.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						Because one channel is one chance to lose them. We reach every platform
						they're on — at the exact moment their intent is highest.
					</p>
					<div class="mt-8">
						<div class="rule-ticked" data-draw-rule></div>
						{channels.map((c, i) => (
							<div class="spec-row grid grid-cols-[9.5rem_1fr] gap-x-5 py-4 px-1" data-reveal style={`--reveal-delay: ${160 + i * 70}ms;`}>
								<span class="face-data text-green pt-0.5">{c.channel}</span>
								<p class="text-[14.5px] text-ink leading-relaxed">{c.desc}</p>
							</div>
						))}
					</div>
					<p class="mt-6 text-[15px] text-ink" data-reveal style="--reveal-delay: 460ms;">
						<span class="face-data text-copper">END STATE</span> — a booked appointment synced to your
						Google or Outlook calendar. You just show up.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- PROFIT GAP — spec comparison table           -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1000px] mx-auto px-5">
			<div class="text-center mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink" data-reveal>
					The profit-gap comparison.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[34rem] mx-auto" data-reveal style="--reveal-delay: 80ms;">
					Most agencies give you a list of names. We give you a calendar full of confirmed appointments.
				</p>
			</div>

			<div class="border border-line overflow-x-auto" data-reveal style="--reveal-delay: 140ms;">
				<table class="w-full text-left min-w-[560px]">
					<thead>
						<tr class="border-b border-line">
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 w-40">CRITERION</th>
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 border-l border-line">THE DIY AD HOLE</th>
							<th scope="col" class="face-data text-green font-normal py-3.5 px-4 border-l border-line bg-green-faint">THE LEAD REACTOR</th>
						</tr>
					</thead>
					<tbody>
						{profitGap.map((row) => (
							<tr class="border-t border-line">
								<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">{row.label.toUpperCase()}</th>
								<td class="py-4 px-4 text-[15px] text-muted border-l border-line">
									<span class="face-data text-muted mr-2" aria-hidden="true">✗</span>{row.old}
								</td>
								<td class={`py-4 px-4 text-[15px] border-l border-line bg-green-faint ${row.highlight ? 'font-bold text-green' : 'text-ink'}`}>
									<span class="face-data text-green mr-2" aria-hidden="true">✓</span>{row.new}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — hidden factory logic                -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-12 gap-12">
				<div class="lg:col-span-7">
					<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit" data-reveal>
						Hidden factory logic. Industrial efficiency.
					</h2>
					<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Your competitors are manually dialing numbers and leaving voicemails.
						You are running a hidden factory that processes leads with industrial
						efficiency. Every ad dollar is maximized because the Reactor never forgets
						to follow up, never gets tired, and never misses a speed-to-lead window.
						It just runs.
					</p>
					<a href="/contact" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 240ms;">Book a Free Consultation</a>
				</div>
				<div class="lg:col-span-5">
					<div class="rule-ticked" data-draw-rule></div>
					<dl>
						{factoryStats.map((s, i) => (
							<div class="grid grid-cols-[7rem_1fr] gap-x-6 items-baseline py-4 border-b border-line-drench" data-reveal style={`--reveal-delay: ${120 + i * 80}ms;`}>
								<dt class="face-data text-paper-dim">{s.label}</dt>
								<dd>
									<span class={`text-2xl font-bold ${i === 1 ? 'text-copper' : 'text-paper-lit'}`}>{s.value}</span>
									<span class="block text-[13px] text-paper-dim mt-0.5">{s.sub}</span>
								</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAQ                                          -->
	<!-- ============================================ -->
	<FAQ faqs={faqs} heading="Speed to lead, questions answered." label="SP-03 / FAQ" />

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>SP-03 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[22ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Ready to turn ad spend into an appointment machine?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				We handle the creative, the ads, the tech, and the booking.
				You just show up to the meetings.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
