---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/seo/FAQSchema.astro';
import PricingSection from '../components/PricingSection';

const products = [
	{
		ref: 'SP-01',
		name: 'The Revenue Triad',
		description: '3 Voice AI agents: 24/7 receptionist, speed-to-lead caller, and database reactivation engine.',
		href: '/voice-ai',
		popular: true,
		features: [
			'Agent 01: The Gatekeeper (24/7 Receptionist)',
			'Agent 02: The Hunter (Speed-to-Lead)',
			'Agent 03: The Miner (Database Reactivation)',
			'CRM Integration & Pipeline Automation',
		],
	},
	{
		ref: 'SP-02',
		name: 'Lead Gen Websites',
		description: 'Transform brochure sites into lead machines with smart forms, calendars, and chat widgets.',
		href: '/lead-gen-websites',
		features: [
			'Smart Multi-Step Forms',
			'Embedded Booking Calendars',
			'AI Chat & Voice Widgets',
			'CRM Pipeline Automation',
		],
	},
	{
		ref: 'SP-03',
		name: 'The Lead Reactor',
		description: 'Complete Meta ads to booked-appointment system with multi-channel automated outreach.',
		href: '/lead-reactor',
		features: [
			'Meta Ads Integration',
			'Instant Multi-Channel Outreach',
			'iMessage, WhatsApp, SMS & Calling',
			'Automated Calendar Booking',
		],
	},
	{
		ref: 'SP-04',
		name: 'The Private Assistant',
		description: 'Done-for-you OpenClaw AI assistant on WhatsApp, Telegram, Slack & 20+ platforms.',
		href: '/private-assistant',
		features: [
			'OpenClaw Installation & Setup',
			'Messaging Channel Integration',
			'Custom SOUL.md Personality',
			'Skill Selection & Training',
		],
	},
	{
		ref: 'SP-05',
		name: 'Consultation',
		description: 'Forensic audit of your operations with a strategic AI roadmap and implementation plan.',
		href: '/consulting',
		features: [
			'Forensic Operations Audit',
			'Custom AI Roadmap',
			'Integration Architecture Plan',
			'ROI Projections & Timeline',
		],
	},
	{
		ref: 'SP-06',
		name: 'Training',
		description: '1-on-1 hands-on sessions on AI agents, Claude Code, GoHighLevel, N8N, Voice AI & more.',
		href: '/training',
		features: [
			'1-on-1 Video Sessions',
			'Custom Curriculum Per Session',
			'Hands-On Application (Not Theory)',
			'Session Recording Provided',
		],
	},
];

const faqs = [
	{ question: 'Do you offer custom pricing?', answer: 'Yes. Every business is different. We tailor pricing based on your specific needs, scale, and the number of products you want to deploy. Book a consultation and we\'ll provide a custom quote.' },
	{ question: 'Is there a long-term contract?', answer: 'No long-term contracts required for most services. Some products have monthly operational costs (like Voice AI usage), but there are no lock-in periods.' },
	{ question: 'Can I bundle multiple products?', answer: 'Absolutely. Most clients combine 2-3 products (e.g., Lead Gen Website + Lead Reactor + Revenue Triad). We offer package pricing for bundles.' },
	{ question: 'Do you offer a free consultation?', answer: 'Yes. Your first strategy call is free. We\'ll audit your current setup and recommend the right products for your business.' },
];
---

<Layout
	title="Pricing | AI Solutions & Services | System Pros AI"
	description="Transparent pricing for all System Pros AI products: Voice AI agents, lead gen websites, The Lead Reactor, Private Assistant, consulting, and training."
>
	<FAQSchema faqs={faqs} />

	<!-- ============================================ -->
	<!-- 1. HEADER — the rate schedule                -->
	<!-- ============================================ -->
	<section class="relative">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>SCHEDULE OF RATES — SP-01 · SP-06</span>
				<span class="hidden md:inline">ALL PRICING SCALED TO INSTALLATION</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="py-14 lg:py-20 max-w-[50rem]">
				<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.03] text-ink" data-reveal>
					Investment plans for <span class="text-green">every solution</span>.
				</h1>
				<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
					Choose the right system for your business. Bundle for maximum impact.
					All pricing is customized to your scale — no two installations are identical.
				</p>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. PRODUCT REGISTER — ruled spec table       -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{products.map((p, i) => (
				<article class="spec-row grid md:grid-cols-[4.5rem_minmax(0,22rem)_1fr_11rem] gap-x-8 gap-y-4 py-9 px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<span class="face-data text-copper pt-1.5">{p.ref}</span>
					<div>
						<div class="flex items-center gap-3 flex-wrap">
							<h2 class="text-xl md:text-2xl font-bold text-ink">{p.name}</h2>
							{p.popular && (
								<span class="face-data !text-[10px] text-paper-lit bg-copper px-2 py-0.5">MOST COMMISSIONED</span>
							)}
						</div>
						<p class="text-[15px] text-muted mt-2 leading-relaxed">{p.description}</p>
						<div class="mt-4 face-data !text-[15px] text-green font-bold">Custom pricing</div>
						<div class="face-data !text-[11px] text-muted">quoted to your scale</div>
					</div>
					<div>
						<p class="face-data !text-[11px] text-muted mb-2">WHAT&rsquo;S INCLUDED</p>
						<ul class="space-y-2">
							{p.features.map((f) => (
								<li class="flex items-start gap-3 text-[14.5px] text-ink">
									<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0 mt-1"><polyline points="20 6 9 17 4 12"/></svg>
									{f}
								</li>
							))}
						</ul>
					</div>
					<div class="flex md:flex-col gap-3 md:justify-center">
						<a href={p.href} class="btn-secondary !px-5 !py-2.5 !text-[14px] w-full">View details</a>
						<a href="/contact" class="btn-primary !px-5 !py-2.5 !text-[14px] w-full">Get a quote</a>
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. MANAGED PLANS — retained pricing section  -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<PricingSection client:visible />
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. BUNDLE STATEMENT — drench                 -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section-sm)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-paper-lit max-w-[24ch] mx-auto" data-reveal>
				Bundle and save.
			</h2>
			<p class="text-paper-dim text-lg mt-5 max-w-[36rem] mx-auto leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
				Most clients combine 2–3 products for maximum impact. Book a free consultation
				and we&rsquo;ll recommend the right bundle for your business — with package pricing.
			</p>
			<a href="/contact" class="btn-primary-inverse mt-9" data-reveal style="--reveal-delay: 200ms;">Get a Custom Quote</a>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. FAQ — ruled rows                          -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[860px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(1.9rem,4vw,3rem)] leading-tight text-ink" data-reveal>
					Questions on pricing.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>COMMERCIAL NOTES</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{faqs.map((faq, i) => (
				<details class="spec-row group px-2" data-reveal style={`--reveal-delay: ${i * 60}ms;`}>
					<summary class="flex items-center justify-between gap-6 py-6 cursor-pointer list-none font-bold text-ink text-lg">
						{faq.question}
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="shrink-0 text-muted group-open:rotate-180 transition-transform"><polyline points="6 9 12 15 18 9"/></svg>
					</summary>
					<p class="text-muted leading-relaxed pb-6 max-w-[46rem]">{faq.answer}</p>
				</details>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 6. FINAL CTA                                 -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<div class="rule-ticked mb-16" data-draw-rule></div>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink max-w-[22ch] mx-auto" data-reveal>
				Not sure which system you need?
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 120ms;">
				Book a free consultation. We&rsquo;ll audit your operations and recommend
				the right products — and only the right products.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 220ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
