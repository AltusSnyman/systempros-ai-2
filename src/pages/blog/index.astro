---
import Layout from '../../layouts/Layout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);

const dateFmt: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: '2-digit' };
const regDate = (d: Date) => d.toLocaleDateString('en-US', dateFmt).toUpperCase();

const pageTitle = "AI Insights & Industry News | System Pros AI Blog";
const pageDescription = "Expert analysis on Voice AI, Automation, and the future of work in Australia and New Zealand. Read our latest case studies and guides.";
---

<Layout title={pageTitle} description={pageDescription}>
	<!-- ============================================ -->
	<!-- 1. HEADER — the publication register         -->
	<!-- ============================================ -->
	<section class="relative">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>INSIGHTS REGISTER — TECHNICAL NOTES &amp; CASE STUDIES</span>
				<span class="hidden md:inline">{posts.length} DOCUMENTS ON FILE</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="py-14 lg:py-20 max-w-[50rem]">
				<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.03] text-ink" data-reveal>
					System Pros AI <span class="text-green">insights</span>.
				</h1>
				<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
					Deep dives into the technology reshaping business in ANZ.
					No fluff — just actionable intelligence.
				</p>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. FEATURED DOCUMENT                         -->
	<!-- ============================================ -->
	{featured && (
		<section class="pb-(--spacing-section-sm)">
			<div class="max-w-[1200px] mx-auto px-5">
				<div class="grid lg:grid-cols-2 gap-10 items-center bg-green-faint border border-line rounded-[2px] p-6 md:p-10">
					<a href={`/blog/${featured.id}`} class="block" data-reveal>
						<MediaFrame fig="FIG. 01" caption="FEATURED — ARCHIVE MATERIAL">
							<Image
								src={featured.data.heroImage}
								alt={featured.data.title}
								width={960}
								height={540}
								class="w-full aspect-video object-cover"
								loading="eager"
							/>
						</MediaFrame>
					</a>
					<div>
						<p class="face-data text-copper" data-reveal>FEATURED · {regDate(featured.data.pubDate)}</p>
						<h2 class="face-display font-extrabold text-[clamp(1.7rem,3.2vw,2.6rem)] leading-tight text-ink mt-3" data-reveal style="--reveal-delay: 60ms;">
							<a href={`/blog/${featured.id}`} class="hover:text-green transition-colors">{featured.data.title}</a>
						</h2>
						<p class="text-muted leading-relaxed mt-4 max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
							{featured.data.description}
						</p>
						<a href={`/blog/${featured.id}`} class="btn-secondary mt-7 !px-5 !py-2.5 !text-[14px]" data-reveal style="--reveal-delay: 200ms;">
							Read the article
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					</div>
				</div>
			</div>
		</section>
	)}

	<!-- ============================================ -->
	<!-- 3. THE REGISTER — ruled publication rows     -->
	<!-- ============================================ -->
	<section class="pb-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<p class="face-data text-muted mb-4" data-reveal>ALL DOCUMENTS · NEWEST FIRST</p>
			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{rest.map((post, i) => (
				<a
					href={`/blog/${post.id}`}
					class="spec-row group grid md:grid-cols-[8.5rem_1fr_2rem] gap-x-8 gap-y-2 items-start py-8 px-2"
					data-reveal
					style={`--reveal-delay: ${i * 60}ms;`}
				>
					<time datetime={post.data.pubDate.toISOString()} class="face-data text-copper pt-1">
						{regDate(post.data.pubDate)}
					</time>
					<div>
						<h2 class="text-xl md:text-2xl font-bold text-ink group-hover:text-green transition-colors max-w-[42rem]">
							{post.data.title}
						</h2>
						<p class="text-[15px] text-muted mt-2 leading-relaxed max-w-[46rem]">{post.data.description}</p>
						{post.data.tags.length > 0 && (
							<p class="face-data !text-[11px] text-muted mt-3">{post.data.tags.map((t) => t.toUpperCase()).join(' · ')}</p>
						)}
					</div>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block mt-2 text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			))}
		</div>
	</section>
</Layout>
