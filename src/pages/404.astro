---
import Layout from '../layouts/Layout.astro';

const indexLinks = [
	{ ref: 'SP-01', name: 'The Revenue Triad', href: '/voice-ai' },
	{ ref: 'SP-02', name: 'Lead Gen Websites', href: '/lead-gen-websites' },
	{ ref: 'SP-03', name: 'The Lead Reactor', href: '/lead-reactor' },
	{ ref: 'SP-04', name: 'The Private Assistant', href: '/private-assistant' },
	{ ref: 'SP-05', name: 'Consultation', href: '/consulting' },
	{ ref: 'SP-06', name: 'Training', href: '/training' },
];
---

<Layout title="404 - Page Not Found | System Pros AI">
	<section class="relative min-h-[70vh]">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>REF. 404 — DOCUMENT NOT FOUND</span>
				<span class="hidden md:inline">RETRIEVAL FAILED</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 py-16 lg:py-24">
				<div class="lg:col-span-7">
					<p class="face-data text-copper" data-reveal>ERROR 404</p>
					<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.03] text-ink mt-4" data-reveal style="--reveal-delay: 60ms;">
						This page is not in the <span class="text-green">dossier</span>.
					</h1>
					<p class="mt-6 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 140ms;">
						The page you are looking for might have been removed, had its name changed,
						or was never commissioned in the first place. The rest of the file is intact.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 220ms;">
						<a href="/" class="btn-primary">Return Home</a>
						<a href="/contact" class="btn-secondary">Book a Free Consultation</a>
					</div>
				</div>

				<!-- The systems index, for a useful way out -->
				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 260ms;">
					<p class="face-data text-muted mb-3">DOCUMENTS ON FILE</p>
					<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
					{indexLinks.map((l) => (
						<a href={l.href} class="spec-row group grid grid-cols-[4rem_1fr_1.5rem] gap-x-4 items-center py-3.5 px-2">
							<span class="face-data text-copper">{l.ref}</span>
							<span class="font-semibold text-ink text-[15px] group-hover:text-green transition-colors">{l.name}</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="text-line group-hover:text-copper group-hover:translate-x-0.5 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					))}
				</div>
			</div>
		</div>
	</section>
</Layout>
