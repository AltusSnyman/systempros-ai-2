---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import Stamp from '../components/Stamp.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';

const systems = [
	{
		ref: 'SP-01',
		name: 'The Revenue Triad',
		desc: 'Three voice AI agents: a 24/7 receptionist that sounds human, instant outbound calls on new web leads, and automated reactivation of dormant clients.',
		figure: '24/7',
		figureLabel: 'call coverage',
		href: '/voice-ai',
	},
	{
		ref: 'SP-02',
		name: 'Lead Gen Websites',
		desc: 'Your existing website re-engineered into a capture machine: smart qualifying forms, embedded calendars, chat and voice widgets wired to automations.',
		figure: '100%',
		figureLabel: 'of visitors answerable',
		href: '/lead-gen-websites',
	},
	{
		ref: 'SP-03',
		name: 'The Lead Reactor',
		desc: 'You run Meta ads; the Reactor handles the rest. Multi-channel outreach on iMessage, WhatsApp, SMS and voice until the lead books.',
		figure: '<10s',
		figureLabel: 'first response',
		href: '/lead-reactor',
	},
	{
		ref: 'SP-04',
		name: 'The Private Assistant',
		desc: 'A done-for-you OpenClaw AI assistant on WhatsApp, Telegram, Slack and more. Persistent memory, a custom personality, proactive automation.',
		figure: '3,000+',
		figureLabel: 'installable skills',
		href: '/private-assistant',
	},
	{
		ref: 'SP-05',
		name: 'Consultation',
		desc: 'A forensic audit of your operations followed by a strategic AI roadmap with ROI projections, timelines and a security review.',
		figure: '30',
		figureLabel: 'years of architecture',
		href: '/consulting',
	},
	{
		ref: 'SP-06',
		name: 'Training',
		desc: '1-on-1 hands-on sessions: Claude Code, GoHighLevel, N8N, Make.com, Voice AI, OpenClaw. Custom curriculum, recorded for your team.',
		figure: '1:1',
		figureLabel: 'session format',
		href: '/training',
	},
];

const deepDives = [
	{
		ref: 'SP-01',
		player: 'revenue-triad',
		kicker: 'Voice AI agents',
		name: 'The Revenue Triad',
		body: 'Three AI agents working in concert so no revenue leaks from your phone line or your lead pipeline.',
		points: [
			'24/7 AI receptionist that sounds 100% human',
			'Instant outbound calls on new web leads',
			'Automated reactivation of dormant contacts',
			'Full CRM integration and pipeline automation',
		],
		href: '/voice-ai',
		cta: 'Explore The Revenue Triad',
	},
	{
		ref: 'SP-02',
		player: 'lead-gen-websites',
		kicker: 'Website conversion',
		name: 'Lead Gen Websites',
		body: 'We take the website you already have and engineer it into a 24/7 capture and booking machine.',
		points: [
			'Smart multi-step forms that qualify visitors',
			'Embedded calendars synced to your CRM',
			'AI chat and voice widgets on every page',
			'Automated follow-up from the first form fill',
		],
		href: '/lead-gen-websites',
		cta: 'Explore Lead Gen Websites',
	},
	{
		ref: 'SP-03',
		player: 'lead-reactor',
		kicker: 'Paid ads automation',
		name: 'The Lead Reactor',
		body: 'A complete system that turns Meta ad spend into booked appointments through instant multi-channel outreach.',
		points: [
			'Under 10-second response to every new lead',
			'iMessage, WhatsApp, SMS and voice calls',
			'Automated follow-up sequences until booked',
			'Scales with your ad budget, not your headcount',
		],
		href: '/lead-reactor',
		cta: 'Explore The Lead Reactor',
	},
	{
		ref: 'SP-04',
		player: 'private-assistant',
		kicker: 'Personal AI',
		name: 'The Private Assistant',
		body: 'A done-for-you OpenClaw assistant that lives on every messaging platform you already use.',
		points: [
			'WhatsApp, Telegram, Discord, Slack and more',
			'3,000+ skills from the ClawHub marketplace',
			'Custom SOUL.md personality file',
			'Persistent memory and proactive automation',
		],
		href: '/private-assistant',
		cta: 'Explore The Private Assistant',
	},
	{
		ref: 'SP-05',
		player: 'consultation',
		kicker: 'Strategy and audit',
		name: 'Consultation',
		body: 'A forensic audit of your operations, then a strategic AI roadmap drawn up by 30-year IT veterans.',
		points: [
			'Deep-dive analysis of your current workflows',
			'Custom AI integration roadmap',
			'ROI projections and implementation timeline',
			'Enterprise security and compliance review',
		],
		href: '/consulting',
		cta: 'Explore Consultation',
	},
	{
		ref: 'SP-06',
		player: 'training',
		kicker: '1-on-1 sessions',
		name: 'Training',
		body: 'Hands-on sessions on the AI tools and platforms driving real results right now.',
		points: [
			'Claude Code, GoHighLevel, N8N, Make.com',
			'Voice AI agents and OpenClaw setup',
			'Custom curriculum per session',
			'Recorded sessions for your team to review',
		],
		href: '/training',
		cta: 'Explore Training',
	},
];

const platforms = [
	'GoHighLevel', 'Twilio', 'N8N', 'HubSpot', 'Zapier', 'Salesforce', 'Vapi',
	'ElevenLabs', 'Make.com', 'Vonage', 'Telnyx', 'Cal.com', 'OpenClaw', 'Claude', 'Google Gemini', 'Meta Ads',
];

const fieldReports = [
	{
		no: 'No. 01',
		quote: 'System Pros AI didn’t just give us a chatbot. They rebuilt our entire intake process. We went from missing 60% of calls to capturing every single lead — automatically. The ROI was visible in week one.',
		name: 'James R.',
		role: 'Roofing company owner',
		place: 'Auckland, NZ',
	},
	{
		no: 'No. 02',
		quote: 'The Lead Reactor completely changed our ad game. We were spending $5K a month on Meta ads with manual follow-up. Now every lead gets a call within 10 seconds. Cost per acquisition dropped 40%.',
		name: 'Sarah P.',
		role: 'Dental practice manager',
		place: 'Sydney, AU',
	},
	{
		no: 'No. 03',
		quote: 'The training sessions on Claude Code and N8N were game-changing. We went from zero AI capability to building our own automations in two weeks. The 1-on-1 format is worth every dollar.',
		name: 'Michael K.',
		role: 'Agency founder',
		place: 'New York, USA',
	},
];

const industryClips = [
	{ src: '/assets/industry-videos/roofing.mp4', poster: '/assets/industry-videos/roofing.webp', fig: 'FIG. 07', caption: 'ROOFING — STORM-SEASON INTAKE', href: '/solutions/roofing' },
	{ src: '/assets/industry-videos/dental.mp4', poster: '/assets/industry-videos/dental.webp', fig: 'FIG. 08', caption: 'DENTAL — FRONT-DESK OVERFLOW', href: '/solutions/dental' },
	{ src: '/assets/industry-videos/landscaping.mp4', poster: '/assets/industry-videos/landscaping.webp', fig: 'FIG. 09', caption: 'LANDSCAPING — QUOTE-TO-BOOKING', href: '/solutions/landscaping' },
];
---

<Layout
	title="System Pros AI | AI Systems, Engineered and Installed — Voice AI, Lead Gen, Automation"
	description="Six AI systems for ambitious businesses: voice AI agents, lead gen websites, paid ads automation, private AI assistants, consulting and training. Installed like infrastructure by 30-year systems engineers. NZ, Australia, USA."
>
	<!-- ============================================ -->
	<!-- 1. HERO — the open page of the dossier       -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<!-- Dossier header line (single deliberate device, hero only) -->
			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<span>INSTALLATION DOSSIER — AI SYSTEMS</span>
				<span class="hidden md:inline">NZ · AU · USA</span>
				<span class="flex items-center gap-2"><span class="dot-live"></span> ACCEPTING COMMISSIONS</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-10 items-center py-14 lg:py-20">
				<!-- Copy block -->
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.6rem,6vw,5.2rem)] leading-[1.02] text-ink" data-reveal>
						AI systems,<br />
						<span class="text-green">engineered</span> and installed.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[34rem]" data-reveal style="--reveal-delay: 120ms;">
						Voice agents that answer every call. Websites that capture every lead.
						Follow-up in under ten seconds. Built for businesses in
						<strong class="text-ink font-semibold">NZ, Australia and the USA</strong>
						by engineers with thirty years of enterprise architecture behind them.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="#systems" class="btn-secondary">
							Read the spec sheet
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<!-- Schematic: the signature illustration -->
				<div class="lg:col-span-5" aria-hidden="true">
					<svg viewBox="0 0 440 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
						<!-- connectors (drawn on scroll) -->
						<g stroke="var(--color-green)" stroke-width="1.5">
							<path d="M 88 72 H 200 V 148" data-draw-path />
							<path d="M 88 292 H 200 V 212" data-draw-path style="--reveal-delay: 200ms;" />
							<path d="M 268 180 H 352" data-draw-path style="--reveal-delay: 500ms;" />
						</g>
						<!-- nodes -->
						<g data-reveal>
							<rect x="16" y="48" width="72" height="48" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="52" y="76" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">CALLS</text>
						</g>
						<g data-reveal style="--reveal-delay: 150ms;">
							<rect x="16" y="268" width="72" height="48" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="52" y="296" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-ink)">LEADS</text>
						</g>
						<g data-reveal style="--reveal-delay: 350ms;">
							<rect x="152" y="148" width="116" height="64" fill="var(--color-green)" />
							<text x="210" y="176" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="11" fill="var(--color-paper-lit)">AI AGENT</text>
							<text x="210" y="194" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-paper-dim)">ALWAYS ON</text>
						</g>
						<g data-reveal style="--reveal-delay: 650ms;">
							<rect x="352" y="132" width="72" height="44" stroke="var(--color-ink)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="388" y="158" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-ink)">CRM</text>
							<rect x="352" y="188" width="72" height="44" stroke="var(--color-copper)" stroke-width="1.5" fill="var(--color-paper)" />
							<text x="388" y="214" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="10.5" fill="var(--color-copper)">BOOKED</text>
						</g>
						<!-- dimension ticks -->
						<g stroke="var(--color-line)" stroke-width="1" data-reveal style="--reveal-delay: 800ms;">
							<path d="M 16 340 H 424" />
							<path d="M 16 335 V 345" />
							<path d="M 424 335 V 345" />
						</g>
						<text x="220" y="356" text-anchor="middle" font-family="Fragment Mono, monospace" font-size="9" fill="var(--color-muted)" data-reveal style="--reveal-delay: 800ms;">MISSED CALL → BOOKED JOB · TARGET &lt; 10 SEC</text>
					</svg>
				</div>
			</div>

			<!-- Commissioning figures: ruled strip, not a stat-card bar -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-4">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">EXPERIENCE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="30" data-count-suffix=" yrs">30 yrs</span></dd>
					<dd class="text-[13px] text-muted">enterprise IT architecture</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">COVERAGE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="3">3</span> countries</dd>
					<dd class="text-[13px] text-muted">New Zealand, Australia, USA</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">CATALOGUE</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="6">6</span> systems</dd>
					<dd class="text-[13px] text-muted">installed and maintained</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">UPTIME</dt>
					<dd class="mt-1 text-2xl font-bold text-ink">24/7</dd>
					<dd class="text-[13px] text-muted">your AI never calls in sick</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 2. BUILT-ON STRIP                            -->
	<!-- ============================================ -->
	<section class="py-12">
		<div class="max-w-[1200px] mx-auto px-5">
			<p class="face-data text-muted mb-5">BUILT ON INDUSTRY-STANDARD PLATFORMS</p>
			<ul class="flex flex-wrap gap-x-7 gap-y-3">
				{platforms.map((p) => (
					<li class="face-data !text-[13px] text-ink border-b border-line pb-1 hover:text-green hover:border-green transition-colors">{p}</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 3. COMMAND CENTER — demo video               -->
	<!-- ============================================ -->
	<section id="command-center" class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 01" caption="COMMAND CENTER — LIVE SYSTEM DEMONSTRATION">
						<div class="relative aspect-video bg-ink">
							<video
								id="demo-video"
								src="/assets/demo-video.mp4"
								autoplay
								muted
								loop
								playsinline
								class="w-full h-full object-cover"
							></video>
							<button
								id="mute-toggle"
								class="absolute bottom-3 right-3 w-11 h-11 bg-paper text-ink border border-line flex items-center justify-center hover:text-green transition-colors cursor-pointer"
								style="z-index: 1;"
								aria-label="Toggle sound"
							>
								<svg id="icon-muted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
								<svg id="icon-unmuted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
							</button>
						</div>
					</MediaFrame>
				</div>

				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						One command center replaces the tool pile.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						We design the flow, implement the nodes, and secure the data —
						a single engineered system instead of nine disconnected subscriptions.
					</p>
					<ul class="mt-8">
						<li class="spec-row flex gap-5 py-5 px-2" data-reveal style="--reveal-delay: 160ms;">
							<span class="face-data text-copper pt-0.5 shrink-0 w-8">A</span>
							<div>
								<h3 class="font-bold text-ink">AI voice receptionist</h3>
								<p class="text-[14.5px] text-muted mt-1">Sounds 100% human. Qualifies leads, answers FAQs, books appointments around the clock.</p>
							</div>
						</li>
						<li class="spec-row flex gap-5 py-5 px-2" data-reveal style="--reveal-delay: 240ms;">
							<span class="face-data text-copper pt-0.5 shrink-0 w-8">B</span>
							<div>
								<h3 class="font-bold text-ink">Smart CRM integration</h3>
								<p class="text-[14.5px] text-muted mt-1">Data moves on its own: automatic updates, tagging, and pipeline movement based on conversation intent.</p>
							</div>
						</li>
						<li class="spec-row flex gap-5 py-5 px-2" data-reveal style="--reveal-delay: 320ms;">
							<span class="face-data text-copper pt-0.5 shrink-0 w-8">C</span>
							<div>
								<h3 class="font-bold text-ink">Visual pipelines</h3>
								<p class="text-[14.5px] text-muted mt-1">See exactly where every dollar is stuck and clear the bottleneck the same day.</p>
							</div>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 4. THE SYSTEMS INDEX — spec table            -->
	<!-- ============================================ -->
	<section id="systems" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Six systems.<br />One installation partner.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>INDEX OF INSTALLED SYSTEMS · SP-01 — SP-06</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{systems.map((s, i) => (
				<a
					href={s.href}
					class="spec-row group grid grid-cols-[3.5rem_1fr] md:grid-cols-[4.5rem_1fr_11rem_2rem] gap-x-5 gap-y-2 items-center py-7 px-2"
					data-reveal
					style={`--reveal-delay: ${i * 60}ms;`}
				>
					<span class="face-data text-copper">{s.ref}</span>
					<div>
						<h3 class="text-xl md:text-2xl font-bold text-ink group-hover:text-green transition-colors">{s.name}</h3>
						<p class="text-[15px] text-muted mt-1.5 max-w-[46rem]">{s.desc}</p>
					</div>
					<div class="col-start-2 md:col-start-3">
						<div class="face-data !text-[15px] text-green font-bold">{s.figure}</div>
						<div class="face-data !text-[11px] text-muted">{s.figureLabel}</div>
					</div>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" class="hidden md:block text-line group-hover:text-copper group-hover:translate-x-1 transition-all"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 5. SYSTEM DEEP-DIVES — dossier figures       -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="mb-16">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					How each system works.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[38rem]" data-reveal style="--reveal-delay: 100ms;">
					A closer look at the six units — each one shown running, not described in the abstract.
				</p>
			</div>

			<div class="space-y-24">
				{deepDives.map((d, i) => (
					<div class={`grid lg:grid-cols-2 gap-12 items-center ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
						<div data-reveal>
							<MediaFrame fig={`FIG. 0${i + 2}`} caption={`${d.ref} — ${d.name.toUpperCase()}`}>
								<div class="aspect-square bg-ink">
									<ProductVideoPlayer id={d.player as any} client:visible />
								</div>
							</MediaFrame>
						</div>
						<div>
							<p class="face-data text-copper" data-reveal>{d.ref} · {d.kicker.toUpperCase()}</p>
							<h3 class="face-display font-extrabold text-3xl md:text-4xl text-ink mt-3" data-reveal style="--reveal-delay: 60ms;">{d.name}</h3>
							<p class="text-muted leading-relaxed mt-4" data-reveal style="--reveal-delay: 120ms;">{d.body}</p>
							<ul class="mt-6">
								{d.points.map((p, j) => (
									<li class="spec-row flex items-center gap-4 py-3 px-1 text-[14.5px] text-ink" data-reveal style={`--reveal-delay: ${160 + j * 60}ms;`}>
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
										{p}
									</li>
								))}
							</ul>
							<a href={d.href} class="btn-secondary mt-8 !px-5 !py-2.5 !text-[14px]" data-reveal style="--reveal-delay: 420ms;">
								{d.cta}
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
							</a>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- 6. DRENCH STATEMENT — why 30 years matters   -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
