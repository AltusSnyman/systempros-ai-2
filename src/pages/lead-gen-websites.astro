---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';
import ProcessTimeline from '../components/ProcessTimeline';
import ServiceSchema from '../components/seo/ServiceSchema.astro';
import FAQ from '../components/seo/FAQ.astro';

const faqs = [
	{
		question: 'What is a lead generation website?',
		answer: "A lead generation website is built to capture and qualify every visitor, not just describe your business. It combines smart forms, an instant booking calendar, chat or voice widgets, and CRM automation so a visitor becomes a logged, followed-up lead automatically.",
	},
	{
		question: 'How much does a lead generation website cost?',
		answer: "It's a fixed price agreed after a free consultation, not a flat rate — what drives it is the state of your existing site, which forms and calendar you need, whether you want chat or voice widgets, and how much CRM automation is involved.",
	},
	{
		question: 'Do I need a new website?',
		answer: "It depends on what you've already got. Most of the time we re-engineer the website you already have — adding the forms, calendar, widgets and automation it's missing — which is faster and cheaper than starting over. If your current site can't reasonably be saved, or you don't have one yet, we design and build a new one instead.",
	},
	{
		question: 'How long does it take?',
		answer: "There's no fixed timeframe we quote up front. The timeline is set out in the written scope you get after a free consultation, once we know what's involved for your specific site.",
	},
];

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "Lead Gen Websites", "item": "https://systempros.ai/lead-gen-websites/" },
	],
};

const failures = [
	{
		label: 'FAILURE A',
		name: 'The 24-hour death spiral',
		desc: "When a lead fills a form and waits 24 hours for a reply, they've already booked with your competitor. Speed to lead is the only metric that matters.",
	},
	{
		label: 'FAILURE B',
		name: 'The inbox grave',
		desc: 'Static forms send data to an email inbox where leads go to die. No automation. No instant booking. No pipeline. Just a spreadsheet of missed opportunities.',
	},
	{
		label: 'FAILURE C',
		name: 'The invisible visitor',
		desc: 'Thousands of dollars in traffic hit your site and leave because there was no hook to keep them. Every bounce is a lost contract.',
	},
];

const widgetPoints = [
	'Visitor clicks → talks to AI in under 2 seconds',
	'AI qualifies budget, urgency, and fit on the call',
	'Meeting booked directly to your calendar — no back-and-forth',
	'Smart forms run the same logic 24/7 when no one is talking',
	'Every interaction auto-creates a CRM contact and pipeline entry',
];

const engines = [
	{
		label: 'ENGINE 1',
		name: 'Smart multi-step forms',
		desc: "Stop asking for just a name and email. Our forms qualify the lead's budget and urgency before they hit your calendar. Higher completion. Better leads. No wasted sales calls.",
	},
	{
		label: 'ENGINE 2',
		name: 'Instant booking calendars',
		desc: 'Syncs with Google and Outlook. No back-and-forth emails, no phone tag. The moment they are qualified, they pick a time — and the meeting lands in both calendars in seconds.',
	},
	{
		label: 'ENGINE 3',
		name: 'Automated nurture flows',
		desc: "The hidden factory at work. If they don't book, the system triggers SMS and email follow-ups until they do. No lead is ever forgotten.",
	},
];

const comparison = [
	{ label: 'Response time', old: '12–24 hours', new: '< 2 seconds' },
	{ label: 'Lead handling', old: 'Manual email inbox', new: 'Full CRM automation' },
	{ label: 'Engagement', old: 'Static text and images', new: 'Interactive voice and AI chat' },
	{ label: 'Follow-up', old: 'Whoever remembers to call', new: 'Automated SMS + email sequences' },
	{ label: 'Outcome', old: '"We\'ll call you soon"', new: '"Meeting confirmed for 10 AM"', highlight: true },
];
---

<Layout
	title="Lead Generation Websites That Book Jobs | System Pros AI"
	description="Lead generation websites that book jobs: smart qualifying forms, instant booking calendars, voice AI widgets and CRM automation working while you sleep."
>
	<ServiceSchema
		name="Lead Gen Websites"
		description="Website transformation service that converts brochure sites into lead generation machines with smart forms, calendars, Voice AI widgets, and full CRM automation."
		serviceType="WebDesign"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet SP-02                   -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">SP-02 · WEBSITE CONVERSION</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> CAPTURING AROUND THE CLOCK</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						A lead generation website should <span class="text-green">book meetings</span>, not just look pretty.
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						Most "professional" websites are $50,000 digital brochures. They look great,
						but they let leads die in your inbox. We rip out the friction and replace it
						with a lead generation machine that qualifies, follows up, and books
						appointments while you sleep.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="/pricing" class="btn-secondary">View pricing</a>
					</div>
				</div>

				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="SP-02 — BROCHURE SITE TO LEAD MACHINE">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="lead-gen-websites" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAULT REPORT — why the brochure site fails   -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink max-w-[22ch]" data-reveal>
					You paid $50k for a digital pamphlet. Here's why it's failing you.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>FAULT REPORT · 3 FAILURE MODES</p>
			</div>

			<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
			{failures.map((f, i) => (
				<div class="spec-row grid md:grid-cols-[8rem_18rem_1fr] gap-x-8 gap-y-2 py-7 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
					<span class="face-data text-copper">{f.label}</span>
					<h3 class="text-xl font-bold text-ink">{f.name}</h3>
					<p class="text-[15px] text-muted leading-relaxed max-w-[42rem]">{f.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE SECRET WEAPON — voice AI on every page   -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 02" caption="SP-02 — THE HIDDEN FACTORY, ASSEMBLY VIEW">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="lead-gen-factory" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div>
					<p class="face-data text-copper" data-reveal>THE SECRET WEAPON</p>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink mt-3" data-reveal style="--reveal-delay: 60ms;">
						Voice AI integration on every page.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 120ms;">
						Don't make them wait for a callback. Our voice AI widget acts as a 24/7
						receptionist directly on your page. Visitors click, talk to an AI that
						understands their needs, and get booked into your calendar instantly.
						This is how you beat the competition to the punch.
					</p>
					<ul class="mt-7">
						{widgetPoints.map((p, j) => (
							<li class="spec-row flex items-center gap-4 py-3 px-1 text-[14.5px] text-ink" data-reveal style={`--reveal-delay: ${180 + j * 60}ms;`}>
								<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-green)" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
								{p}
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE GUTS OF THE SYSTEM — three engines       -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					The guts of the system.
				</h2>
				<p class="face-data text-muted pb-2" data-reveal>THREE INTERCONNECTED ENGINES</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			{engines.map((e, i) => (
				<div class="spec-row grid md:grid-cols-[8rem_18rem_1fr] gap-x-8 gap-y-2 py-7 px-2" data-reveal style={`--reveal-delay: ${i * 70}ms;`}>
					<span class="face-data text-copper">{e.label}</span>
					<h3 class="text-xl font-bold text-ink">{e.name}</h3>
					<p class="text-[15px] text-muted leading-relaxed max-w-[42rem]">{e.desc}</p>
				</div>
			))}
		</div>
	</section>

	<!-- ============================================ -->
	<!-- RIP & REPLACE — spec comparison table        -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1000px] mx-auto px-5">
			<div class="text-center mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink" data-reveal>
					The rip-and-replace comparison.
				</h2>
				<p class="text-muted text-lg mt-3" data-reveal style="--reveal-delay: 80ms;">The business logic — side by side.</p>
			</div>

			<div class="border border-line overflow-x-auto" data-reveal style="--reveal-delay: 140ms;">
				<table class="w-full text-left min-w-[560px]">
					<thead>
						<tr class="border-b border-line">
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 w-40">CRITERION</th>
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 border-l border-line">OLD BROCHURE SITE</th>
							<th scope="col" class="face-data text-green font-normal py-3.5 px-4 border-l border-line bg-green-faint">SYSTEM PROS AI MACHINE</th>
						</tr>
					</thead>
					<tbody>
						{comparison.map((row) => (
							<tr class="border-t border-line">
								<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">{row.label.toUpperCase()}</th>
								<td class="py-4 px-4 text-[15px] text-muted border-l border-line">
									<span class="face-data text-muted mr-2" aria-hidden="true">✗</span>{row.old}
								</td>
								<td class={`py-4 px-4 text-[15px] border-l border-line bg-green-faint ${row.highlight ? 'font-bold text-green' : 'text-ink'}`}>
									<span class="face-data text-green mr-2" aria-hidden="true">✓</span>{row.new}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- PROCESS — 0 to lead machine (sequential)     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="text-center mb-14">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
					Zero to lead machine.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[30rem] mx-auto" data-reveal style="--reveal-delay: 80ms;">
					Three phases. Straight to results.
				</p>
			</div>
			<ProcessTimeline client:visible />
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DRENCH — the loss close                      -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-8">
					<p class="face-data text-copper" data-reveal>EVERY DAY YOU WAIT IS A LEAD YOUR COMPETITOR TAKES</p>
					<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4" data-reveal style="--reveal-delay: 80ms;">
						Stop paying for a website that does nothing.
					</h2>
					<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 160ms;">
						Get a system that works as hard as you do. It books meetings while you sleep,
						follows up while you're with clients, and closes while you're on holiday.
					</p>
					<a href="/contact" class="btn-primary-inverse mt-10" data-reveal style="--reveal-delay: 240ms;">Book a Free Consultation</a>
				</div>
				<div class="lg:col-span-4 hidden lg:block" aria-hidden="true" data-reveal style="--reveal-delay: 300ms;">
					<div class="border border-line-drench p-6">
						<p class="face-data text-paper-dim">OPERATING SCHEDULE</p>
						<dl class="mt-4 space-y-3">
							<div class="flex justify-between gap-4 border-b border-line-drench pb-3">
								<dt class="text-paper-dim text-[14px]">While you sleep</dt>
								<dd class="face-data text-paper-lit">BOOKING</dd>
							</div>
							<div class="flex justify-between gap-4 border-b border-line-drench pb-3">
								<dt class="text-paper-dim text-[14px]">While you're with clients</dt>
								<dd class="face-data text-paper-lit">FOLLOWING UP</dd>
							</div>
							<div class="flex justify-between gap-4">
								<dt class="text-paper-dim text-[14px]">While you're on holiday</dt>
								<dd class="face-data text-copper">CLOSING</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- POINTER — starting from scratch              -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="text-muted text-[15px]" data-reveal>
				Starting from scratch?
				<a href="/websites/" class="link-ink font-semibold">See Website Design & Build</a>
			</p>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAQ                                          -->
	<!-- ============================================ -->
	<FAQ faqs={faqs} heading="Lead generation website questions, answered." label="SP-02 / FAQ" />

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>SP-02 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your website should book meetings. Start now.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free consultation takes thirty minutes. We'll audit your current site,
				find where the leads leak, and specify the machine that stops it.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
