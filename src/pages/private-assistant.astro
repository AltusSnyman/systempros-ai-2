---
import Layout from '../layouts/Layout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ProductVideoPlayer from '../components/ProductVideoPlayer';
import ServiceSchema from '../components/seo/ServiceSchema.astro';
import FAQ from '../components/seo/FAQ.astro';

const faqs = [
	{
		question: 'How much does a private AI assistant cost?',
		answer: "There's no fixed number — the OpenClaw software is free and open source, so your ongoing cost is the AI model API usage plus hosting or hardware. A done-for-you deployment from System Pros AI is a fixed price agreed after a free consultation, based on the channels, skills, integrations and hosting your setup needs.",
	},
	{
		question: 'What is a private AI assistant?',
		answer: "A private AI assistant is an OpenClaw deployment that runs on infrastructure you control rather than a shared cloud service. It has persistent memory, a custom personality, and access to the messaging apps and tools you already use — so it behaves like a dedicated assistant rather than a browser tab you have to open.",
	},
	{
		question: 'Where does my data go?',
		answer: "It stays on the hardware you or we provision — your Mac, a Linux server, or a cloud VM you control. Conversation history and memory are not sent to a third party for storage or training. The LLM you connect processes each query via an API call, which is the only point your data leaves your environment.",
	},
	{
		question: 'Which messaging apps does it work on?',
		answer: "We deploy on WhatsApp, iMessage, Slack and Discord, connecting your assistant to the platforms your team already uses day to day.",
	},
	{
		question: 'Can you set up OpenClaw for me?',
		answer: "Yes — that's the Private Assistant service. We provision or configure your server, connect the messaging bridges, write your SOUL.md personality file, hand-pick and install the right skills, and hand it over working. No terminal access required on your side.",
	},
];

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://systempros.ai/" },
		{ "@type": "ListItem", "position": 2, "name": "The Private Assistant", "item": "https://systempros.ai/private-assistant/" },
	],
};

const siloTax = [
	{
		label: 'COST A',
		name: 'Context switching',
		desc: 'Every time you leave your workflow to "ask ChatGPT" something, you lose 20 minutes of deep focus. Multiply that by 15 times a day.',
	},
	{
		label: 'COST B',
		name: 'The data leak',
		desc: "Using standard AI means your pricing strategies, client secrets, and competitive insights are training someone else's model — for free.",
	},
	{
		label: 'COST C',
		name: 'The setup wall',
		desc: 'OpenClaw is the world\'s most powerful open-source AI — but it\'s a technical nightmare to install. One wrong config line and your "personal AI" is a brick.',
	},
];

const packs = [
	{
		name: 'EXECUTIVE PACK',
		examples: ['"Summarize this 40-min Zoom transcript"', '"Draft a reply to this angry email"', '"Find a time for a meeting with X"'],
	},
	{
		name: 'KNOWLEDGE PACK',
		examples: ['"What did I decide about the marketing budget last Oct?"', 'Connects to Obsidian and Notion', 'Answers from your data, instantly'],
	},
	{
		name: 'RESEARCH PACK',
		examples: ['"Find the top 5 competitors in [niche] with pricing"', 'Real-time web search', 'Competitor intelligence on demand'],
	},
	{
		name: 'CREATIVE PACK',
		examples: ['"Rewrite this LinkedIn post in my voice"', '"Generate a thumbnail concept for this idea"', 'Content that sounds like you'],
	},
];

const sovereign = [
	{ feature: 'Platform', them: 'Web-only or custom app', us: 'WhatsApp, iMessage, Slack + 17 more' },
	{ feature: 'Privacy', them: 'Data lives on their servers', us: 'Data lives on YOUR hardware' },
	{ feature: 'Speed to launch', them: '4–8 weeks', us: '48–72 hours' },
	{ feature: 'Flexibility', them: 'Rigid, locked-in workflows', us: '3,000+ community skills (ClawHub)' },
	{ feature: 'Personality', them: 'Generic AI "assistant"', us: 'Custom SOUL.md — your voice, your rules' },
];

const deployment = [
	{
		label: 'STEP 1',
		name: 'Secure server environment',
		desc: 'We configure the hidden factory — Mac, Linux, or cloud — so your AI is on 24/7, even when your laptop is closed.',
	},
	{
		label: 'STEP 2',
		name: 'Multi-channel bridge',
		desc: 'We link your phone number and social accounts so your AI is literally a contact in your phone — one message away.',
	},
	{
		label: 'STEP 3',
		name: 'Personality engineering',
		desc: "We write your SOUL.md file — your AI's DNA. It doesn't just answer questions; it thinks and communicates like you.",
	},
	{
		label: 'STEP 4',
		name: 'Skill injection',
		desc: 'We hand-pick and install the top 50 skills relevant to your specific business role. No bloat. Just power.',
	},
	{
		label: 'STEP 5',
		name: 'Second-brain integration',
		desc: 'We connect your Obsidian vault or Notion workspace so your AI answers from your own notes and decisions.',
	},
	{
		label: 'STEP 6',
		name: 'Ongoing support',
		desc: 'As OpenClaw evolves and your needs change, we keep your assistant sharp, updated, and optimized.',
	},
];
---

<Layout
	title="Private AI Assistant: Done-For-You OpenClaw | System Pros AI"
	description="A private AI assistant, done for you: System Pros AI deploys OpenClaw across WhatsApp, iMessage and Slack with a custom personality, skills and support."
>
	<ServiceSchema
		name="The Private Assistant"
		description="Done-for-you OpenClaw private AI assistant deployment across 20+ messaging platforms with custom SOUL.md personality and 50+ hand-picked skills."
		serviceType="AIConsulting"
	/>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<!-- ============================================ -->
	<!-- HERO — dossier sheet SP-04                   -->
	<!-- ============================================ -->
	<section class="relative overflow-hidden">
		<div class="max-w-[1200px] mx-auto px-5">

			<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
				<nav aria-label="Breadcrumb">
					<a href="/" class="hover:text-green transition-colors">INDEX</a>
					<span aria-hidden="true"> / </span>
					<span class="text-ink" aria-current="page">SP-04 · PERSONAL AI</span>
				</nav>
				<span class="flex items-center gap-2"><span class="dot-live"></span> ONE MESSAGE AWAY</span>
			</div>
			<div class="rule-ticked" data-draw-rule></div>

			<div class="grid lg:grid-cols-12 gap-12 items-center py-14 lg:py-20">
				<div class="lg:col-span-7">
					<h1 class="face-display font-extrabold text-[clamp(2.4rem,5.5vw,4.6rem)] leading-[1.04] text-ink" data-reveal>
						Stop jumping between apps. <span class="text-green">Start using your mind.</span>
					</h1>
					<p class="mt-7 text-lg md:text-xl text-muted leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
						You don't need more tools — you need one intelligence that follows you
						everywhere. We deploy your private <strong class="text-ink font-semibold">OpenClaw assistant</strong>
						across 20+ platforms: WhatsApp, iMessage, Slack, and Discord. It's your
						second brain, your executive assistant, and your researcher — all in one
						chat thread.
					</p>
					<div class="mt-9 flex flex-col sm:flex-row gap-4" data-reveal style="--reveal-delay: 240ms;">
						<a href="/contact" class="btn-primary">Book a Free Consultation</a>
						<a href="#skills" class="btn-secondary">
							Explore 3,000+ skills
							<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
						</a>
					</div>
				</div>

				<div class="lg:col-span-5" data-reveal style="--reveal-delay: 200ms;">
					<MediaFrame fig="FIG. 01" caption="SP-04 — PRIVATE ASSISTANT, EVERY PLATFORM">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="private-assistant" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>

			<!-- Commissioning figures -->
			<div class="rule-ticked" data-draw-rule></div>
			<dl class="grid grid-cols-2 md:grid-cols-4">
				<div class="py-6 pr-6 md:border-r border-line" data-reveal>
					<dt class="face-data text-muted">COMMUNITY</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="247" data-count-suffix="K+">247K+</span></dd>
					<dd class="text-[13px] text-muted">GitHub stars on OpenClaw</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 80ms;">
					<dt class="face-data text-muted">PLATFORMS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="20" data-count-suffix="+">20+</span></dd>
					<dd class="text-[13px] text-muted">WhatsApp, iMessage, Slack, Discord…</dd>
				</div>
				<div class="py-6 md:px-6 md:border-r border-line" data-reveal style="--reveal-delay: 160ms;">
					<dt class="face-data text-muted">DEPLOY TIME</dt>
					<dd class="mt-1 text-2xl font-bold text-copper">48–72h</dd>
					<dd class="text-[13px] text-muted">vs 4–8 weeks for bespoke builds</dd>
				</div>
				<div class="py-6 md:pl-6" data-reveal style="--reveal-delay: 240ms;">
					<dt class="face-data text-muted">SKILLS</dt>
					<dd class="mt-1 text-2xl font-bold text-ink"><span data-count="3000" data-count-suffix="+">3000+</span></dd>
					<dd class="text-[13px] text-muted">on the ClawHub marketplace</dd>
				</div>
			</dl>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- THE SILO TAX — problem                       -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) bg-green-faint border-y border-line">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div data-reveal>
					<MediaFrame fig="FIG. 02" caption="SP-04 — THE SILO TAX, FRAGMENTED FOCUS">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="private-assistant-silo" client:visible />
						</div>
					</MediaFrame>
				</div>
				<div>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink" data-reveal>
						The high cost of fragmented focus.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 100ms;">
						Three taxes you pay every day you run your business through scattered AI tabs.
					</p>
					<ul class="mt-8">
						{siloTax.map((s, i) => (
							<li class="spec-row flex gap-5 py-5 px-2" data-reveal style={`--reveal-delay: ${160 + i * 80}ms;`}>
								<span class="face-data text-copper pt-0.5 shrink-0 w-16">{s.label}</span>
								<div>
									<h3 class="font-bold text-ink">{s.name}</h3>
									<p class="text-[14.5px] text-muted mt-1">{s.desc}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- SKILLS — the four power packs                -->
	<!-- ============================================ -->
	<section id="skills" class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="grid lg:grid-cols-2 gap-14 items-center">
				<div>
					<p class="face-data text-copper" data-reveal>CLAWHUB MARKETPLACE</p>
					<h2 class="face-display font-extrabold text-[clamp(1.9rem,3.6vw,3rem)] leading-tight text-ink mt-3" data-reveal style="--reveal-delay: 60ms;">
						The skills people actually want.
					</h2>
					<p class="mt-4 text-muted text-lg leading-relaxed" data-reveal style="--reveal-delay: 120ms;">
						We hand-pick and install the top 50 skills from ClawHub relevant to your
						exact business role. These are the four power packs we deploy most:
					</p>
					<div class="mt-8">
						<div class="rule-ticked rule-ticked-green" data-draw-rule></div>
						{packs.map((p, i) => (
							<div class="spec-row grid md:grid-cols-[10.5rem_1fr] gap-x-6 gap-y-2 py-5 px-1" data-reveal style={`--reveal-delay: ${160 + i * 70}ms;`}>
								<span class="face-data text-green pt-0.5">{p.name}</span>
								<ul class="space-y-1.5">
									{p.examples.map((ex) => (
										<li class="text-[14.5px] text-ink leading-relaxed flex gap-2.5">
											<span class="text-green" aria-hidden="true">·</span>{ex}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</div>
				<div data-reveal style="--reveal-delay: 140ms;">
					<MediaFrame fig="FIG. 03" caption="SP-04 — SKILL INJECTION, CLAWHUB CATALOGUE">
						<div class="aspect-square bg-ink">
							<ProductVideoPlayer id="private-assistant-skills" client:visible />
						</div>
					</MediaFrame>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- SOVEREIGN ADVANTAGE — comparison table       -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section-sm) border-t border-line">
		<div class="max-w-[1000px] mx-auto px-5">
			<div class="text-center mb-10">
				<h2 class="face-display font-extrabold text-[clamp(2rem,4vw,3.2rem)] leading-tight text-ink" data-reveal>
					The sovereign advantage.
				</h2>
				<p class="text-muted text-lg mt-3 max-w-[36rem] mx-auto" data-reveal style="--reveal-delay: 80ms;">
					"Bespoke" AI agencies sell locked-in workflows at $5,000+. We deploy the
					world's most powerful open-source AI — on your hardware, in your voice.
				</p>
			</div>

			<div class="border border-line overflow-x-auto" data-reveal style="--reveal-delay: 140ms;">
				<table class="w-full text-left min-w-[560px]">
					<thead>
						<tr class="border-b border-line">
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 w-36">FEATURE</th>
							<th scope="col" class="face-data text-muted font-normal py-3.5 px-4 border-l border-line">"BESPOKE" AGENCIES ($5K+)</th>
							<th scope="col" class="face-data text-green font-normal py-3.5 px-4 border-l border-line bg-green-faint">SYSTEM PROS AI OPENCLAW</th>
						</tr>
					</thead>
					<tbody>
						{sovereign.map((row) => (
							<tr class="border-t border-line">
								<th scope="row" class="face-data text-muted font-normal align-top py-4 px-4">{row.feature.toUpperCase()}</th>
								<td class="py-4 px-4 text-[15px] text-muted border-l border-line">{row.them}</td>
								<td class="py-4 px-4 text-[15px] text-ink font-medium border-l border-line bg-green-faint">{row.us}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- DEPLOYMENT — what we handle (sequential)     -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<div class="flex flex-wrap items-end justify-between gap-4 mb-10">
				<div>
					<h2 class="face-display font-extrabold text-[clamp(2rem,4.5vw,3.6rem)] leading-tight text-ink" data-reveal>
						The done-for-you deployment.
					</h2>
					<p class="text-muted text-lg mt-3 max-w-[38rem]" data-reveal style="--reveal-delay: 80ms;">
						OpenClaw is free. Setting it up <em>properly</em> — with the right personality,
						the right skills, and the right connections — is where most people fail.
						That's what we do.
					</p>
					<p class="mt-3 text-[14px] text-muted" data-reveal style="--reveal-delay: 120ms;">
						Want to see what's involved first? Read the <a href="/openclaw/setup-guide/" class="link-ink">OpenClaw setup guide</a>.
					</p>
				</div>
				<p class="face-data text-muted pb-2" data-reveal>INSTALLATION SEQUENCE · 6 STEPS</p>
			</div>

			<div class="rule-ticked" data-draw-rule></div>
			<div class="grid md:grid-cols-2 md:gap-x-14">
				{deployment.map((d, i) => (
					<div class="spec-row flex gap-5 py-6 px-2" data-reveal style={`--reveal-delay: ${(i % 2) * 80}ms;`}>
						<span class="face-data text-copper pt-1 shrink-0 w-16">{d.label}</span>
						<div>
							<h3 class="font-bold text-ink">{d.name}</h3>
							<p class="text-[14.5px] text-muted mt-1.5 leading-relaxed">{d.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FAQ                                          -->
	<!-- ============================================ -->
	<FAQ faqs={faqs} heading="Private assistant questions, answered." label="SP-04 / FAQ" />

	<!-- ============================================ -->
	<!-- DRENCH — the "only one" close                -->
	<!-- ============================================ -->
	<section class="drench py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5">
			<p class="face-data text-copper" data-reveal>247,000 DEVELOPERS · ONE DEPLOYMENT TEAM</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-paper-lit mt-4 max-w-[24ch]" data-reveal style="--reveal-delay: 80ms;">
				247,000 developers build OpenClaw. You only need one team to deploy it.
			</h2>
			<p class="mt-7 text-lg md:text-xl text-paper-dim leading-relaxed max-w-[38rem]" data-reveal style="--reveal-delay: 160ms;">
				Don't waste weeks trying to DIY your AI. We hand you a production-ready,
				private assistant in days. Your data. Your rules. Your AI.
			</p>
			<div class="mt-10 flex flex-col sm:flex-row gap-4 sm:items-center" data-reveal style="--reveal-delay: 240ms;">
				<a href="/contact" class="btn-primary-inverse">Book a Free Consultation</a>
				<a href="/pricing" class="face-data text-paper-lit underline underline-offset-4 hover:text-copper transition-colors">VIEW PRICING</a>
			</div>
		</div>
	</section>

	<!-- ============================================ -->
	<!-- FINAL CTA                                    -->
	<!-- ============================================ -->
	<section class="py-(--spacing-section)">
		<div class="max-w-[1200px] mx-auto px-5 text-center">
			<p class="face-data text-muted" data-reveal>SP-04 · SIGN-OFF</p>
			<h2 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink mt-4 max-w-[20ch] mx-auto" data-reveal style="--reveal-delay: 80ms;">
				Your assistant could be live in 72 hours.
			</h2>
			<p class="text-muted text-lg mt-6 max-w-[32rem] mx-auto" data-reveal style="--reveal-delay: 160ms;">
				A free consultation takes thirty minutes. We'll map your role, pick your
				skill packs, and specify the deployment.
			</p>
			<a href="/contact" class="btn-primary mt-10 !px-10 !py-4 !text-[16px]" data-reveal style="--reveal-delay: 240ms;">
				Book a Free Consultation
			</a>
		</div>
	</section>
</Layout>
