---
import '../styles/global.css';

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { GA4_ID, SITE_URL, ORG_ID, WEBSITE_ID, BRAND, PHONES } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
	hideCTA?: boolean;
}

const {
	title,
	description = "System Pros AI installs AI systems for small businesses in NZ, Australia and the US: AI receptionists, lead follow-up, consulting and training.",
	image = "/social-preview.png",
	type = "website",
	hideCTA = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const siteSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfessionalService",
			"@id": ORG_ID,
			"name": BRAND.name,
			"alternateName": BRAND.alternateName,
			"legalName": BRAND.legalName,
			"url": `${SITE_URL}/`,
			"logo": { "@type": "ImageObject", "url": BRAND.logo, "width": 512, "height": 512 },
			"image": BRAND.socialImage,
			"email": BRAND.email,
			"telephone": PHONES.NZ.e164,
			"description": "System Pros AI designs, builds and commissions AI systems for small and medium businesses: AI receptionists and voice agents, lead generation websites, speed-to-lead outreach, private AI assistants, AI consulting and training.",
			"areaServed": [
				{ "@type": "Country", "name": "New Zealand" },
				{ "@type": "Country", "name": "Australia" },
				{ "@type": "Country", "name": "United States" }
			],
			"contactPoint": Object.values(PHONES).map((p) => ({
				"@type": "ContactPoint",
				"telephone": p.e164,
				"contactType": "sales",
				"areaServed": p.code,
				"availableLanguage": "English"
			})),
			"sameAs": [BRAND.googleKgUrl, BRAND.googleMapsUrl],
			"hasOfferCatalog": {
				"@type": "OfferCatalog",
				"name": "AI systems and services",
				"itemListElement": [
					["AI Receptionist and Voice AI Agents (The Revenue Triad)", "/voice-ai/"],
					["Lead Gen Websites", "/lead-gen-websites/"],
					["The Lead Reactor (speed to lead)", "/lead-reactor/"],
					["The Private Assistant (OpenClaw)", "/private-assistant/"],
					["AI Consulting", "/consulting/"],
					["AI Training", "/training/"]
				].map(([name, path]) => ({
					"@type": "Offer",
					"itemOffered": { "@type": "Service", "name": name, "url": `${SITE_URL}${path}`, "provider": { "@id": ORG_ID } }
				}))
			}
		},
		{
			"@type": "WebSite",
			"@id": WEBSITE_ID,
			"url": `${SITE_URL}/`,
			"name": BRAND.name,
			"alternateName": BRAND.alternateName,
			"publisher": { "@id": ORG_ID },
			"inLanguage": "en"
		}
	]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="System Pros AI" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={socialImageURL} />

		<!-- Fonts: Archivo variable (with width axis) + Fragment Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Fragment+Mono:ital@0;1&display=swap"
		/>

		<!-- Organization + WebSite schema (one entity, referenced by @id from every Service/BlogPosting) -->
		<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

		<!-- GA4 + conversion events. Config lives in src/lib/site.ts (GA4_ID).
		     While GA4_ID is the placeholder, events queue in dataLayer and gtag.js is not requested. -->
		<script is:inline define:vars={{ GA4_ID }}>
			window.dataLayer = window.dataLayer || [];
			window.gtag = function () { window.dataLayer.push(arguments); };
			const gaLive = /^G-[A-Z0-9]{6,}$/.test(GA4_ID) && GA4_ID !== 'G-PLACEHOLDER';
			window.gtag('js', new Date());
			window.gtag('config', GA4_ID, { send_page_view: gaLive });
			if (gaLive) {
				const s = document.createElement('script');
				s.async = true;
				s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
				document.head.appendChild(s);
			}
			const once = {};
			// spTrack(name, params, onceKey?) — onceKey dedupes per page view.
			window.spTrack = function (name, params, onceKey) {
				if (onceKey) { if (once[onceKey]) return; once[onceKey] = true; }
				window.gtag('event', name, Object.assign({ page_path: location.pathname }, params || {}));
			};
		</script>

		<meta name="theme-color" content="#ffffff" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<!-- Page-specific head elements (preconnects etc.): <link slot="head" ... /> -->
		<slot name="head" />

		<!-- Arm the animation vocabulary before paint so pre-states apply without flash.
		     Runs only when IntersectionObserver exists; no-JS keeps everything visible. -->
		<script is:inline>
			if ('IntersectionObserver' in window) {
				document.documentElement.classList.add('is-armed');
			}
		</script>
	</head>
	<body class="bg-paper text-ink overflow-x-hidden antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 bg-green text-paper-lit px-4 py-2 rounded-[2px]"
		>
			Skip to content
		</a>

		<Navbar hideCTA={hideCTA} />
		<main id="main-content">
			<slot />
		</main>
		<Footer />

		<!-- Conversion events: consultation_click, call_click, audit_form_view -->
		<script is:inline>
			document.addEventListener('click', function (e) {
				const a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
				if (!a || !window.spTrack) return;
				const href = a.getAttribute('href') || '';
				const label = (a.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80);
				const where = a.closest('header') ? 'header' : a.closest('footer') ? 'footer' : 'body';
				if (href.indexOf('tel:') === 0) {
					window.spTrack('call_click', { phone_number: href.slice(4), link_location: where });
				} else if (/^(https:\/\/systempros\.ai)?\/contact\/?(#.*|\?.*)?$/.test(href)) {
					window.spTrack('consultation_click', { link_text: label, link_location: where });
				}
			}, { capture: true });
			(function () {
				const w = document.getElementById('audit-widget');
				if (!w || !window.spTrack) return;
				if (!('IntersectionObserver' in window)) { window.spTrack('audit_form_view', {}, 'audit'); return; }
				const io = new IntersectionObserver(function (entries) {
					if (entries.some(function (en) { return en.isIntersecting; })) {
						window.spTrack('audit_form_view', {}, 'audit');
						io.disconnect();
					}
				}, { threshold: 0.25 });
				io.observe(w);
			})();
		</script>

		<!-- Shared scroll animation driver: reveals, rule draws, path draws, count-ups -->
		<script>
			const armed = document.documentElement.classList.contains('is-armed');
			if (armed) {
				// Prepare SVG paths for self-drawing
				document.querySelectorAll<SVGPathElement>('[data-draw-path]').forEach((path) => {
					const len = path.getTotalLength();
					path.style.strokeDasharray = `${len}`;
					path.style.strokeDashoffset = `${len}`;
				});

				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-on');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
				);

				document
					.querySelectorAll('[data-reveal], [data-draw-rule], [data-draw-path]')
					.forEach((el) => io.observe(el));

				// Count-up figures: <span data-count="847" data-count-suffix="+">847+</span>
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const counters = document.querySelectorAll<HTMLElement>('[data-count]');
				if (!reduceMotion && counters.length) {
					const cio = new IntersectionObserver(
						(entries) => {
							for (const entry of entries) {
								if (!entry.isIntersecting) continue;
								cio.unobserve(entry.target);
								const el = entry.target as HTMLElement;
								const target = parseFloat(el.dataset.count || '0');
								const suffix = el.dataset.countSuffix || '';
								const decimals = (el.dataset.count || '').includes('.') ? 1 : 0;
								const start = performance.now();
								const dur = 1100;
								const tick = (now: number) => {
									const t = Math.min((now - start) / dur, 1);
									const eased = 1 - Math.pow(1 - t, 4);
									el.textContent = (target * eased).toFixed(decimals) + suffix;
									if (t < 1) requestAnimationFrame(tick);
								};
								requestAnimationFrame(tick);
							}
						},
						{ threshold: 0.4 }
					);
					counters.forEach((el) => cio.observe(el));
				}
			}
		</script>
	</body>
</html>
