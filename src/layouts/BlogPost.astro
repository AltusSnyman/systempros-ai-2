---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import { Image } from 'astro:assets';
import MediaFrame from '../components/MediaFrame.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author, tags } = Astro.props;

const dateFmt: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };

// Schema.org Article
const schema = {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"image": heroImage.src,
	"author": {
		"@type": "Person",
		"name": author || "SystemPros AI"
	},
	"publisher": {
		"@type": "Organization",
		"name": "SystemPros",
		"logo": {
			"@type": "ImageObject",
			"url": "https://systempros.ai/favicon.svg"
		}
	},
	"datePublished": pubDate.toISOString(),
	"dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString()
};
---

<Layout title={title} description={description} image={heroImage.src} type="article">
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- Document header -->
	<header class="max-w-[1200px] mx-auto px-5">
		<div class="face-data text-muted flex flex-wrap justify-between gap-2 pt-8 pb-4">
			<a href="/blog" class="hover:text-green transition-colors">&larr; INSIGHTS REGISTER</a>
			<span class="hidden sm:inline">FILED {pubDate.toLocaleDateString('en-US', dateFmt).toUpperCase()}</span>
		</div>
		<div class="rule-ticked" data-draw-rule></div>

		<div class="py-12 lg:py-16 max-w-[54rem]">
			{tags && tags.length > 0 && (
				<p class="face-data text-copper mb-4" data-reveal>
					{tags.map((t) => t.toUpperCase()).join(' · ')}
				</p>
			)}
			<h1 class="face-display font-extrabold text-[clamp(2.2rem,5vw,4.2rem)] leading-[1.05] text-ink" data-reveal style="--reveal-delay: 60ms;">
				{title}
			</h1>
			<p class="mt-5 text-lg md:text-xl text-muted leading-relaxed max-w-[42rem]" data-reveal style="--reveal-delay: 140ms;">
				{description}
			</p>

			<dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3 face-data text-muted" data-reveal style="--reveal-delay: 220ms;">
				<div class="flex gap-2">
					<dt class="text-copper">AUTHOR</dt>
					<dd class="text-ink">{author}</dd>
				</div>
				<div class="flex gap-2">
					<dt class="text-copper">PUBLISHED</dt>
					<dd class="text-ink">
						<time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US', dateFmt)}</time>
					</dd>
				</div>
				{updatedDate && (
					<div class="flex gap-2">
						<dt class="text-copper">UPDATED</dt>
						<dd class="text-ink">
							<time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', dateFmt)}</time>
						</dd>
					</div>
				)}
			</dl>
		</div>

		<!-- Hero image, framed as archived material from the previous file -->
		<div class="max-w-[54rem]" data-reveal>
			<MediaFrame fig="FIG. 01" caption={`ARCHIVE MATERIAL — ${title.toUpperCase().slice(0, 60)}`}>
				<Image
					src={heroImage}
					alt={title}
					width={1440}
					height={720}
					class="w-full aspect-[2/1] object-cover"
					loading="eager"
				/>
			</MediaFrame>
		</div>
	</header>

	<!-- Article body -->
	<article class="max-w-[1200px] mx-auto px-5 py-14 md:py-20">
		<div
			class="max-w-[46rem] prose prose-lg
				text-ink prose-headings:text-ink prose-headings:font-bold prose-headings:tracking-tight prose-headings:[text-wrap:balance]
				prose-p:text-ink prose-li:text-ink prose-strong:text-ink prose-em:text-ink
				prose-a:text-green prose-a:underline prose-a:underline-offset-[3px] prose-a:decoration-1 hover:prose-a:text-copper
				prose-blockquote:border-l-2 prose-blockquote:border-green prose-blockquote:text-muted prose-blockquote:not-italic
				prose-code:text-green-deep prose-code:font-mono prose-code:text-[0.85em]
				prose-hr:border-line
				prose-img:rounded-[2px] prose-img:border prose-img:border-line"
		>
			<slot />
		</div>

		<!-- Sign-off / CTA -->
		<div class="max-w-[46rem] mt-16">
			<div class="rule-ticked" data-draw-rule></div>
			<div class="py-10">
				<p class="face-data text-muted" data-reveal>END OF DOCUMENT — NEXT ACTION</p>
				<h2 class="face-display font-extrabold text-2xl md:text-3xl text-ink mt-3" data-reveal style="--reveal-delay: 60ms;">
					Ready to implement these insights?
				</h2>
				<p class="text-muted mt-3 leading-relaxed max-w-[36rem]" data-reveal style="--reveal-delay: 120ms;">
					Book a strategy session with SystemPros to discuss how we can tailor this
					solution for your business.
				</p>
				<a href="/contact" class="btn-primary mt-7" data-reveal style="--reveal-delay: 200ms;">Book a Free Consultation</a>
			</div>
			<div class="rule-ticked" data-draw-rule></div>
		</div>
	</article>
</Layout>
